---
import BaseLayout from '../../layouts/Base.astro';
import DNNav from '../../components/DNNav.astro';

const testimonials = [
  {
    featured: true,
    name: 'Sarah Kim',
    title: 'VP of Engineering, VeritasCloud',
    avatar: 'https://images.pexels.com/photos/1239291/pexels-photo-1239291.jpeg?auto=compress&cs=tinysrgb&w=800',
    quote: "Alex doesn't just write code — he engineers outcomes. He architected our migration from a creaking monolith to a microservices platform that now handles 50M daily requests with 99.98% uptime. His ability to translate complex technical tradeoffs into business decisions is rare.",
    relation: 'Direct Manager'
  },
  {
    name: 'Marcus Thompson',
    title: 'Co-Founder & CEO, Axiom Labs',
    avatar: 'https://images.pexels.com/photos/2379004/pexels-photo-2379004.jpeg?auto=compress&cs=tinysrgb&w=800',
    quote: "Hiring Alex as our first senior engineer was the best decision we made. He built our entire backend stack from scratch, scaled it to 50k users, and mentored our two junior developers into confident engineers. He cares about your success, not just shipping code.",
    relation: 'Client'
  },
  {
    name: 'Priya Nakamura',
    title: 'Senior Engineer, Streamline.io',
    avatar: 'https://images.pexels.com/photos/1181686/pexels-photo-1181686.jpeg?auto=compress&cs=tinysrgb&w=800',
    quote: "Working with Alex on the API performance overhaul was eye-opening. He explained complex query optimisation strategies clearly, caught edge cases nobody else noticed, and delivered 6x improvement in response times. An exceptional technical collaborator.",
    relation: 'Colleague'
  },
  {
    name: 'Jordan Rivera',
    title: 'Staff Engineer, Nexus Platform',
    avatar: 'https://images.pexels.com/photos/3183150/pexels-photo-3183150.jpeg?auto=compress&cs=tinysrgb&w=800',
    quote: "Alex's code reviews are the best I've experienced. He doesn't just point out problems — he explains why, provides alternatives, and always ties feedback to principles. Within 3 months our team's PR quality noticeably improved because of his mentorship.",
    relation: 'Colleague'
  },
];
---
<BaseLayout title="Testimonials — Alex Chen" theme="dn">
  <link rel="stylesheet" href="/styles/rv.css" slot="head" />
  <DNNav active="testimonials" />

  <main style="padding-top:5rem;background:#fff;color:#0A0A0A;font-family:'Inter',sans-serif">

    <!-- Hero -->
    <section style="padding:4rem 1.5rem 3rem;max-width:1200px;margin-inline:auto;border-bottom:1px solid #E5E5E5">
      <p style="font-family:'JetBrains Mono',monospace;font-size:.75rem;color:#FF6600;text-transform:uppercase;letter-spacing:.1em;margin-bottom:.5rem">Social Proof</p>
      <h1 style="font-size:clamp(2rem,5vw,3.5rem);font-weight:800;letter-spacing:-.04em;margin:0 0 1rem">Testimonials</h1>
      <p style="font-size:1.125rem;color:#555;max-width:600px;line-height:1.7;margin:0">What past colleagues, clients, and managers say about working with me.</p>
    </section>

    <!-- Featured Endorsement -->
    <section style="padding:4rem 1.5rem;max-width:1200px;margin-inline:auto">
      <div style="background:#0A0A0A;border-radius:24px;padding:3.5rem;position:relative;overflow:hidden">
        <div style="position:absolute;top:2rem;left:2.5rem;font-size:5rem;color:rgba(255,102,0,.2);font-family:'Georgia',serif;line-height:1">"</div>
        <div style="position:relative;z-index:1">
          <div style="display:flex;gap:.75rem;margin-bottom:2rem;flex-wrap:wrap">
            <span style="font-family:'JetBrains Mono',monospace;font-size:.75rem;background:rgba(255,102,0,.2);color:#FF6600;border-radius:6px;padding:.25rem .75rem">Featured</span>
            <span style="font-family:'JetBrains Mono',monospace;font-size:.75rem;background:rgba(255,255,255,.1);color:rgba(255,255,255,.6);border-radius:6px;padding:.25rem .75rem">{testimonials[0].relation}</span>
          </div>
          <blockquote style="font-size:1.375rem;font-weight:500;color:#fff;line-height:1.65;margin:0 0 2.5rem;font-style:italic">{testimonials[0].quote}</blockquote>
          <div style="display:flex;align-items:center;gap:1rem">
            <img src={testimonials[0].avatar} alt={testimonials[0].name} style="width:3.5rem;height:3.5rem;border-radius:50%;object-fit:cover;border:2px solid rgba(255,102,0,.5)" />
            <div>
              <div style="font-weight:700;color:#fff;font-size:1rem">{testimonials[0].name}</div>
              <div style="font-size:.875rem;color:rgba(255,255,255,.5)">{testimonials[0].title}</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4 Testimonial Cards -->
    <section style="padding:0 1.5rem 5rem;max-width:1200px;margin-inline:auto">
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:1.5rem">
        {testimonials.slice(1).map(t => (
          <div style="background:#F5F5F5;border-radius:20px;padding:2rem;border:1px solid #E5E5E5;position:relative">
            <div style="font-size:2.5rem;color:rgba(255,102,0,.3);font-family:'Georgia',serif;line-height:1;margin-bottom:1.25rem">"</div>
            <div style="font-family:'JetBrains Mono',monospace;font-size:.75rem;color:#FF6600;margin-bottom:1rem">{t.relation}</div>
            <blockquote style="font-size:.9375rem;color:#555;line-height:1.75;margin:0 0 1.5rem;font-style:italic">{t.quote}</blockquote>
            <div style="display:flex;align-items:center;gap:.875rem">
              <img src={t.avatar} alt={t.name} style="width:3rem;height:3rem;border-radius:50%;object-fit:cover" />
              <div>
                <div style="font-weight:700;font-size:.9375rem">{t.name}</div>
                <div style="font-size:.8125rem;color:#666">{t.title}</div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- GitHub Contribution Decoration -->
    <section style="background:#F5F5F5;padding:4rem 1.5rem;border-top:1px solid #E5E5E5;border-bottom:1px solid #E5E5E5">
      <div style="max-width:1200px;margin-inline:auto">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:center">
          <div>
            <p style="font-family:'JetBrains Mono',monospace;font-size:.75rem;color:#FF6600;text-transform:uppercase;letter-spacing:.1em;margin-bottom:.75rem">Consistency</p>
            <h2 style="font-size:2rem;font-weight:700;letter-spacing:-.03em;margin:0 0 1rem">Showing up every day</h2>
            <p style="font-size:.9375rem;color:#555;line-height:1.7;margin:0 0 1.5rem">500+ contributions in 2024. The GitHub heatmap tells one story — the real story is in the commit messages, the PR reviews, and the 2am debugging sessions.</p>
            <div style="display:flex;gap:2rem">
              {[{v:'500+',l:'Commits / Year'},{v:'80+',l:'Repos'},{v:'150+',l:'PRs Merged'}].map(s => (
                <div>
                  <div style="font-family:'JetBrains Mono',monospace;font-size:1.5rem;font-weight:700;color:#0A0A0A">{s.v}</div>
                  <div style="font-size:.8125rem;color:#999">{s.l}</div>
                </div>
              ))}
            </div>
          </div>
          <div>
            <p style="font-family:'JetBrains Mono',monospace;font-size:.75rem;color:#999;margin-bottom:.875rem">github.com/alexchen — 2024</p>
            <div style="display:grid;grid-template-columns:repeat(26,1fr);gap:2px">
              {Array.from({length:364}).map(() => {
                const v = Math.random();
                const bg = v < 0.45 ? '#E5E5E5' : v < 0.65 ? 'rgba(255,102,0,.25)' : v < 0.82 ? 'rgba(255,102,0,.6)' : '#FF6600';
                return <div style={`padding-bottom:100%;background:${bg};border-radius:2px`}></div>;
              })}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- LinkedIn-style recommendations promo -->
    <section style="padding:4rem 1.5rem;max-width:700px;margin-inline:auto;text-align:center">
      <p style="font-family:'JetBrains Mono',monospace;font-size:.75rem;color:#FF6600;text-transform:uppercase;letter-spacing:.1em;margin-bottom:.75rem">Verified</p>
      <h2 style="font-size:2rem;font-weight:700;letter-spacing:-.03em;margin:0 0 1rem">4 LinkedIn recommendations</h2>
      <p style="font-size:1rem;color:#555;margin:0 0 2rem;line-height:1.65">All testimonials can be verified on my LinkedIn profile. Happy to provide direct contact info for references during any serious conversation.</p>
      <a href="https://linkedin.com" style="display:inline-flex;align-items:center;gap:.625rem;background:#0A66C2;color:#fff;font-size:.9375rem;font-weight:600;padding:.875rem 2rem;border-radius:12px;text-decoration:none">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        View on LinkedIn
      </a>
    </section>
  </main>

  <footer style="background:#fff;border-top:1px solid #E5E5E5;padding:3rem 1.5rem">
    <div style="max-width:1200px;margin-inline:auto;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:1.5rem">
      <div style="font-weight:700;color:#0A0A0A">Alex Chen</div>
      <div style="font-size:.875rem;color:#999">© 2025 Alex Chen.</div>
    </div>
  </footer>

  <style>
    @media (max-width:767px) {
      main section div[style*="grid-template-columns:1fr 1fr"] { grid-template-columns:1fr !important; }
    }
  </style>
</BaseLayout>
