---
import BaseLayout from '../../layouts/Base.astro';
import DNNav from '../../components/DNNav.astro';
---
<BaseLayout title="Publications — Alex Chen" theme="dn">
  <link rel="stylesheet" href="/styles/rv.css" slot="head" />
  <DNNav active="publications" />

  <main style="padding-top:5rem;background:#fff;color:#0A0A0A;font-family:'Inter',sans-serif">

    <!-- Hero -->
    <section style="padding:4rem 1.5rem 3rem;max-width:1200px;margin-inline:auto;border-bottom:1px solid #E5E5E5">
      <p style="font-family:'JetBrains Mono',monospace;font-size:.75rem;color:#FF6600;text-transform:uppercase;letter-spacing:.1em;margin-bottom:.5rem">Writing & Speaking</p>
      <h1 style="font-size:clamp(2rem,5vw,3.5rem);font-weight:800;letter-spacing:-.04em;margin:0 0 1rem">Publications</h1>
      <p style="font-size:1.125rem;color:#555;max-width:600px;line-height:1.7;margin:0">Articles, talks, OSS contributions, and podcast appearances on full-stack development and software architecture.</p>
    </section>

    <!-- Technical Articles -->
    <section style="padding:4rem 1.5rem;max-width:1200px;margin-inline:auto">
      <div style="display:flex;align-items:center;gap:1rem;margin-bottom:2rem">
        <h2 style="font-size:1.25rem;font-weight:700;margin:0">Technical Articles</h2>
        <div style="flex:1;height:1px;background:#E5E5E5"></div>
      </div>
      <div style="display:flex;flex-direction:column;gap:1.25rem">
        {[
          {platform:'Dev.to',platformColor:'#3B49DF',title:'Building a Type-Safe API with tRPC and Next.js 14',date:'May 2025',reads:'12.4k',tags:['TypeScript','tRPC','Next.js']},
          {platform:'Medium',platformColor:'#000',title:'Why I Migrated from REST to GraphQL (and Partially Back)',date:'Apr 2025',reads:'8.9k',tags:['GraphQL','REST','Architecture']},
          {platform:'Dev.to',platformColor:'#3B49DF',title:'Zero to Prod: Shipping a SaaS in 30 Days with Next.js',date:'Feb 2025',reads:'21k',tags:['Next.js','SaaS','Tutorial']},
          {platform:'Smashing Magazine',platformColor:'#E85C33',title:'Optimizing PostgreSQL Queries for High-Traffic Web Apps',date:'Jan 2025',reads:'15.2k',tags:['PostgreSQL','Performance','Backend']},
          {platform:'CSS-Tricks',platformColor:'#2979FF',title:'Understanding the React Compiler: A Practical Guide',date:'Dec 2024',reads:'9.3k',tags:['React','Compiler','JavaScript']},
          {platform:'Dev.to',platformColor:'#3B49DF',title:'The Hidden Cost of Over-Engineering',date:'Oct 2024',reads:'6.1k',tags:['Opinion','Architecture']},
        ].map(article => (
          <a href="#" style="text-decoration:none;display:grid;grid-template-columns:1fr auto;gap:1.5rem;align-items:center;padding:1.5rem;background:#F5F5F5;border-radius:16px;border:1px solid transparent;transition:border-color .2s">
            <div>
              <div style="display:flex;align-items:center;gap:.75rem;margin-bottom:.5rem;flex-wrap:wrap">
                <span style={`font-family:'JetBrains Mono',monospace;font-size:.75rem;font-weight:700;color:${article.platformColor}`}>{article.platform}</span>
                <span style="font-family:'JetBrains Mono',monospace;font-size:.75rem;color:#999">{article.date}</span>
                {article.tags.map(t => <span style="font-family:'JetBrains Mono',monospace;font-size:.7rem;background:#fff;border:1px solid #E5E5E5;border-radius:6px;padding:.125rem .5rem;color:#555">{t}</span>)}
              </div>
              <h3 style="font-size:1.0625rem;font-weight:700;color:#0A0A0A;margin:0">{article.title}</h3>
            </div>
            <div style="text-align:right;flex-shrink:0">
              <div style="font-family:'JetBrains Mono',monospace;font-size:.9rem;font-weight:700;color:#0A0A0A">{article.reads}</div>
              <div style="font-family:'JetBrains Mono',monospace;font-size:.7rem;color:#999">reads</div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Conference Talks -->
    <section style="background:#F5F5F5;padding:4rem 1.5rem">
      <div style="max-width:1200px;margin-inline:auto">
        <div style="display:flex;align-items:center;gap:1rem;margin-bottom:2rem">
          <h2 style="font-size:1.25rem;font-weight:700;margin:0">Conference Talks</h2>
          <div style="flex:1;height:1px;background:#E5E5E5"></div>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:1.5rem">
          {[
            {conf:'ReactConf 2024',location:'Las Vegas, NV',title:'Rethinking State Management in 2024',desc:'A critical look at the state management landscape post-React Server Components — when to use Context, Zustand, or nothing at all.',date:'May 2024',type:'Talk'},
            {conf:'Node.js Interactive 2024',location:'Austin, TX',title:'Building High-Throughput APIs with Node.js and Lambda',desc:'Lessons learned from scaling an API gateway to 50M daily requests using serverless architecture and aggressive caching strategies.',date:'Mar 2024',type:'Talk'},
            {conf:'JSConf EU 2023',location:'Berlin, Germany',title:'TypeScript Compiler API: Building Custom Lint Rules',desc:'A practical walkthrough of the TypeScript compiler API, showing how to write automated code quality checks that go beyond ESLint.',date:'Sep 2023',type:'Workshop'},
          ].map(talk => (
            <div style="background:#fff;border-radius:20px;padding:2rem;border:1px solid #E5E5E5">
              <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:1rem;flex-wrap:wrap;gap:.5rem">
                <div>
                  <div style="font-family:'JetBrains Mono',monospace;font-size:.8125rem;font-weight:700;color:#FF6600;margin-bottom:.125rem">{talk.conf}</div>
                  <div style="font-size:.8125rem;color:#999">{talk.location} · {talk.date}</div>
                </div>
                <span style={`font-family:'JetBrains Mono',monospace;font-size:.7rem;padding:.25rem .625rem;border-radius:6px;background:${talk.type==='Workshop'?'#F0F0F0':'#FFF0E6'};color:${talk.type==='Workshop'?'#555':'#FF6600'}`}>{talk.type}</span>
              </div>
              <h3 style="font-size:1.0625rem;font-weight:700;margin:0 0 .625rem">{talk.title}</h3>
              <p style="font-size:.875rem;color:#666;line-height:1.65;margin:0">{talk.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Open Source Contributions -->
    <section style="padding:4rem 1.5rem;max-width:1200px;margin-inline:auto">
      <div style="display:flex;align-items:center;gap:1rem;margin-bottom:2rem">
        <h2 style="font-size:1.25rem;font-weight:700;margin:0">Open Source</h2>
        <div style="flex:1;height:1px;background:#E5E5E5"></div>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:1rem">
        {[
          {repo:'devflow-cli',role:'Author & Maintainer',desc:'Developer workflow automation CLI. 2.4k stars, 150+ contributors.',stars:'2.4k',lang:'Python'},
          {repo:'ts-validator',role:'Author',desc:'Lightweight TypeScript runtime schema validator with zero dependencies.',stars:'340',lang:'TypeScript'},
          {repo:'prisma/prisma',role:'Contributor',desc:'Fixed N+1 query detection edge cases in the query planner (#8821).',stars:'39k',lang:'TypeScript'},
          {repo:'vercel/next.js',role:'Contributor',desc:'Improved error messages for App Router data fetching mistakes (#52041).',stars:'126k',lang:'JavaScript'},
          {repo:'trpc/trpc',role:'Contributor',desc:'Added comprehensive docs for middleware chaining patterns.',stars:'34k',lang:'TypeScript'},
          {repo:'drizzle-orm/drizzle',role:'Contributor',desc:'Added PostgreSQL materialized view support (#842).',stars:'24k',lang:'TypeScript'},
        ].map(oss => (
          <a href="https://github.com" style="text-decoration:none;background:#F5F5F5;border:1px solid #E5E5E5;border-radius:16px;padding:1.5rem;display:block">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:.5rem">
              <div style="font-family:'JetBrains Mono',monospace;font-size:.9rem;font-weight:700;color:#0A0A0A">{oss.repo}</div>
              <span style="font-family:'JetBrains Mono',monospace;font-size:.8rem;color:#FF6600">★ {oss.stars}</span>
            </div>
            <div style="font-family:'JetBrains Mono',monospace;font-size:.75rem;color:#FF6600;margin-bottom:.375rem">{oss.role}</div>
            <p style="font-size:.875rem;color:#666;margin:0 0 .875rem;line-height:1.55">{oss.desc}</p>
            <span style="font-family:'JetBrains Mono',monospace;font-size:.75rem;background:#fff;border:1px solid #E5E5E5;border-radius:6px;padding:.2rem .6rem;color:#555">{oss.lang}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Podcast -->
    <section style="background:#0A0A0A;padding:4rem 1.5rem">
      <div style="max-width:1200px;margin-inline:auto">
        <p style="font-family:'JetBrains Mono',monospace;font-size:.75rem;color:#FF6600;text-transform:uppercase;letter-spacing:.1em;margin-bottom:.75rem">Podcast Appearances</p>
        <h2 style="font-size:1.75rem;font-weight:700;color:#fff;margin:0 0 2rem;letter-spacing:-.03em">On the Air</h2>
        <div style="display:flex;flex-direction:column;gap:1rem">
          {[
            {show:'Syntax.fm',ep:'Ep #712',title:'Full-Stack Architecture Patterns for Solo Devs',date:'Apr 2025'},
            {show:'The Changelog',ep:'Ep #544',title:'Building Developer Tools That People Actually Use',date:'Feb 2025'},
            {show:'JS Party',ep:'Ep #321',title:'TypeScript: When Is It Too Much?',date:'Nov 2024'},
          ].map(pod => (
            <a href="#" style="text-decoration:none;display:flex;gap:1.5rem;align-items:center;padding:1.25rem 1.5rem;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:14px">
              <div style="width:3rem;height:3rem;background:#FF6600;border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
              </div>
              <div style="flex:1;min-width:0">
                <div style="font-family:'JetBrains Mono',monospace;font-size:.8125rem;color:#FF6600;margin-bottom:.25rem">{pod.show} · {pod.ep}</div>
                <div style="font-size:.9375rem;font-weight:600;color:#fff">{pod.title}</div>
              </div>
              <div style="font-family:'JetBrains Mono',monospace;font-size:.8rem;color:rgba(255,255,255,.4);flex-shrink:0">{pod.date}</div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <footer style="background:#fff;border-top:1px solid #E5E5E5;padding:3rem 1.5rem">
    <div style="max-width:1200px;margin-inline:auto;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:1.5rem">
      <div style="font-weight:700;color:#0A0A0A">Alex Chen</div>
      <div style="font-size:.875rem;color:#999">© 2025 Alex Chen.</div>
    </div>
  </footer>

  <style>
    a[href="#"]:hover { border-color:#FF6600 !important; }
  </style>
</BaseLayout>
