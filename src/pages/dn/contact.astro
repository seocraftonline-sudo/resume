---
import BaseLayout from '../../layouts/Base.astro';
import DNNav from '../../components/DNNav.astro';
---
<BaseLayout title="Contact — Alex Chen" theme="dn">
  <link rel="stylesheet" href="/styles/rv.css" slot="head" />
  <DNNav active="contact" />

  <main style="padding-top:5rem;background:#fff;color:#0A0A0A;font-family:'Inter',sans-serif">

    <!-- Hero -->
    <section style="padding:4rem 1.5rem 3rem;text-align:center;border-bottom:1px solid #E5E5E5">
      <div style="display:inline-flex;align-items:center;gap:.5rem;background:#F5F5F5;border:1px solid #E5E5E5;border-radius:9999px;padding:.5rem 1.25rem;margin-bottom:2rem">
        <span style="width:.625rem;height:.625rem;background:#10B981;border-radius:50%;display:inline-block;animation:pulse 2s ease-in-out infinite"></span>
        <span style="font-family:'JetBrains Mono',monospace;font-size:.8125rem;color:#555;letter-spacing:.04em">Available for new projects</span>
      </div>
      <h1 style="font-size:clamp(3rem,8vw,6rem);font-weight:800;letter-spacing:-.05em;text-transform:uppercase;line-height:.9;margin:0 0 2rem;max-width:800px;margin-inline:auto">
        Initiate<br/><span style="color:#FF6600">Connection.</span>
      </h1>
      <div style="max-width:700px;margin-inline:auto;background:#F5F5F5;border:1px solid #E5E5E5;border-radius:24px;padding:2rem">
        <p style="font-size:1.0625rem;color:#555;line-height:1.7;margin:0">Whether you're looking to scale your infrastructure, architect a new system, or just want to discuss the future of digital product development. Based in San Francisco (PST) — typically respond within 24 hours.</p>
      </div>
    </section>

    <!-- Contact Body -->
    <section style="padding:4rem 1.5rem 5rem;max-width:1200px;margin-inline:auto;display:grid;grid-template-columns:7fr 5fr;gap:3rem">

      <!-- Form -->
      <div style="background:#fff;border:1px solid #E5E5E5;border-radius:24px;padding:2.5rem">
        <h2 style="font-size:1.375rem;font-weight:700;margin:0 0 2rem">Send a Message</h2>
        <form style="display:flex;flex-direction:column;gap:1.25rem" onsubmit="return false">
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.25rem">
            <div>
              <label style="display:block;font-size:.875rem;font-weight:700;margin-bottom:.5rem">Full Name</label>
              <input type="text" placeholder="Jane Doe" style="width:100%;box-sizing:border-box;background:#F5F5F5;border:1px solid #E5E5E5;border-radius:12px;padding:.875rem 1.25rem;font-family:'Inter',sans-serif;font-size:.9375rem;color:#0A0A0A;outline:none;transition:border-color .2s" onfocus="this.style.borderColor='#FF6600'" onblur="this.style.borderColor='#E5E5E5'" />
            </div>
            <div>
              <label style="display:block;font-size:.875rem;font-weight:700;margin-bottom:.5rem">Email Address</label>
              <input type="email" placeholder="jane@example.com" style="width:100%;box-sizing:border-box;background:#F5F5F5;border:1px solid #E5E5E5;border-radius:12px;padding:.875rem 1.25rem;font-family:'Inter',sans-serif;font-size:.9375rem;color:#0A0A0A;outline:none;transition:border-color .2s" onfocus="this.style.borderColor='#FF6600'" onblur="this.style.borderColor='#E5E5E5'" />
            </div>
          </div>
          <div>
            <label style="display:block;font-size:.875rem;font-weight:700;margin-bottom:.5rem">Company <span style="font-weight:400;color:#999">(Optional)</span></label>
            <input type="text" placeholder="Your organization" style="width:100%;box-sizing:border-box;background:#F5F5F5;border:1px solid #E5E5E5;border-radius:12px;padding:.875rem 1.25rem;font-family:'Inter',sans-serif;font-size:.9375rem;color:#0A0A0A;outline:none;transition:border-color .2s" onfocus="this.style.borderColor='#FF6600'" onblur="this.style.borderColor='#E5E5E5'" />
          </div>
          <div>
            <label style="display:block;font-size:.875rem;font-weight:700;margin-bottom:.5rem">Nature of Enquiry</label>
            <div style="position:relative">
              <select style="width:100%;box-sizing:border-box;background:#F5F5F5;border:1px solid #E5E5E5;border-radius:12px;padding:.875rem 1.25rem;font-family:'Inter',sans-serif;font-size:.9375rem;color:#0A0A0A;appearance:none;cursor:pointer;outline:none">
                <option>Project Consultation</option>
                <option>Technical Advisory</option>
                <option>Speaking Engagement</option>
                <option>General Inquiry</option>
              </select>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#999" stroke-width="2" style="position:absolute;right:1.25rem;top:50%;transform:translateY(-50%);pointer-events:none"><polyline points="6 9 12 15 18 9"/></svg>
            </div>
          </div>
          <div>
            <label style="display:block;font-size:.875rem;font-weight:700;margin-bottom:.5rem">Message</label>
            <textarea rows="5" placeholder="Tell me about your project or infrastructure needs..." style="width:100%;box-sizing:border-box;background:#F5F5F5;border:1px solid #E5E5E5;border-radius:12px;padding:.875rem 1.25rem;font-family:'Inter',sans-serif;font-size:.9375rem;color:#0A0A0A;resize:vertical;outline:none;transition:border-color .2s" onfocus="this.style.borderColor='#FF6600'" onblur="this.style.borderColor='#E5E5E5'"></textarea>
          </div>
          <button type="submit" style="background:#0A0A0A;color:#fff;font-weight:700;font-size:1rem;padding:1rem;border-radius:12px;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:.75rem;transition:background .2s" onmouseover="this.style.background='#FF6600'" onmouseout="this.style.background='#0A0A0A'">
            Transmit Message
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
          </button>
        </form>
      </div>

      <!-- Sidebar -->
      <div style="display:flex;flex-direction:column;gap:1.5rem">

        <!-- Direct Contact -->
        <div style="background:#F5F5F5;border:1px solid #E5E5E5;border-radius:24px;padding:2rem">
          <p style="font-family:'JetBrains Mono',monospace;font-size:.75rem;color:#999;text-transform:uppercase;letter-spacing:.08em;margin-bottom:1.25rem">Direct Channels</p>
          <div style="display:flex;flex-direction:column;gap:.875rem">
            <a href="mailto:hello@alexchen.dev" style="text-decoration:none;display:flex;align-items:center;gap:1rem;padding:1rem;background:#fff;border-radius:14px;border:1px solid #E5E5E5;transition:border-color .2s" onmouseover="this.style.borderColor='#FF6600'" onmouseout="this.style.borderColor='#E5E5E5'">
              <div style="width:2.75rem;height:2.75rem;background:#0A0A0A;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              </div>
              <div>
                <div style="font-family:'JetBrains Mono',monospace;font-size:.7rem;color:#999;margin-bottom:.2rem">Email</div>
                <div style="font-weight:700;font-size:.9rem;color:#0A0A0A">hello@alexchen.dev</div>
              </div>
            </a>
            <div style="display:flex;align-items:center;gap:1rem;padding:1rem;background:#fff;border-radius:14px;border:1px solid #E5E5E5">
              <div style="width:2.75rem;height:2.75rem;background:#F5F5F5;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#0A0A0A" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <div>
                <div style="font-family:'JetBrains Mono',monospace;font-size:.7rem;color:#999;margin-bottom:.2rem">Location / Timezone</div>
                <div style="font-weight:700;font-size:.9rem;color:#0A0A0A">San Francisco, CA (PST)</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Social Grid -->
        <div style="background:#F5F5F5;border:1px solid #E5E5E5;border-radius:24px;padding:2rem">
          <p style="font-family:'JetBrains Mono',monospace;font-size:.75rem;color:#999;text-transform:uppercase;letter-spacing:.08em;margin-bottom:1.25rem">Digital Presence</p>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:.75rem">
            {[
              {label:'GitHub',icon:'github',href:'https://github.com',color:'#0A0A0A'},
              {label:'LinkedIn',icon:'linkedin',href:'https://linkedin.com',color:'#0A66C2'},
              {label:'Twitter/X',icon:'twitter',href:'https://twitter.com',color:'#0A0A0A'},
              {label:'Dev.to',icon:'dev',href:'https://dev.to',color:'#3B49DF'},
            ].map(s => (
              <a href={s.href} style="text-decoration:none;display:flex;flex-direction:column;align-items:center;padding:1.25rem;background:#fff;border-radius:16px;border:1px solid #E5E5E5;transition:all .2s;gap:.5rem" onmouseover={`this.style.borderColor='${s.color}';this.style.transform='translateY(-2px)'`} onmouseout="this.style.borderColor='#E5E5E5';this.style.transform='translateY(0)'">
                <div style={`width:2.25rem;height:2.25rem;background:${s.color};border-radius:8px;display:flex;align-items:center;justify-content:center`}>
                  {s.icon === 'github' && <svg width="16" height="16" viewBox="0 0 24 24" fill="#fff"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>}
                  {s.icon === 'linkedin' && <svg width="16" height="16" viewBox="0 0 24 24" fill="#fff"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>}
                  {s.icon === 'twitter' && <svg width="16" height="16" viewBox="0 0 24 24" fill="#fff"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>}
                  {s.icon === 'dev' && <span style="font-family:'JetBrains Mono',monospace;font-size:.75rem;font-weight:700;color:#fff">DEV</span>}
                </div>
                <span style="font-family:'JetBrains Mono',monospace;font-size:.75rem;font-weight:700;color:#0A0A0A">{s.label}</span>
              </a>
            ))}
          </div>
        </div>

        <!-- Schedule Call -->
        <div style="background:#0A0A0A;border-radius:24px;padding:2rem">
          <h3 style="font-size:1.125rem;font-weight:700;color:#fff;margin:0 0 .625rem">Schedule a Discovery Call</h3>
          <p style="font-size:.875rem;color:rgba(255,255,255,.5);line-height:1.65;margin:0 0 1.5rem">Skip the email back-and-forth. Book 30 minutes directly on my calendar.</p>
          <a href="#" style="display:flex;align-items:center;justify-content:center;gap:.625rem;background:#FF6600;color:#fff;font-weight:600;padding:.875rem;border-radius:12px;text-decoration:none;font-size:.9375rem">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            Open Calendar
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer style="background:#fff;border-top:1px solid #E5E5E5;padding:3rem 1.5rem">
    <div style="max-width:1200px;margin-inline:auto;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:1.5rem">
      <div style="font-weight:700;color:#0A0A0A">Alex Chen</div>
      <div style="display:flex;gap:1.5rem">
        <a href="https://github.com" style="color:#666;text-decoration:none" aria-label="GitHub"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg></a>
        <a href="https://twitter.com" style="color:#666;text-decoration:none" aria-label="Twitter"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a>
        <a href="https://linkedin.com" style="color:#666;text-decoration:none" aria-label="LinkedIn"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg></a>
      </div>
      <div style="font-size:.875rem;color:#999">© 2025 Alex Chen.</div>
    </div>
  </footer>

  <style>
    @keyframes pulse {
      0%, 100% { opacity:1; }
      50% { opacity:.4; }
    }
    @media (max-width:767px) {
      main section[style*="grid-template-columns:7fr 5fr"] { grid-template-columns:1fr !important; }
      main form > div[style*="grid-template-columns:1fr 1fr"] { grid-template-columns:1fr !important; }
    }
  </style>
</BaseLayout>
