---
import BaseLayout from '../../layouts/Base.astro';
import DNNav from '../../components/DNNav.astro';
---
<BaseLayout title="About Alex Chen — Full-Stack Developer" theme="dn">
  <link rel="stylesheet" href="/styles/rv.css" slot="head" />
  <DNNav active="about" />

  <main style="padding-top:5rem;background:#fff;color:#0A0A0A;font-family:'Inter',sans-serif">

    <!-- Hero -->
    <section style="padding:5rem 1.5rem 4rem;max-width:1200px;margin-inline:auto;display:grid;grid-template-columns:1fr 1.5fr;gap:4rem;align-items:start">
      <div>
        <img src="https://images.pexels.com/photos/2379004/pexels-photo-2379004.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Alex Chen" style="width:100%;border-radius:20px;object-fit:cover;aspect-ratio:3/4;display:block" />
        <div style="margin-top:1.5rem;background:#F5F5F5;border-radius:16px;padding:1.5rem">
          <p style="font-family:'JetBrains Mono',monospace;font-size:.75rem;color:#999;margin-bottom:1rem;text-transform:uppercase;letter-spacing:.05em">Quick Stats</p>
          <div style="display:flex;flex-direction:column;gap:.75rem">
            {[
              {k:'Location',v:'San Francisco, CA'},
              {k:'Timezone',v:'PST (UTC-8)'},
              {k:'Available',v:'Q3 2025'},
              {k:'Preferred',v:'Remote / Hybrid'},
            ].map(item => (
              <div style="display:flex;justify-content:space-between;align-items:center">
                <span style="font-size:.8125rem;color:#666">{item.k}</span>
                <span style="font-family:'JetBrains Mono',monospace;font-size:.8125rem;color:#0A0A0A;font-weight:600">{item.v}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
      <div>
        <div style="font-family:'JetBrains Mono',monospace;font-size:.875rem;color:#FF6600;font-weight:500;margin-bottom:.75rem;letter-spacing:.05em">whoami</div>
        <h1 style="font-size:clamp(2rem,4vw,3.5rem);font-weight:800;letter-spacing:-.04em;line-height:1.1;margin:0 0 1.5rem">I translate complex logic into human experiences.</h1>
        <div style="background:#F5F5F5;border:1px solid #E5E5E5;border-radius:16px;padding:1.75rem;font-family:'JetBrains Mono',monospace;font-size:.875rem;line-height:1.9;color:#444">
          <p style="margin:0 0 1.25rem;padding-left:1.5rem;position:relative">
            <span style="position:absolute;left:0;color:#FF6600">&gt;</span>
            I started as a backend developer who got frustrated with slow UIs. That frustration pushed me to master the full stack — not just knowing both ends, but understanding how they serve each other. Performance is my obsession.
          </p>
          <p style="margin:0 0 1.25rem;padding-left:1.5rem;position:relative">
            <span style="position:absolute;left:0;color:#FF6600">&gt;</span>
            5 years at startups and scale-ups taught me that the best architecture is the one your team can maintain. I write code for humans first, machines second.
          </p>
          <p style="margin:0;padding-left:1.5rem;position:relative">
            <span style="position:absolute;left:0;color:#FF6600">&gt;</span>
            When I'm offline, you'll find me contributing to OSS, writing technical deep dives, or rock climbing somewhere near the coast.
          </p>
        </div>
        <div style="display:flex;gap:1rem;margin-top:2rem;flex-wrap:wrap">
          <a href="/dn/contact/" style="background:#FF6600;color:#fff;font-weight:600;padding:.875rem 2rem;border-radius:9999px;text-decoration:none;font-size:.9375rem;box-shadow:0 4px 14px rgba(255,102,0,.39)">Get in Touch</a>
          <a href="/dn/resume/" style="background:#F5F5F5;color:#0A0A0A;font-weight:600;padding:.875rem 2rem;border-radius:9999px;text-decoration:none;font-size:.9375rem;border:1px solid #E5E5E5">View Resume</a>
        </div>
      </div>
    </section>

    <!-- Journey Timeline -->
    <section style="background:#F5F5F5;padding:5rem 1.5rem">
      <div style="max-width:900px;margin-inline:auto">
        <p style="font-family:'JetBrains Mono',monospace;font-size:.75rem;color:#FF6600;text-transform:uppercase;letter-spacing:.1em;margin-bottom:.5rem">git log --oneline</p>
        <h2 style="font-size:2rem;font-weight:700;letter-spacing:-.03em;margin:0 0 3rem">The Journey So Far</h2>
        <div style="border-left:2px solid #E5E5E5;padding-left:2.5rem;display:flex;flex-direction:column;gap:2.5rem">
          {[
            {period:'2022 – Present',role:'Tech Lead / Senior Engineer',company:'VeritasCloud',color:'#FF6600',desc:'Leading a team of 6 engineers building cloud-native data infrastructure. Architected migration from monolith to microservices, cutting deployment time by 70%.'},
            {period:'2020 – 2022',role:'Full-Stack Engineer',company:'Axiom Labs',color:'#0A0A0A',desc:'Built the core product from 0→1: real-time collaboration features, GraphQL API, React frontend. Scaled from 0 to 50k monthly active users.'},
            {period:'2019 – 2020',role:'Backend Developer',company:'Streamline.io',color:'#999',desc:'Node.js microservices, PostgreSQL optimization, Redis caching. Reduced API response time from 800ms to 120ms average through query optimization.'},
          ].map(job => (
            <div style="position:relative">
              <div style={`position:absolute;left:-2.875rem;top:.25rem;width:1rem;height:1rem;border-radius:50%;background:${job.color};border:3px solid #F5F5F5`}></div>
              <div style="font-family:'JetBrains Mono',monospace;font-size:.8125rem;color:#999;margin-bottom:.375rem">{job.period}</div>
              <h3 style="font-size:1.25rem;font-weight:700;margin:0 0 .25rem">{job.role} <span style="font-weight:400;color:#666">@ {job.company}</span></h3>
              <p style="font-size:.9375rem;color:#555;line-height:1.6;margin:0;max-width:600px">{job.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Operating Principles -->
    <section style="padding:5rem 1.5rem;max-width:1200px;margin-inline:auto">
      <div style="text-align:center;margin-bottom:3rem">
        <p style="font-family:'JetBrains Mono',monospace;font-size:.75rem;color:#FF6600;text-transform:uppercase;letter-spacing:.1em;margin-bottom:.5rem">System.print("Values")</p>
        <h2 style="font-size:2rem;font-weight:700;letter-spacing:-.03em;margin:0">Operating Principles</h2>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1.5rem">
        {[
          {icon:'⚡',title:'Performance = UX',desc:'Speed is a feature. A 100ms delay is a broken promise. Every architectural decision gets weighed against its perf cost.'},
          {icon:'🎯',title:'Radical Simplicity',desc:'Complexity is easy, simplicity is hard. I strip until only essentials remain. Interfaces should fade into the background.'},
          {icon:'🤝',title:'Empathy in Code',desc:'Code is for humans to maintain. Clear variable names, thorough docs, and accessible markup are non-negotiable.'},
          {icon:'🔁',title:'Ship & Iterate',desc:'Perfect is the enemy of shipped. I bias toward releasing, measuring, and improving over long planning cycles.'},
        ].map(v => (
          <div style="background:#0A0A0A;border-radius:20px;padding:2rem">
            <div style="font-size:2rem;margin-bottom:1rem">{v.icon}</div>
            <h3 style="font-family:'JetBrains Mono',monospace;font-size:1rem;font-weight:600;color:#fff;margin:0 0 .625rem">{v.title}</h3>
            <p style="font-size:.875rem;color:rgba(255,255,255,.55);line-height:1.65;margin:0">{v.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Open Source + Fun Facts -->
    <section style="background:#F5F5F5;padding:5rem 1.5rem">
      <div style="max-width:1200px;margin-inline:auto;display:grid;grid-template-columns:1fr 1fr;gap:4rem">
        <div>
          <p style="font-family:'JetBrains Mono',monospace;font-size:.75rem;color:#FF6600;text-transform:uppercase;letter-spacing:.1em;margin-bottom:.5rem">Currently Executing</p>
          <h2 style="font-size:1.75rem;font-weight:700;margin:0 0 2rem;letter-spacing:-.02em">What's on my desk</h2>
          <div style="display:flex;flex-direction:column;gap:1.25rem">
            {[
              {emoji:'🔬',t:'Exploring Rust for system tools',d:'Building a custom file watcher with Rust for the fun of it.'},
              {emoji:'✍️',t:'Writing "Zero to Prod" series',d:'A practical guide on launching full-stack apps solo, from scratch.'},
              {emoji:'👥',t:'Mentoring 2 junior developers',d:'Weekly 1:1s helping them navigate their first production systems.'},
              {emoji:'⭐',t:'devflow-cli maintainer',d:'Keeping up with 2.4k stars and 150+ open issues on my CLI tool.'},
            ].map(item => (
              <div style="display:flex;gap:1rem;align-items:flex-start">
                <div style="font-size:1.25rem;flex-shrink:0;margin-top:.1rem">{item.emoji}</div>
                <div>
                  <div style="font-weight:600;font-size:.9375rem;margin-bottom:.25rem">{item.t}</div>
                  <div style="font-size:.875rem;color:#666">{item.d}</div>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div>
          <p style="font-family:'JetBrains Mono',monospace;font-size:.75rem;color:#FF6600;text-transform:uppercase;letter-spacing:.1em;margin-bottom:.5rem">Off-Screen</p>
          <h2 style="font-size:1.75rem;font-weight:700;margin:0 0 2rem;letter-spacing:-.02em">Beyond the IDE</h2>
          <p style="font-family:'JetBrains Mono',monospace;font-size:.875rem;color:#555;line-height:1.8;background:#fff;border:1px solid #E5E5E5;border-radius:16px;padding:1.5rem;margin-bottom:1.5rem">
            I spend most of my day defining precise logic, so my downtime leans into analog unpredictability. Film photography, bouldering, and tinkering with mechanical keyboards.
          </p>
          <div style="display:flex;flex-wrap:wrap;gap:.625rem">
            {['Analog Photography','Bouldering','Mechanical Keyboards','Sci-Fi Novels','Coffee Brewing','Jazz Piano'].map(tag => (
              <span style="font-family:'JetBrains Mono',monospace;font-size:.8125rem;background:#0A0A0A;color:#fff;border-radius:8px;padding:.375rem .875rem">{tag}</span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section style="background:#FF6600;padding:4rem 1.5rem;text-align:center">
      <h2 style="font-size:2.5rem;font-weight:800;color:#fff;letter-spacing:-.04em;margin:0 0 1rem">Let's build something together</h2>
      <p style="font-size:1.125rem;color:rgba(255,255,255,.85);margin:0 0 2rem">Always open to interesting problems and good people.</p>
      <a href="/dn/contact/" style="background:#fff;color:#FF6600;font-size:1rem;font-weight:700;padding:1rem 2.5rem;border-radius:9999px;text-decoration:none">Say Hello</a>
    </section>
  </main>

  <footer style="background:#fff;border-top:1px solid #E5E5E5;padding:3rem 1.5rem">
    <div style="max-width:1200px;margin-inline:auto;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:1.5rem">
      <div style="font-weight:700;color:#0A0A0A">Alex Chen</div>
      <div style="display:flex;gap:1.5rem">
        <a href="https://github.com" style="color:#666;text-decoration:none" aria-label="GitHub"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg></a>
        <a href="https://twitter.com" style="color:#666;text-decoration:none" aria-label="Twitter"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a>
        <a href="https://linkedin.com" style="color:#666;text-decoration:none" aria-label="LinkedIn"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg></a>
      </div>
      <div style="font-size:.875rem;color:#999">© 2025 Alex Chen.</div>
    </div>
  </footer>

  <style>
    @media (max-width:767px) {
      main > section:first-child, main > section:nth-child(5) { grid-template-columns:1fr !important; }
    }
  </style>
</BaseLayout>
