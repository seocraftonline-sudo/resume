---
import BaseLayout from '../../layouts/Base.astro';
import DNNav from '../../components/DNNav.astro';
---
<BaseLayout title="Alex Chen — Full-Stack Developer & Tech Lead" theme="dn">
  <link rel="stylesheet" href="/styles/rv.css" slot="head" />
  <DNNav active="home" />

  <main style="padding-top:5rem;background:#fff;color:#0A0A0A;font-family:'Inter',sans-serif">

    <!-- Hero -->
    <section style="padding:5rem 1.5rem 4rem;max-width:1200px;margin-inline:auto;display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:center">
      <div>
        <div style="display:inline-flex;align-items:center;gap:.5rem;background:#F5F5F5;border:1px solid #E5E5E5;border-radius:9999px;padding:.375rem 1rem;margin-bottom:1.5rem">
          <span style="width:.5rem;height:.5rem;background:#10B981;border-radius:50%;display:inline-block"></span>
          <span style="font-family:'JetBrains Mono',monospace;font-size:.75rem;color:#666;letter-spacing:.05em">Available for new projects</span>
        </div>
        <div style="font-family:'JetBrains Mono',monospace;font-size:.875rem;color:#FF6600;font-weight:500;margin-bottom:.75rem;letter-spacing:.05em">Alex Chen</div>
        <h1 style="font-size:clamp(2.5rem,5vw,4rem);font-weight:800;line-height:1.05;letter-spacing:-.04em;color:#0A0A0A;margin:0 0 1.5rem">
          Full-Stack<br/>Developer &<br/><span style="color:#FF6600">Tech Lead</span>
        </h1>
        <p style="font-size:1.125rem;color:#555;line-height:1.7;max-width:480px;margin-bottom:2.5rem">
          I build performant, scalable systems end-to-end — from pixel-perfect React UIs to distributed Node.js APIs running on AWS. 5+ years shipping production apps.
        </p>
        <div style="display:flex;gap:1rem;flex-wrap:wrap">
          <a href="/dn/portfolio/" style="background:#0A0A0A;color:#fff;font-size:.9375rem;font-weight:600;padding:.875rem 2rem;border-radius:9999px;text-decoration:none;transition:background .2s">View Work</a>
          <a href="/dn/contact/" style="background:#FF6600;color:#fff;font-size:.9375rem;font-weight:600;padding:.875rem 2rem;border-radius:9999px;text-decoration:none;box-shadow:0 4px 14px rgba(255,102,0,.39)">Let's Talk</a>
        </div>
      </div>
      <!-- Terminal window decoration -->
      <div style="background:#0A0A0A;border-radius:16px;padding:1.5rem;box-shadow:0 25px 50px rgba(0,0,0,.2)">
        <div style="display:flex;gap:.5rem;margin-bottom:1.25rem">
          <span style="width:.75rem;height:.75rem;border-radius:50%;background:#FF5F57"></span>
          <span style="width:.75rem;height:.75rem;border-radius:50%;background:#FFBD2E"></span>
          <span style="width:.75rem;height:.75rem;border-radius:50%;background:#28C840"></span>
          <span style="font-family:'JetBrains Mono',monospace;font-size:.75rem;color:rgba(255,255,255,.4);margin-left:auto">alex@macbook ~ </span>
        </div>
        <pre style="font-family:'JetBrains Mono',monospace;font-size:.8125rem;line-height:1.8;color:rgba(255,255,255,.85);margin:0;white-space:pre-wrap"><span style="color:#FF6600">const</span> <span style="color:#9DD3FF">alex</span> = &#123;
  <span style="color:#A8D8A8">role</span>: <span style="color:#FFD580">"Full-Stack Dev"</span>,
  <span style="color:#A8D8A8">stack</span>: [<span style="color:#FFD580">"React"</span>, <span style="color:#FFD580">"Node"</span>, <span style="color:#FFD580">"AWS"</span>],
  <span style="color:#A8D8A8">years</span>: <span style="color:#FF6600">5</span>,
  <span style="color:#A8D8A8">repos</span>: <span style="color:#FF6600">80</span>,
  <span style="color:#A8D8A8">apps</span>: <span style="color:#FF6600">12</span>,
  <span style="color:#A8D8A8">open</span>: <span style="color:#9DD3FF">true</span>
&#125;

<span style="color:rgba(255,255,255,.4)">// Currently building...</span>
<span style="color:#FF6600">npm run</span> <span style="color:#9DD3FF">ship-it</span> <span style="color:rgba(255,255,255,.4)">✓</span></pre>
      </div>
    </section>

    <!-- Stats -->
    <section style="background:#F5F5F5;padding:3rem 1.5rem;border-top:1px solid #E5E5E5;border-bottom:1px solid #E5E5E5">
      <div style="max-width:900px;margin-inline:auto;display:grid;grid-template-columns:repeat(3,1fr);gap:2rem;text-align:center">
        <div>
          <div style="font-family:'JetBrains Mono',monospace;font-size:3rem;font-weight:700;color:#0A0A0A">5+</div>
          <div style="font-size:.875rem;color:#666;text-transform:uppercase;letter-spacing:.08em;margin-top:.25rem">Years Experience</div>
        </div>
        <div style="border-inline:1px solid #E5E5E5;padding-inline:2rem">
          <div style="font-family:'JetBrains Mono',monospace;font-size:3rem;font-weight:700;color:#0A0A0A">80+</div>
          <div style="font-size:.875rem;color:#666;text-transform:uppercase;letter-spacing:.08em;margin-top:.25rem">GitHub Repos</div>
        </div>
        <div>
          <div style="font-family:'JetBrains Mono',monospace;font-size:3rem;font-weight:700;color:#0A0A0A">12</div>
          <div style="font-size:.875rem;color:#666;text-transform:uppercase;letter-spacing:.08em;margin-top:.25rem">Production Apps</div>
        </div>
      </div>
    </section>

    <!-- Tech Stack -->
    <section style="padding:4rem 1.5rem;max-width:1200px;margin-inline:auto">
      <p style="font-family:'JetBrains Mono',monospace;font-size:.75rem;color:#999;text-transform:uppercase;letter-spacing:.1em;margin-bottom:1.5rem">Tech Stack</p>
      <div style="display:flex;flex-wrap:wrap;gap:.75rem">
        {['React', 'Next.js', 'TypeScript', 'Node.js', 'Python', 'PostgreSQL', 'Redis', 'AWS', 'Docker', 'GraphQL', 'Prisma', 'Tailwind'].map(tech => (
          <span style="font-family:'JetBrains Mono',monospace;font-size:.8125rem;background:#F5F5F5;border:1px solid #E5E5E5;border-radius:8px;padding:.375rem .875rem;color:#0A0A0A;font-weight:500">{tech}</span>
        ))}
      </div>
    </section>

    <!-- Featured Projects -->
    <section style="padding:2rem 1.5rem 5rem;max-width:1200px;margin-inline:auto">
      <div style="display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:2.5rem">
        <div>
          <p style="font-family:'JetBrains Mono',monospace;font-size:.75rem;color:#FF6600;text-transform:uppercase;letter-spacing:.1em;margin-bottom:.5rem">Selected Work</p>
          <h2 style="font-size:2rem;font-weight:700;letter-spacing:-.03em;margin:0">Featured Projects</h2>
        </div>
        <a href="/dn/portfolio/" style="font-size:.875rem;color:#FF6600;font-weight:600;text-decoration:none">View all →</a>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:1.5rem">

        <article style="background:#fff;border:1px solid #E5E5E5;border-radius:20px;overflow:hidden;transition:box-shadow .2s,transform .2s">
          <img src="https://images.pexels.com/photos/1181671/pexels-photo-1181671.jpeg?auto=compress&cs=tinysrgb&w=800" alt="API Gateway" style="width:100%;height:200px;object-fit:cover;display:block" />
          <div style="padding:1.5rem">
            <div style="display:flex;gap:.5rem;margin-bottom:1rem">
              <span style="font-family:'JetBrains Mono',monospace;font-size:.75rem;background:#FFF0E6;color:#FF6600;border-radius:6px;padding:.25rem .625rem">Node.js</span>
              <span style="font-family:'JetBrains Mono',monospace;font-size:.75rem;background:#F5F5F5;color:#555;border-radius:6px;padding:.25rem .625rem">AWS Lambda</span>
            </div>
            <h3 style="font-size:1.25rem;font-weight:700;margin:0 0 .5rem;letter-spacing:-.02em">NexusAPI Gateway</h3>
            <p style="font-size:.9rem;color:#666;line-height:1.6;margin:0 0 1.25rem">High-throughput API gateway handling 50M+ daily requests. Built with Node.js microservices on AWS Lambda with Redis caching layer.</p>
            <div style="display:flex;gap:1rem">
              <a href="/dn/projects/" style="font-size:.875rem;color:#FF6600;font-weight:600;text-decoration:none">Case Study →</a>
              <a href="https://github.com" style="font-size:.875rem;color:#999;font-weight:500;text-decoration:none">GitHub</a>
            </div>
          </div>
        </article>

        <article style="background:#fff;border:1px solid #E5E5E5;border-radius:20px;overflow:hidden;transition:box-shadow .2s,transform .2s">
          <img src="https://images.pexels.com/photos/265087/pexels-photo-265087.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Dashboard" style="width:100%;height:200px;object-fit:cover;display:block" />
          <div style="padding:1.5rem">
            <div style="display:flex;gap:.5rem;margin-bottom:1rem">
              <span style="font-family:'JetBrains Mono',monospace;font-size:.75rem;background:#FFF0E6;color:#FF6600;border-radius:6px;padding:.25rem .625rem">React</span>
              <span style="font-family:'JetBrains Mono',monospace;font-size:.75rem;background:#F5F5F5;color:#555;border-radius:6px;padding:.25rem .625rem">TypeScript</span>
            </div>
            <h3 style="font-size:1.25rem;font-weight:700;margin:0 0 .5rem;letter-spacing:-.02em">Pulse Analytics Dashboard</h3>
            <p style="font-size:.9rem;color:#666;line-height:1.6;margin:0 0 1.25rem">Real-time analytics platform visualizing millions of data points. WebSocket-powered live updates with D3.js chart library.</p>
            <div style="display:flex;gap:1rem">
              <a href="/dn/projects/" style="font-size:.875rem;color:#FF6600;font-weight:600;text-decoration:none">Case Study →</a>
              <a href="https://github.com" style="font-size:.875rem;color:#999;font-weight:500;text-decoration:none">GitHub</a>
            </div>
          </div>
        </article>

        <article style="background:#fff;border:1px solid #E5E5E5;border-radius:20px;overflow:hidden;transition:box-shadow .2s,transform .2s">
          <img src="https://images.pexels.com/photos/546819/pexels-photo-546819.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Open source" style="width:100%;height:200px;object-fit:cover;display:block" />
          <div style="padding:1.5rem">
            <div style="display:flex;gap:.5rem;margin-bottom:1rem">
              <span style="font-family:'JetBrains Mono',monospace;font-size:.75rem;background:#FFF0E6;color:#FF6600;border-radius:6px;padding:.25rem .625rem">Python</span>
              <span style="font-family:'JetBrains Mono',monospace;font-size:.75rem;background:#F5F5F5;color:#555;border-radius:6px;padding:.25rem .625rem">PostgreSQL</span>
            </div>
            <h3 style="font-size:1.25rem;font-weight:700;margin:0 0 .5rem;letter-spacing:-.02em">DevFlow CLI</h3>
            <p style="font-size:.9rem;color:#666;line-height:1.6;margin:0 0 1.25rem">Open-source developer workflow automation tool. 2.4k stars on GitHub. Reduces repetitive tasks with custom pipeline definitions.</p>
            <div style="display:flex;gap:1rem">
              <a href="/dn/projects/" style="font-size:.875rem;color:#FF6600;font-weight:600;text-decoration:none">Case Study →</a>
              <a href="https://github.com" style="font-size:.875rem;color:#999;font-weight:500;text-decoration:none">GitHub ★ 2.4k</a>
            </div>
          </div>
        </article>
      </div>
    </section>

    <!-- What I Build -->
    <section style="background:#0A0A0A;padding:5rem 1.5rem">
      <div style="max-width:1200px;margin-inline:auto">
        <p style="font-family:'JetBrains Mono',monospace;font-size:.75rem;color:#FF6600;text-transform:uppercase;letter-spacing:.1em;margin-bottom:.75rem">Services</p>
        <h2 style="font-size:2.5rem;font-weight:800;color:#fff;letter-spacing:-.04em;margin:0 0 3rem">What I Build</h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1.5rem">
          {[
            {icon:'⚡',title:'Full-Stack Dev',desc:'End-to-end applications from database schema to pixel-perfect UI'},
            {icon:'🔌',title:'API Design',desc:'RESTful & GraphQL APIs with OpenAPI specs, rate limiting, versioning'},
            {icon:'☁️',title:'Cloud Infrastructure',desc:'AWS architecture, CI/CD pipelines, Docker & Kubernetes deployments'},
            {icon:'🔍',title:'Code Review',desc:'Architecture audits, performance profiling, and best-practices consulting'},
          ].map(s => (
            <div style="background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:16px;padding:1.75rem">
              <div style="font-size:1.75rem;margin-bottom:1rem">{s.icon}</div>
              <h3 style="font-size:1.125rem;font-weight:700;color:#fff;margin:0 0 .5rem">{s.title}</h3>
              <p style="font-size:.875rem;color:rgba(255,255,255,.55);line-height:1.6;margin:0">{s.desc}</p>
            </div>
          ))}
        </div>
        <div style="margin-top:2.5rem;text-align:center">
          <a href="/dn/services/" style="background:#FF6600;color:#fff;font-size:.9375rem;font-weight:600;padding:.875rem 2.5rem;border-radius:9999px;text-decoration:none;box-shadow:0 4px 14px rgba(255,102,0,.39)">See All Services</a>
        </div>
      </div>
    </section>

    <!-- Recent Writing -->
    <section style="padding:5rem 1.5rem;max-width:1200px;margin-inline:auto">
      <div style="display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:2.5rem">
        <div>
          <p style="font-family:'JetBrains Mono',monospace;font-size:.75rem;color:#FF6600;text-transform:uppercase;letter-spacing:.1em;margin-bottom:.5rem">From the Blog</p>
          <h2 style="font-size:2rem;font-weight:700;letter-spacing:-.03em;margin:0">Recent Writing</h2>
        </div>
        <a href="/dn/blog/" style="font-size:.875rem;color:#FF6600;font-weight:600;text-decoration:none">All posts →</a>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:1.5rem">
        {[
          {tag:'Tutorial',title:'Building a Type-Safe API with tRPC and Next.js',date:'May 14, 2025',read:'8 min'},
          {tag:'Deep Dive',title:'Why I Migrated from REST to GraphQL (and Back)',date:'Apr 28, 2025',read:'12 min'},
          {tag:'Opinion',title:'The Hidden Cost of Over-Engineering',date:'Mar 10, 2025',read:'5 min'},
        ].map(post => (
          <a href="/dn/blog/" style="text-decoration:none;display:block;background:#F5F5F5;border:1px solid #E5E5E5;border-radius:16px;padding:1.5rem;transition:border-color .2s">
            <span style={`font-family:'JetBrains Mono',monospace;font-size:.75rem;background:${post.tag==='Tutorial'?'#FFF0E6':'#F0F0F0'};color:${post.tag==='Tutorial'?'#FF6600':'#555'};border-radius:6px;padding:.25rem .625rem;display:inline-block;margin-bottom:1rem`}>{post.tag}</span>
            <h3 style="font-size:1.0625rem;font-weight:700;color:#0A0A0A;margin:0 0 .75rem;line-height:1.4">{post.title}</h3>
            <div style="font-size:.8125rem;color:#999">{post.date} · {post.read} read</div>
          </a>
        ))}
      </div>
    </section>

    <!-- CTA Banner -->
    <section style="background:#FF6600;padding:5rem 1.5rem;text-align:center">
      <div style="max-width:700px;margin-inline:auto">
        <h2 style="font-size:clamp(2rem,4vw,3rem);font-weight:800;color:#fff;letter-spacing:-.04em;margin:0 0 1rem">Ready to ship something great?</h2>
        <p style="font-size:1.125rem;color:rgba(255,255,255,.85);margin:0 0 2.5rem">I'm currently available for new projects. Let's discuss what you're building.</p>
        <a href="/dn/contact/" style="background:#fff;color:#FF6600;font-size:1rem;font-weight:700;padding:1rem 2.5rem;border-radius:9999px;text-decoration:none">Start a Conversation</a>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer style="background:#fff;border-top:1px solid #E5E5E5;padding:3rem 1.5rem">
    <div style="max-width:1200px;margin-inline:auto;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:1.5rem">
      <div style="display:flex;align-items:center;gap:.75rem">
        <div style="width:2rem;height:2rem;background:#0A0A0A;border-radius:8px;display:flex;align-items:center;justify-content:center">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
        </div>
        <span style="font-weight:700;color:#0A0A0A">Alex Chen</span>
      </div>
      <div style="display:flex;gap:1.5rem">
        <a href="https://github.com" style="color:#666;text-decoration:none" aria-label="GitHub">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
        </a>
        <a href="https://twitter.com" style="color:#666;text-decoration:none" aria-label="Twitter">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a href="https://linkedin.com" style="color:#666;text-decoration:none" aria-label="LinkedIn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
      </div>
      <div style="font-size:.875rem;color:#999">© 2025 Alex Chen.</div>
    </div>
  </footer>

  <style>
    @media (max-width:767px) {
      main section:first-child { grid-template-columns:1fr !important; }
    }
  </style>
</BaseLayout>
