---
import BaseLayout from '../../layouts/Base.astro';
import PPNav from '../../components/PPNav.astro';
---
<BaseLayout title="Contact — Edward James" theme="pp">
  <link rel="stylesheet" href="/styles/rv.css" slot="head" />
  <PPNav active="contact" />
  <main style="padding-top:5rem;background:#F9FAFB;min-height:100vh;font-family:'Inter',sans-serif">

    <div style="max-width:1280px;margin-inline:auto;padding:4rem 1.5rem;display:flex;flex-direction:column;gap:4rem">

      <!-- Header -->
      <section style="max-width:42rem">
        <h1 style="font-size:clamp(2.25rem,4vw,3.25rem);font-weight:700;color:#111827;letter-spacing:-.03em;margin:0 0 1rem">Work With Edward</h1>
        <p style="font-size:1.0625rem;color:#4B5563;line-height:1.7;margin:0">I am currently accepting select advisory engagements and independent board positions for Q3 2026. All initial enquiries are handled with full confidentiality.</p>
      </section>

      <!-- Main Contact Grid -->
      <div class="pp-contact-main" style="display:grid;grid-template-columns:1fr 1.4fr;gap:3.5rem;align-items:flex-start">

        <!-- Left: Contact Details + Offices -->
        <div style="display:flex;flex-direction:column;gap:2.5rem">

          <div style="background:#fff;padding:2rem;border-radius:1.5rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05)">
            <h3 style="font-size:1rem;font-weight:700;color:#111827;margin:0 0 1.5rem;letter-spacing:-.01em">Direct Contact</h3>
            <div style="display:flex;flex-direction:column;gap:1.25rem">
              <div style="display:flex;align-items:flex-start;gap:1rem">
                <div style="width:2.25rem;height:2.25rem;background:#F3F4F6;border-radius:.5rem;display:flex;align-items:center;justify-content:center;flex-shrink:0;border:1px solid #E5E7EB">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                </div>
                <div>
                  <div style="font-size:.75rem;color:#9CA3AF;font-weight:600;text-transform:uppercase;letter-spacing:.06em;margin-bottom:.25rem">Email</div>
                  <a href="mailto:contact@edwardjames.com" style="font-size:.9375rem;color:#111827;font-weight:500;text-decoration:none">contact@edwardjames.com</a>
                </div>
              </div>
              <div style="display:flex;align-items:flex-start;gap:1rem">
                <div style="width:2.25rem;height:2.25rem;background:#F3F4F6;border-radius:.5rem;display:flex;align-items:center;justify-content:center;flex-shrink:0;border:1px solid #E5E7EB">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.7a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 3h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 10.14a16 16 0 0 0 5.77 5.77l1.38-1.38a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                </div>
                <div>
                  <div style="font-size:.75rem;color:#9CA3AF;font-weight:600;text-transform:uppercase;letter-spacing:.06em;margin-bottom:.25rem">Phone</div>
                  <a href="tel:+442071234567" style="font-size:.9375rem;color:#111827;font-weight:500;text-decoration:none">+44 (0)20 7123 4567</a>
                </div>
              </div>
              <div style="display:flex;align-items:flex-start;gap:1rem">
                <div style="width:2.25rem;height:2.25rem;background:#F3F4F6;border-radius:.5rem;display:flex;align-items:center;justify-content:center;flex-shrink:0;border:1px solid #E5E7EB">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
                </div>
                <div>
                  <div style="font-size:.75rem;color:#9CA3AF;font-weight:600;text-transform:uppercase;letter-spacing:.06em;margin-bottom:.25rem">LinkedIn</div>
                  <a href="https://linkedin.com" target="_blank" rel="noopener" style="font-size:.9375rem;color:#111827;font-weight:500;text-decoration:none">linkedin.com/in/edwardjames</a>
                </div>
              </div>
            </div>
          </div>

          <!-- Office Locations -->
          <div style="background:#fff;padding:2rem;border-radius:1.5rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05)">
            <h3 style="font-size:1rem;font-weight:700;color:#111827;margin:0 0 1.5rem;letter-spacing:-.01em">Office Locations</h3>
            <div style="display:flex;flex-direction:column;gap:1.5rem">
              <div>
                <div style="display:flex;align-items:center;gap:.625rem;margin-bottom:.5rem">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#4B5563" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                  <span style="font-size:.8125rem;font-weight:700;color:#111827;text-transform:uppercase;letter-spacing:.06em">London (Primary)</span>
                </div>
                <p style="font-size:.875rem;color:#4B5563;line-height:1.6;margin:0">Nexus Group Advisory<br>25 Old Broad Street, EC2N 1HN<br>London, United Kingdom</p>
              </div>
              <div style="border-top:1px solid #F3F4F6;padding-top:1.5rem">
                <div style="display:flex;align-items:center;gap:.625rem;margin-bottom:.5rem">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#4B5563" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                  <span style="font-size:.8125rem;font-weight:700;color:#111827;text-transform:uppercase;letter-spacing:.06em">New York (Secondary)</span>
                </div>
                <p style="font-size:.875rem;color:#4B5563;line-height:1.6;margin:0">530 Fifth Avenue, Floor 12<br>New York, NY 10036<br>United States</p>
              </div>
            </div>
          </div>

          <!-- Book a Call Card -->
          <div style="background:#111827;padding:2rem;border-radius:1.5rem;position:relative;overflow:hidden">
            <div style="position:absolute;top:-3rem;right:-3rem;width:12rem;height:12rem;background:rgba(255,255,255,.04);border-radius:50%"></div>
            <div style="position:relative;z-index:1">
              <h3 style="font-size:1rem;font-weight:700;color:#fff;margin:0 0 .5rem">Book a Discovery Call</h3>
              <p style="font-size:.875rem;color:#9CA3AF;line-height:1.6;margin:0 0 1.5rem">30-minute confidential conversation to discuss your organization's challenges and whether there's a fit for engagement.</p>
              <div style="display:flex;align-items:center;gap:1rem;margin-bottom:1.5rem">
                <div style="display:flex;align-items:center;gap:.375rem;font-size:.8125rem;color:#9CA3AF">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                  30 minutes
                </div>
                <div style="display:flex;align-items:center;gap:.375rem;font-size:.8125rem;color:#9CA3AF">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                  Video or phone
                </div>
              </div>
              <a href="#" style="display:block;text-align:center;padding:.875rem;background:#fff;color:#111827;border-radius:9999px;font-size:.875rem;font-weight:700;text-decoration:none">Schedule Call via Calendly</a>
            </div>
          </div>

        </div>

        <!-- Right: Inquiry Form -->
        <div style="background:#fff;padding:2.5rem;border-radius:1.5rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05)">
          <h2 style="font-size:1.375rem;font-weight:700;color:#111827;margin:0 0 .5rem;letter-spacing:-.02em">Enquiry Form</h2>
          <p style="font-size:.9rem;color:#6B7280;margin:0 0 2rem;line-height:1.55">Complete the form below and I will respond within 48 hours. All information is treated with complete confidentiality.</p>

          <form onsubmit="return false" style="display:flex;flex-direction:column;gap:1.375rem">
            <div class="pp-form-row" style="display:grid;grid-template-columns:1fr 1fr;gap:1.25rem">
              <div>
                <label style="display:block;font-size:.8125rem;font-weight:600;color:#374151;margin-bottom:.5rem">First Name</label>
                <input type="text" placeholder="Thomas" style="width:100%;padding:.75rem 1rem;border:1px solid #E5E7EB;border-radius:.75rem;font-size:.875rem;color:#111827;background:#F9FAFB;font-family:'Inter',sans-serif;outline:none;box-sizing:border-box" />
              </div>
              <div>
                <label style="display:block;font-size:.8125rem;font-weight:600;color:#374151;margin-bottom:.5rem">Last Name</label>
                <input type="text" placeholder="Brandt" style="width:100%;padding:.75rem 1rem;border:1px solid #E5E7EB;border-radius:.75rem;font-size:.875rem;color:#111827;background:#F9FAFB;font-family:'Inter',sans-serif;outline:none;box-sizing:border-box" />
              </div>
            </div>

            <div>
              <label style="display:block;font-size:.8125rem;font-weight:600;color:#374151;margin-bottom:.5rem">Corporate Email</label>
              <input type="email" placeholder="t.brandt@company.com" style="width:100%;padding:.75rem 1rem;border:1px solid #E5E7EB;border-radius:.75rem;font-size:.875rem;color:#111827;background:#F9FAFB;font-family:'Inter',sans-serif;outline:none;box-sizing:border-box" />
            </div>

            <div>
              <label style="display:block;font-size:.8125rem;font-weight:600;color:#374151;margin-bottom:.5rem">Organization &amp; Title</label>
              <input type="text" placeholder="CEO, Acme Corporation" style="width:100%;padding:.75rem 1rem;border:1px solid #E5E7EB;border-radius:.75rem;font-size:.875rem;color:#111827;background:#F9FAFB;font-family:'Inter',sans-serif;outline:none;box-sizing:border-box" />
            </div>

            <div>
              <label style="display:block;font-size:.8125rem;font-weight:600;color:#374151;margin-bottom:.5rem">Engagement Type</label>
              <select style="width:100%;padding:.75rem 1rem;border:1px solid #E5E7EB;border-radius:.75rem;font-size:.875rem;color:#111827;background:#F9FAFB;font-family:'Inter',sans-serif;outline:none;box-sizing:border-box;-webkit-appearance:none">
                <option value="">Select engagement type...</option>
                <option>Board Governance Structuring</option>
                <option>M&amp;A Integration Advisory</option>
                <option>Risk Architecture</option>
                <option>Executive Advisory Retainer</option>
                <option>Independent Board Director</option>
                <option>Speaking Engagement</option>
                <option>Other / Discuss</option>
              </select>
            </div>

            <div>
              <label style="display:block;font-size:.8125rem;font-weight:600;color:#374151;margin-bottom:.5rem">Indicative Budget Range</label>
              <select style="width:100%;padding:.75rem 1rem;border:1px solid #E5E7EB;border-radius:.75rem;font-size:.875rem;color:#111827;background:#F9FAFB;font-family:'Inter',sans-serif;outline:none;box-sizing:border-box;-webkit-appearance:none">
                <option value="">Select range (optional)...</option>
                <option>Under $100K</option>
                <option>$100K – $250K</option>
                <option>$250K – $500K</option>
                <option>$500K – $1M</option>
                <option>$1M+</option>
                <option>Prefer to discuss</option>
              </select>
            </div>

            <div>
              <label style="display:block;font-size:.8125rem;font-weight:600;color:#374151;margin-bottom:.5rem">Describe the Challenge</label>
              <textarea placeholder="Please describe the strategic challenge or opportunity you are facing, and what outcome you are seeking from this engagement..." rows="5" style="width:100%;padding:.875rem 1rem;border:1px solid #E5E7EB;border-radius:.75rem;font-size:.875rem;color:#111827;background:#F9FAFB;font-family:'Inter',sans-serif;outline:none;resize:vertical;box-sizing:border-box;line-height:1.6"></textarea>
            </div>

            <div style="display:flex;align-items:flex-start;gap:.75rem;padding:1rem;background:#F9FAFB;border-radius:.75rem;border:1px solid #E5E7EB">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#4B5563" stroke-width="2" style="flex-shrink:0;margin-top:1px"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              <p style="font-size:.8125rem;color:#4B5563;line-height:1.55;margin:0">All enquiries are treated with strict confidentiality. Your information will not be shared with any third parties and will be used solely to assess engagement fit.</p>
            </div>

            <button type="submit" style="width:100%;padding:1rem;background:#111827;color:#fff;border:none;border-radius:9999px;font-size:.9375rem;font-weight:700;cursor:pointer;font-family:'Inter',sans-serif;transition:background .2s ease">Submit Enquiry</button>
          </form>
        </div>

      </div>

      <!-- Response Commitment -->
      <section>
        <div class="pp-commitment-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:1.25rem">
          <div style="background:#fff;padding:1.75rem;border-radius:1.25rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05);text-align:center">
            <div style="font-size:1.625rem;font-weight:700;color:#111827;margin-bottom:.375rem">48 hrs</div>
            <div style="font-size:.875rem;color:#4B5563">Response to all enquiries</div>
          </div>
          <div style="background:#fff;padding:1.75rem;border-radius:1.25rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05);text-align:center">
            <div style="font-size:1.625rem;font-weight:700;color:#111827;margin-bottom:.375rem">Confidential</div>
            <div style="font-size:.875rem;color:#4B5563">All enquiries strictly private</div>
          </div>
          <div style="background:#fff;padding:1.75rem;border-radius:1.25rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05);text-align:center">
            <div style="font-size:1.625rem;font-weight:700;color:#111827;margin-bottom:.375rem">3 slots</div>
            <div style="font-size:.875rem;color:#4B5563">Q3 2026 engagement capacity</div>
          </div>
        </div>
      </section>

    </div>
  </main>

  <!-- Footer -->
  <footer style="background:#fff;border-top:1px solid #E5E7EB;padding:3rem 1.5rem;font-family:'Inter',sans-serif">
    <div style="max-width:1280px;margin-inline:auto;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1.5rem">
      <div style="display:flex;align-items:center;gap:.625rem">
        <div style="width:2rem;height:2rem;background:#111827;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:.6875rem;font-weight:700">EJ</div>
        <span style="font-size:.9375rem;font-weight:600;color:#111827">Edward James</span>
      </div>
      <div style="display:flex;align-items:center;gap:2rem;flex-wrap:wrap">
        <span style="font-size:.875rem;color:#6B7280">&copy; 2025 Edward James.</span>
        <div style="display:flex;gap:1rem">
          <a href="https://linkedin.com" target="_blank" rel="noopener" style="color:#6B7280;text-decoration:none" aria-label="LinkedIn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
          </a>
          <a href="https://twitter.com" target="_blank" rel="noopener" style="color:#6B7280;text-decoration:none" aria-label="Twitter">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </footer>

  <style>
    @media (max-width: 767px) {
      .pp-contact-main { grid-template-columns: 1fr !important; }
      .pp-form-row { grid-template-columns: 1fr !important; }
      .pp-commitment-grid { grid-template-columns: 1fr !important; }
    }
  </style>
</BaseLayout>
