---
import BaseLayout from '../../layouts/Base.astro';
import PPNav from '../../components/PPNav.astro';
---
<BaseLayout title="Edward James — Strategic Advisor & Board Member" theme="pp">
  <link rel="stylesheet" href="/styles/rv.css" slot="head" />
  <PPNav active="home" />
  <main style="padding-top:5rem;background:#F9FAFB;min-height:100vh;font-family:'Inter',sans-serif">

    <!-- Hero Section -->
    <section style="max-width:1280px;margin-inline:auto;padding:5rem 1.5rem 4rem;display:flex;flex-direction:column;gap:5rem">
      <div style="display:flex;flex-direction:column;align-items:flex-start;gap:2rem">

        <!-- Available badge -->
        <div style="display:inline-flex;align-items:center;gap:.5rem;padding:.5rem 1rem;background:#fff;border:1px solid #E5E7EB;border-radius:9999px;font-size:.75rem;font-weight:600;color:#4B5563;text-transform:uppercase;letter-spacing:.06em;box-shadow:0 4px 20px rgba(0,0,0,.05)">
          <span style="width:.5rem;height:.5rem;border-radius:50%;background:#22C55E;display:inline-block"></span>
          Available for Consulting
        </div>

        <!-- Hero layout -->
        <div class="pp-hero-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:center;width:100%">
          <div style="display:flex;flex-direction:column;gap:2rem">
            <h1 style="font-size:clamp(2.5rem,5vw,4.5rem);font-weight:700;line-height:1.1;color:#111827;letter-spacing:-.03em;margin:0">
              Edward James.
              <span style="display:block;color:#9CA3AF;margin-top:.375rem">Strategic Advisor &amp; Board Member.</span>
            </h1>
            <p style="font-size:1.125rem;color:#4B5563;line-height:1.7;max-width:34rem;margin:0">
              I guide executive teams through complex market transitions and scale enterprise operations. With over two decades of experience advising Fortune 500 companies, I deliver clarity where there is chaos.
            </p>
            <div style="display:flex;gap:1rem;flex-wrap:wrap">
              <a href="/pp/portfolio/" style="display:inline-flex;align-items:center;gap:.5rem;padding:1rem 2rem;background:#111827;color:#fff;border-radius:9999px;font-size:.9375rem;font-weight:500;text-decoration:none;transition:background .2s ease">
                View Portfolio
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
              </a>
              <a href="/pp/contact/" style="display:inline-flex;align-items:center;gap:.5rem;padding:1rem 2rem;background:#F3F4F6;color:#111827;border-radius:9999px;font-size:.9375rem;font-weight:500;text-decoration:none;transition:background .2s ease">
                Get in Touch
              </a>
            </div>
          </div>

          <!-- Hero image -->
          <div style="position:relative">
            <div style="width:100%;aspect-ratio:4/5;border-radius:2rem;overflow:hidden;box-shadow:0 25px 60px -15px rgba(0,0,0,.2);position:relative;background:#F3F4F6">
              <img src="https://images.pexels.com/photos/3184292/pexels-photo-3184292.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Edward James, Strategic Advisor" style="width:100%;height:100%;object-fit:cover" />
              <!-- Floating badge -->
              <div style="position:absolute;bottom:1.5rem;left:1.5rem;right:1.5rem;background:rgba(255,255,255,.92);backdrop-filter:blur(12px);padding:1.25rem 1.5rem;border-radius:1.25rem;border:1px solid rgba(255,255,255,.3);display:flex;align-items:center;gap:1rem">
                <div style="width:2.5rem;height:2.5rem;background:rgba(79,70,229,.1);border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#4F46E5" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
                </div>
                <div>
                  <p style="font-size:.6875rem;color:#6B7280;font-weight:600;text-transform:uppercase;letter-spacing:.06em;margin:0">Current Role</p>
                  <p style="font-size:.875rem;font-weight:700;color:#111827;margin:.125rem 0 0">Senior Partner, Nexus Group</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Stats -->
      <div class="pp-stats-grid" style="display:grid;grid-template-columns:repeat(4,1fr);gap:1.5rem">
        <div style="background:#fff;padding:2rem;border-radius:1.5rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05);text-align:center">
          <div style="font-size:2.5rem;font-weight:700;color:#111827;line-height:1">20+</div>
          <div style="font-size:.75rem;color:#4B5563;font-weight:600;text-transform:uppercase;letter-spacing:.06em;margin-top:.5rem">Years Experience</div>
        </div>
        <div style="background:#fff;padding:2rem;border-radius:1.5rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05);text-align:center">
          <div style="font-size:2.5rem;font-weight:700;color:#111827;line-height:1">200+</div>
          <div style="font-size:.75rem;color:#4B5563;font-weight:600;text-transform:uppercase;letter-spacing:.06em;margin-top:.5rem">Engagements</div>
        </div>
        <div style="background:#fff;padding:2rem;border-radius:1.5rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05);text-align:center">
          <div style="font-size:2.5rem;font-weight:700;color:#111827;line-height:1">$50B+</div>
          <div style="font-size:.75rem;color:#4B5563;font-weight:600;text-transform:uppercase;letter-spacing:.06em;margin-top:.5rem">Client Value</div>
        </div>
        <div style="background:#fff;padding:2rem;border-radius:1.5rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05);text-align:center">
          <div style="font-size:2.5rem;font-weight:700;color:#111827;line-height:1">12</div>
          <div style="font-size:.75rem;color:#4B5563;font-weight:600;text-transform:uppercase;letter-spacing:.06em;margin-top:.5rem">Board Seats</div>
        </div>
      </div>

      <!-- Featured Case Studies -->
      <div style="display:flex;flex-direction:column;gap:2.5rem">
        <div style="display:flex;align-items:flex-end;justify-content:space-between">
          <div>
            <h2 style="font-size:1.875rem;font-weight:700;color:#111827;letter-spacing:-.025em;margin:0 0 .75rem">Featured Engagements</h2>
            <p style="font-size:1.0625rem;color:#4B5563;margin:0">Selected case studies demonstrating strategic execution and outcome delivery.</p>
          </div>
          <a href="/pp/portfolio/" style="display:inline-flex;align-items:center;gap:.375rem;font-size:.875rem;font-weight:600;color:#111827;text-decoration:none">
            View All
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
        </div>
        <div class="pp-case-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:2rem">
          <div style="display:flex;flex-direction:column;gap:1.25rem">
            <div style="width:100%;aspect-ratio:16/10;border-radius:1.5rem;overflow:hidden;background:#F3F4F6;position:relative;box-shadow:0 4px 20px rgba(0,0,0,.05)">
              <img src="https://images.pexels.com/photos/3184360/pexels-photo-3184360.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Global Bank Restructuring" style="width:100%;height:100%;object-fit:cover" />
              <div style="position:absolute;top:1rem;left:1rem;padding:.375rem .875rem;background:rgba(255,255,255,.92);backdrop-filter:blur(8px);border-radius:9999px;font-size:.75rem;font-weight:700;color:#111827">Financial Services</div>
            </div>
            <div>
              <h3 style="font-size:1.375rem;font-weight:700;color:#111827;margin:0 0 .5rem;letter-spacing:-.015em">Global Bank Restructuring</h3>
              <p style="font-size:.9375rem;color:#4B5563;line-height:1.6;margin:0">Led the post-merger integration of two Tier-1 financial institutions, resulting in $400M annual operational synergies and full compliance delivery.</p>
            </div>
          </div>
          <div style="display:flex;flex-direction:column;gap:1.25rem">
            <div style="width:100%;aspect-ratio:16/10;border-radius:1.5rem;overflow:hidden;background:#F3F4F6;position:relative;box-shadow:0 4px 20px rgba(0,0,0,.05)">
              <img src="https://images.pexels.com/photos/3183150/pexels-photo-3183150.jpeg?auto=compress&cs=tinysrgb&w=800" alt="SaaS Scale-up Strategy" style="width:100%;height:100%;object-fit:cover" />
              <div style="position:absolute;top:1rem;left:1rem;padding:.375rem .875rem;background:rgba(255,255,255,.92);backdrop-filter:blur(8px);border-radius:9999px;font-size:.75rem;font-weight:700;color:#111827">Technology</div>
            </div>
            <div>
              <h3 style="font-size:1.375rem;font-weight:700;color:#111827;margin:0 0 .5rem;letter-spacing:-.015em">SaaS Scale-up Strategy</h3>
              <p style="font-size:.9375rem;color:#4B5563;line-height:1.6;margin:0">Developed the European market entry strategy for a Series C enterprise software company, achieving 300% YoY growth within 24 months of launch.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Services Overview -->
      <div style="display:flex;flex-direction:column;gap:2.5rem">
        <div>
          <h2 style="font-size:1.875rem;font-weight:700;color:#111827;letter-spacing:-.025em;margin:0 0 .75rem">Core Expertise</h2>
          <p style="font-size:1.0625rem;color:#4B5563;margin:0">Specialized domains where I deliver measurable impact for organizations operating at scale.</p>
        </div>
        <div class="pp-services-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem">
          <div style="background:#fff;padding:2rem;border-radius:1.5rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05)">
            <div style="width:3rem;height:3rem;background:#F3F4F6;border-radius:.75rem;display:flex;align-items:center;justify-content:center;margin-bottom:1.25rem">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            </div>
            <h3 style="font-size:1.125rem;font-weight:700;color:#111827;margin:0 0 .75rem">Strategic Scaling</h3>
            <p style="font-size:.9rem;color:#4B5563;line-height:1.65;margin:0">Developing and executing comprehensive growth frameworks for mid-to-large cap enterprises entering new markets and navigating transitions.</p>
          </div>
          <div style="background:#fff;padding:2rem;border-radius:1.5rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05)">
            <div style="width:3rem;height:3rem;background:#F3F4F6;border-radius:.75rem;display:flex;align-items:center;justify-content:center;margin-bottom:1.25rem">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/></svg>
            </div>
            <h3 style="font-size:1.125rem;font-weight:700;color:#111827;margin:0 0 .75rem">Organizational Restructuring</h3>
            <p style="font-size:.9rem;color:#4B5563;line-height:1.65;margin:0">Optimizing executive leadership teams and operational hierarchies to maximize efficiency and create durable shareholder value.</p>
          </div>
          <div style="background:#fff;padding:2rem;border-radius:1.5rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05)">
            <div style="width:3rem;height:3rem;background:#F3F4F6;border-radius:.75rem;display:flex;align-items:center;justify-content:center;margin-bottom:1.25rem">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <h3 style="font-size:1.125rem;font-weight:700;color:#111827;margin:0 0 .75rem">M&amp;A Advisory</h3>
            <p style="font-size:.9rem;color:#4B5563;line-height:1.65;margin:0">End-to-end guidance through complex mergers and acquisitions, from due diligence and negotiation to post-merger integration.</p>
          </div>
        </div>
      </div>

      <!-- Recent Insights -->
      <div style="display:flex;flex-direction:column;gap:2.5rem">
        <div style="display:flex;align-items:flex-end;justify-content:space-between">
          <div>
            <h2 style="font-size:1.875rem;font-weight:700;color:#111827;letter-spacing:-.025em;margin:0 0 .75rem">Recent Insights</h2>
            <p style="font-size:1.0625rem;color:#4B5563;margin:0">Perspectives on strategy, leadership, and organizational transformation.</p>
          </div>
          <a href="/pp/blog/" style="display:inline-flex;align-items:center;gap:.375rem;font-size:.875rem;font-weight:600;color:#111827;text-decoration:none">
            All Insights
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
        </div>
        <div class="pp-insights-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem">
          <a href="/pp/blog/" style="text-decoration:none;background:#fff;border-radius:1.5rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05);overflow:hidden;display:flex;flex-direction:column">
            <div style="width:100%;aspect-ratio:16/9;overflow:hidden;background:#F3F4F6">
              <img src="https://images.pexels.com/photos/3183197/pexels-photo-3183197.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Board Composition" style="width:100%;height:100%;object-fit:cover" />
            </div>
            <div style="padding:1.5rem">
              <span style="font-size:.75rem;color:#4F46E5;font-weight:600;text-transform:uppercase;letter-spacing:.06em">Governance</span>
              <h3 style="font-size:1rem;font-weight:700;color:#111827;margin:.5rem 0 .625rem;line-height:1.4">The Board Composition Problem: Why Skill Gaps Still Persist</h3>
              <p style="font-size:.875rem;color:#4B5563;line-height:1.6;margin:0">Most boards still recruit for credentialing rather than competency...</p>
            </div>
          </a>
          <a href="/pp/blog/" style="text-decoration:none;background:#fff;border-radius:1.5rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05);overflow:hidden;display:flex;flex-direction:column">
            <div style="width:100%;aspect-ratio:16/9;overflow:hidden;background:#F3F4F6">
              <img src="https://images.pexels.com/photos/3184291/pexels-photo-3184291.jpeg?auto=compress&cs=tinysrgb&w=800" alt="M&A Integration" style="width:100%;height:100%;object-fit:cover" />
            </div>
            <div style="padding:1.5rem">
              <span style="font-size:.75rem;color:#4F46E5;font-weight:600;text-transform:uppercase;letter-spacing:.06em">M&amp;A</span>
              <h3 style="font-size:1rem;font-weight:700;color:#111827;margin:.5rem 0 .625rem;line-height:1.4">Why 70% of Mergers Underperform Their Stated Synergy Targets</h3>
              <p style="font-size:.875rem;color:#4B5563;line-height:1.6;margin:0">The integration gap is cultural before it is operational...</p>
            </div>
          </a>
          <a href="/pp/blog/" style="text-decoration:none;background:#fff;border-radius:1.5rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05);overflow:hidden;display:flex;flex-direction:column">
            <div style="width:100%;aspect-ratio:16/9;overflow:hidden;background:#F3F4F6">
              <img src="https://images.pexels.com/photos/1181677/pexels-photo-1181677.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Digital Transformation" style="width:100%;height:100%;object-fit:cover" />
            </div>
            <div style="padding:1.5rem">
              <span style="font-size:.75rem;color:#4F46E5;font-weight:600;text-transform:uppercase;letter-spacing:.06em">Strategy</span>
              <h3 style="font-size:1rem;font-weight:700;color:#111827;margin:.5rem 0 .625rem;line-height:1.4">Digital Transformation Without a Strategic Anchor Is Just Spending</h3>
              <p style="font-size:.875rem;color:#4B5563;line-height:1.6;margin:0">Technology investments fail when they precede clear strategic intent...</p>
            </div>
          </a>
        </div>
      </div>

      <!-- CTA Banner -->
      <div style="background:#111827;border-radius:2rem;padding:4rem 3rem;text-align:center;position:relative;overflow:hidden;box-shadow:0 25px 60px -15px rgba(0,0,0,.3)">
        <div style="position:absolute;top:-5rem;right:-5rem;width:20rem;height:20rem;background:rgba(255,255,255,.04);border-radius:50%;pointer-events:none"></div>
        <div style="position:absolute;bottom:-5rem;left:-5rem;width:16rem;height:16rem;background:rgba(79,70,229,.15);border-radius:50%;pointer-events:none"></div>
        <div style="position:relative;z-index:1;max-width:42rem;margin-inline:auto">
          <h2 style="font-size:2.25rem;font-weight:700;color:#fff;letter-spacing:-.025em;line-height:1.2;margin:0 0 1.25rem">Ready to elevate your organization's trajectory?</h2>
          <p style="font-size:1.0625rem;color:#9CA3AF;line-height:1.65;margin:0 0 2.5rem">I am currently accepting select advisory roles and board positions for Q3 2026. Let's discuss how we can align strategy with execution.</p>
          <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap">
            <a href="/pp/contact/" style="display:inline-block;padding:1rem 2rem;background:#fff;color:#111827;border-radius:9999px;font-size:.9375rem;font-weight:700;text-decoration:none">Schedule a Consultation</a>
            <a href="https://linkedin.com" target="_blank" rel="noopener" style="display:inline-block;padding:1rem 2rem;background:rgba(255,255,255,.1);color:#fff;border-radius:9999px;font-size:.9375rem;font-weight:500;text-decoration:none;border:1px solid rgba(255,255,255,.15)">Connect on LinkedIn</a>
          </div>
        </div>
      </div>
    </section>

  </main>

  <!-- Footer -->
  <footer style="background:#fff;border-top:1px solid #E5E7EB;padding:3rem 1.5rem;font-family:'Inter',sans-serif">
    <div style="max-width:1280px;margin-inline:auto;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1.5rem">
      <div style="display:flex;align-items:center;gap:.625rem">
        <div style="width:2rem;height:2rem;background:#111827;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:.6875rem;font-weight:700">EJ</div>
        <span style="font-size:.9375rem;font-weight:600;color:#111827">Edward James</span>
      </div>
      <div style="display:flex;align-items:center;gap:2rem;flex-wrap:wrap">
        <span style="font-size:.875rem;color:#6B7280">&copy; 2025 Edward James.</span>
        <div style="display:flex;gap:1rem">
          <a href="https://linkedin.com" target="_blank" rel="noopener" style="color:#6B7280;text-decoration:none" aria-label="LinkedIn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
          </a>
          <a href="https://twitter.com" target="_blank" rel="noopener" style="color:#6B7280;text-decoration:none" aria-label="Twitter">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </footer>

  <style>
    @media (max-width: 767px) {
      .pp-hero-grid { grid-template-columns: 1fr !important; }
      .pp-stats-grid { grid-template-columns: repeat(2,1fr) !important; }
      .pp-case-grid { grid-template-columns: 1fr !important; }
      .pp-services-grid { grid-template-columns: 1fr !important; }
      .pp-insights-grid { grid-template-columns: 1fr !important; }
    }
  </style>
</BaseLayout>
