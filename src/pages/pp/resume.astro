---
import BaseLayout from '../../layouts/Base.astro';
import PPNav from '../../components/PPNav.astro';
---
<BaseLayout title="Resume — Edward James" theme="pp">
  <link rel="stylesheet" href="/styles/rv.css" slot="head" />
  <PPNav active="resume" />
  <main style="padding-top:5rem;background:#F9FAFB;min-height:100vh;font-family:'Inter',sans-serif">

    <div style="max-width:960px;margin-inline:auto;padding:4rem 1.5rem;display:flex;flex-direction:column;gap:3.5rem">

      <!-- Resume Header -->
      <section>
        <div style="display:flex;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;gap:1.5rem;border-bottom:2px solid #E5E7EB;padding-bottom:2rem">
          <div>
            <h1 style="font-size:clamp(2rem,4vw,3.5rem);font-weight:700;color:#111827;letter-spacing:-.03em;margin:0 0 .375rem">Edward James</h1>
            <p style="font-size:1.125rem;font-weight:500;color:#4B5563;margin:0">Executive Strategy &amp; Operations Consultant</p>
          </div>
          <a href="#" style="display:inline-flex;align-items:center;gap:.5rem;padding:.75rem 1.5rem;background:#111827;color:#fff;border-radius:9999px;font-size:.875rem;font-weight:600;text-decoration:none">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            Download PDF Resume
          </a>
        </div>
        <div style="max-width:44rem;padding-top:1.75rem">
          <p style="font-size:1rem;color:#4B5563;line-height:1.8;margin:0">A seasoned executive advisor with over 20 years of experience orchestrating enterprise-wide transformations, leading high-stakes M&amp;A integrations, and advising boards on structural resilience. Proven track record of aligning disparate corporate cultures, mitigating multi-billion dollar risk portfolios, and driving sustainable operational scaling across global financial and technology sectors.</p>
        </div>
      </section>

      <!-- Professional Experience -->
      <section>
        <h2 style="font-size:1.5rem;font-weight:700;color:#111827;border-bottom:1px solid #E5E7EB;padding-bottom:1rem;margin:0 0 2.5rem;letter-spacing:-.02em">Professional Experience</h2>
        <div style="display:flex;flex-direction:column;gap:3rem">

          <div class="pp-exp-row" style="display:grid;grid-template-columns:1fr 3fr;gap:2rem">
            <div>
              <div style="font-size:.8125rem;font-weight:700;color:#111827;text-transform:uppercase;letter-spacing:.06em">2016 — Present</div>
              <div style="font-size:.875rem;color:#4B5563;margin-top:.25rem">London / Global</div>
            </div>
            <div>
              <h3 style="font-size:1.25rem;font-weight:700;color:#111827;margin:0 0 .25rem">Founder &amp; Principal Partner</h3>
              <div style="font-size:1rem;font-weight:500;color:#4B5563;margin-bottom:1rem">Nexus Group Advisory</div>
              <p style="font-size:.9375rem;color:#4B5563;line-height:1.7;margin:0 0 1.25rem">Established and lead a boutique advisory firm providing unfiltered, high-stakes strategic counsel exclusively to C-suite executives and corporate boards navigating critical transitions.</p>
              <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:.75rem">
                <li style="display:flex;align-items:flex-start;gap:.75rem;font-size:.9375rem;color:#4B5563;line-height:1.65">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#4F46E5" stroke-width="2.5" style="flex-shrink:0;margin-top:3px"><polyline points="9 18 15 12 9 6"/></svg>
                  Directed the post-merger integration strategy for a €12B European logistics conglomerate, achieving full operational synergy 4 months ahead of schedule.
                </li>
                <li style="display:flex;align-items:flex-start;gap:.75rem;font-size:.9375rem;color:#4B5563;line-height:1.65">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#4F46E5" stroke-width="2.5" style="flex-shrink:0;margin-top:3px"><polyline points="9 18 15 12 9 6"/></svg>
                  Developed and implemented 'The Resilience Protocol', a proprietary risk management framework adopted by 50+ Fortune 500 companies.
                </li>
                <li style="display:flex;align-items:flex-start;gap:.75rem;font-size:.9375rem;color:#4B5563;line-height:1.65">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#4F46E5" stroke-width="2.5" style="flex-shrink:0;margin-top:3px"><polyline points="9 18 15 12 9 6"/></svg>
                  Currently serve as an Independent Board Director for three publicly traded companies (FinTech and Enterprise SaaS), providing governance and strategic oversight.
                </li>
              </ul>
            </div>
          </div>

          <div class="pp-exp-row" style="display:grid;grid-template-columns:1fr 3fr;gap:2rem">
            <div>
              <div style="font-size:.8125rem;font-weight:700;color:#111827;text-transform:uppercase;letter-spacing:.06em">2006 — 2015</div>
              <div style="font-size:.875rem;color:#4B5563;margin-top:.25rem">New York / London</div>
            </div>
            <div>
              <h3 style="font-size:1.25rem;font-weight:700;color:#111827;margin:0 0 .25rem">Managing Director, M&amp;A Integration</h3>
              <div style="font-size:1rem;font-weight:500;color:#4B5563;margin-bottom:1rem">Global Strategy Partners</div>
              <p style="font-size:.9375rem;color:#4B5563;line-height:1.7;margin:0 0 1.25rem">Led the global M&amp;A integration practice, building a team of 140 consultants and overseeing the end-to-end integration lifecycle for the firm's largest enterprise clients.</p>
              <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:.75rem">
                <li style="display:flex;align-items:flex-start;gap:.75rem;font-size:.9375rem;color:#4B5563;line-height:1.65">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#4F46E5" stroke-width="2.5" style="flex-shrink:0;margin-top:3px"><polyline points="9 18 15 12 9 6"/></svg>
                  Oversaw the post-merger integration of over $40B in assets across 15 major transactions in financial services and technology.
                </li>
                <li style="display:flex;align-items:flex-start;gap:.75rem;font-size:.9375rem;color:#4B5563;line-height:1.65">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#4F46E5" stroke-width="2.5" style="flex-shrink:0;margin-top:3px"><polyline points="9 18 15 12 9 6"/></svg>
                  Authored the firm's standardized playbook for cultural integration, reducing post-merger key talent attrition by an average of 22%.
                </li>
                <li style="display:flex;align-items:flex-start;gap:.75rem;font-size:.9375rem;color:#4B5563;line-height:1.65">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#4F46E5" stroke-width="2.5" style="flex-shrink:0;margin-top:3px"><polyline points="9 18 15 12 9 6"/></svg>
                  Grew practice revenue from $15M to $85M over 5 years, establishing the group as the highest-margin division globally.
                </li>
              </ul>
            </div>
          </div>

          <div class="pp-exp-row" style="display:grid;grid-template-columns:1fr 3fr;gap:2rem">
            <div>
              <div style="font-size:.8125rem;font-weight:700;color:#111827;text-transform:uppercase;letter-spacing:.06em">1998 — 2005</div>
              <div style="font-size:.875rem;color:#4B5563;margin-top:.25rem">London</div>
            </div>
            <div>
              <h3 style="font-size:1.25rem;font-weight:700;color:#111827;margin:0 0 .25rem">Director, Structural Risk</h3>
              <div style="font-size:1rem;font-weight:500;color:#4B5563;margin-bottom:1rem">Atlas Investment Bank</div>
              <p style="font-size:.9375rem;color:#4B5563;line-height:1.7;margin:0 0 1.25rem">Progressed from quantitative risk analysis to advising the executive committee on enterprise-wide structural resilience and operational fault lines.</p>
              <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:.75rem">
                <li style="display:flex;align-items:flex-start;gap:.75rem;font-size:.9375rem;color:#4B5563;line-height:1.65">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#4F46E5" stroke-width="2.5" style="flex-shrink:0;margin-top:3px"><polyline points="9 18 15 12 9 6"/></svg>
                  Designed an early-warning risk system that mitigated $1.2B in exposure during the 2001 market contraction.
                </li>
                <li style="display:flex;align-items:flex-start;gap:.75rem;font-size:.9375rem;color:#4B5563;line-height:1.65">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#4F46E5" stroke-width="2.5" style="flex-shrink:0;margin-top:3px"><polyline points="9 18 15 12 9 6"/></svg>
                  Led cross-functional task force to restructure the global equities division, improving operational efficiency by 18%.
                </li>
              </ul>
            </div>
          </div>

        </div>
      </section>

      <!-- Education & Skills -->
      <div class="pp-resume-2col" style="display:grid;grid-template-columns:1fr 1fr;gap:3rem">

        <section>
          <h2 style="font-size:1.5rem;font-weight:700;color:#111827;border-bottom:1px solid #E5E7EB;padding-bottom:1rem;margin:0 0 2rem;letter-spacing:-.02em">Education</h2>
          <div style="display:flex;flex-direction:column;gap:2rem">
            <div>
              <h3 style="font-size:1.0625rem;font-weight:700;color:#111827;margin:0 0 .25rem">Master of Business Administration (MBA)</h3>
              <div style="font-size:.9375rem;font-weight:500;color:#4B5563">London Business School</div>
              <div style="font-size:.8125rem;color:#6B7280;margin:.25rem 0 .625rem">1996 – 1998</div>
              <p style="font-size:.875rem;color:#4B5563;margin:0">Specialization in Corporate Strategy and Organizational Behavior. Graduated with Distinction.</p>
            </div>
            <div>
              <h3 style="font-size:1.0625rem;font-weight:700;color:#111827;margin:0 0 .25rem">Bachelor of Science in Economics</h3>
              <div style="font-size:.9375rem;font-weight:500;color:#4B5563">London School of Economics (LSE)</div>
              <div style="font-size:.8125rem;color:#6B7280;margin:.25rem 0 .625rem">1992 – 1995</div>
              <p style="font-size:.875rem;color:#4B5563;margin:0">First Class Honours.</p>
            </div>
          </div>
        </section>

        <section>
          <h2 style="font-size:1.5rem;font-weight:700;color:#111827;border-bottom:1px solid #E5E7EB;padding-bottom:1rem;margin:0 0 2rem;letter-spacing:-.02em">Core Competencies</h2>
          <div style="display:flex;flex-direction:column;gap:1.5rem">
            <div>
              <div style="font-size:.6875rem;font-weight:700;color:#111827;text-transform:uppercase;letter-spacing:.08em;margin-bottom:.75rem">Strategic Advisory</div>
              <div style="display:flex;flex-wrap:wrap;gap:.5rem">
                <span style="padding:.375rem .875rem;background:#F3F4F6;color:#111827;border-radius:9999px;font-size:.8125rem;font-weight:500;border:1px solid #E5E7EB">Board Governance</span>
                <span style="padding:.375rem .875rem;background:#F3F4F6;color:#111827;border-radius:9999px;font-size:.8125rem;font-weight:500;border:1px solid #E5E7EB">M&amp;A Integration</span>
                <span style="padding:.375rem .875rem;background:#F3F4F6;color:#111827;border-radius:9999px;font-size:.8125rem;font-weight:500;border:1px solid #E5E7EB">Enterprise Restructuring</span>
                <span style="padding:.375rem .875rem;background:#F3F4F6;color:#111827;border-radius:9999px;font-size:.8125rem;font-weight:500;border:1px solid #E5E7EB">Digital Transformation</span>
              </div>
            </div>
            <div>
              <div style="font-size:.6875rem;font-weight:700;color:#111827;text-transform:uppercase;letter-spacing:.08em;margin-bottom:.75rem">Operational Execution</div>
              <div style="display:flex;flex-wrap:wrap;gap:.5rem">
                <span style="padding:.375rem .875rem;background:#F3F4F6;color:#111827;border-radius:9999px;font-size:.8125rem;font-weight:500;border:1px solid #E5E7EB">Risk Mitigation</span>
                <span style="padding:.375rem .875rem;background:#F3F4F6;color:#111827;border-radius:9999px;font-size:.8125rem;font-weight:500;border:1px solid #E5E7EB">Cultural Alignment</span>
                <span style="padding:.375rem .875rem;background:#F3F4F6;color:#111827;border-radius:9999px;font-size:.8125rem;font-weight:500;border:1px solid #E5E7EB">Change Management</span>
                <span style="padding:.375rem .875rem;background:#F3F4F6;color:#111827;border-radius:9999px;font-size:.8125rem;font-weight:500;border:1px solid #E5E7EB">Executive Coaching</span>
              </div>
            </div>
          </div>
        </section>

      </div>

      <!-- Certifications & Community -->
      <div class="pp-resume-2col" style="display:grid;grid-template-columns:1fr 1fr;gap:3rem">

        <section>
          <h2 style="font-size:1.5rem;font-weight:700;color:#111827;border-bottom:1px solid #E5E7EB;padding-bottom:1rem;margin:0 0 2rem;letter-spacing:-.02em">Certifications</h2>
          <div style="display:flex;flex-direction:column;gap:1.5rem">
            <div>
              <h3 style="font-size:1rem;font-weight:700;color:#111827;margin:0 0 .25rem">Certified Board Director</h3>
              <div style="font-size:.875rem;color:#4B5563">Corporate Governance Institute, 2018</div>
            </div>
            <div>
              <h3 style="font-size:1rem;font-weight:700;color:#111827;margin:0 0 .25rem">Advanced Risk Management Certification</h3>
              <div style="font-size:.875rem;color:#4B5563">Global Risk Management Association, 2012</div>
            </div>
            <div>
              <h3 style="font-size:1rem;font-weight:700;color:#111827;margin:0 0 .25rem">Executive Leadership Program</h3>
              <div style="font-size:.875rem;color:#4B5563">Harvard Business School Executive Education, 2010</div>
            </div>
          </div>
        </section>

        <section>
          <h2 style="font-size:1.5rem;font-weight:700;color:#111827;border-bottom:1px solid #E5E7EB;padding-bottom:1rem;margin:0 0 2rem;letter-spacing:-.02em">Community &amp; Philanthropy</h2>
          <div style="display:flex;flex-direction:column;gap:1.5rem">
            <div>
              <h3 style="font-size:1rem;font-weight:700;color:#111827;margin:0 0 .25rem">Board Member</h3>
              <div style="font-size:.9375rem;font-weight:500;color:#4B5563">Global Education Initiative (GEI)</div>
              <div style="font-size:.8125rem;color:#6B7280;margin:.25rem 0 .5rem">2019 — Present</div>
              <p style="font-size:.875rem;color:#4B5563;margin:0">Guiding systemic reforms in STEM education across emerging markets, focusing on strategic partnerships and fund allocation.</p>
            </div>
            <div>
              <h3 style="font-size:1rem;font-weight:700;color:#111827;margin:0 0 .25rem">Mentor</h3>
              <div style="font-size:.9375rem;font-weight:500;color:#4B5563">NextGen Executive Leaders</div>
              <div style="font-size:.8125rem;color:#6B7280;margin:.25rem 0 .5rem">2015 — Present</div>
              <p style="font-size:.875rem;color:#4B5563;margin:0">Providing pro-bono executive coaching and career strategy for high-potential leaders from underrepresented backgrounds.</p>
            </div>
          </div>
        </section>

      </div>

    </div>
  </main>

  <!-- Footer -->
  <footer style="background:#fff;border-top:1px solid #E5E7EB;padding:3rem 1.5rem;font-family:'Inter',sans-serif">
    <div style="max-width:1280px;margin-inline:auto;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1.5rem">
      <div style="display:flex;align-items:center;gap:.625rem">
        <div style="width:2rem;height:2rem;background:#111827;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:.6875rem;font-weight:700">EJ</div>
        <span style="font-size:.9375rem;font-weight:600;color:#111827">Edward James</span>
      </div>
      <div style="display:flex;align-items:center;gap:2rem;flex-wrap:wrap">
        <span style="font-size:.875rem;color:#6B7280">&copy; 2025 Edward James.</span>
        <div style="display:flex;gap:1rem">
          <a href="https://linkedin.com" target="_blank" rel="noopener" style="color:#6B7280;text-decoration:none" aria-label="LinkedIn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
          </a>
          <a href="https://twitter.com" target="_blank" rel="noopener" style="color:#6B7280;text-decoration:none" aria-label="Twitter">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </footer>

  <style>
    @media (max-width: 767px) {
      .pp-resume-2col { grid-template-columns: 1fr !important; }
      .pp-exp-row { grid-template-columns: 1fr !important; }
    }
  </style>
</BaseLayout>
