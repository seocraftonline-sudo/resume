---
import BaseLayout from '../../layouts/Base.astro';
import PPNav from '../../components/PPNav.astro';
---
<BaseLayout title="Credibility — Edward James" theme="pp">
  <link rel="stylesheet" href="/styles/rv.css" slot="head" />
  <PPNav active="testimonials" />
  <main style="padding-top:5rem;background:#F9FAFB;min-height:100vh;font-family:'Inter',sans-serif">

    <div style="max-width:1280px;margin-inline:auto;padding:4rem 1.5rem;display:flex;flex-direction:column;gap:4.5rem">

      <!-- Header -->
      <section style="text-align:center;max-width:40rem;margin-inline:auto">
        <h1 style="font-size:clamp(2.25rem,4vw,3.25rem);font-weight:700;color:#111827;letter-spacing:-.03em;margin:0 0 1rem">Credibility</h1>
        <p style="font-size:1.0625rem;color:#4B5563;line-height:1.7;margin:0">What executives, boards, and organizations say about working with Edward James at the highest levels of corporate strategy.</p>
      </section>

      <!-- Featured CEO Quote -->
      <section style="background:#111827;border-radius:2rem;padding:4rem 3.5rem;position:relative;overflow:hidden">
        <div style="position:absolute;top:-5rem;left:-5rem;width:22rem;height:22rem;background:rgba(255,255,255,.03);border-radius:50%"></div>
        <div style="position:absolute;bottom:-4rem;right:-4rem;width:16rem;height:16rem;background:rgba(79,70,229,.1);border-radius:50%"></div>
        <div style="position:relative;z-index:1;max-width:48rem">
          <svg width="40" height="30" viewBox="0 0 40 30" fill="none" style="margin-bottom:1.5rem">
            <path d="M0 30V18C0 13.333 1.333 9.333 4 6C6.667 2.667 10.667 0.667 16 0L17.5 3.5C14.833 4.5 12.833 5.833 11.5 7.5C10.167 9.167 9.5 11 9.5 13H16V30H0ZM23 30V18C23 13.333 24.333 9.333 27 6C29.667 2.667 33.667 0.667 39 0L40.5 3.5C37.833 4.5 35.833 5.833 34.5 7.5C33.167 9.167 32.5 11 32.5 13H39.5V30H23Z" fill="rgba(255,255,255,0.15)"/>
          </svg>
          <blockquote style="font-size:1.375rem;font-weight:500;color:#fff;line-height:1.6;margin:0 0 2rem">
            Edward doesn't just advise — he transforms. When we engaged him for our post-merger integration, we were 18 months behind schedule and hemorrhaging talent. He restructured our approach entirely. The clarity, discipline, and sheer force of execution he brought was unlike anything I'd experienced from any advisor in 30 years of leading organizations. We closed the integration four months ahead of the revised schedule and retained 94% of identified key talent.
          </blockquote>
          <div style="display:flex;align-items:center;gap:1.25rem">
            <div style="width:3rem;height:3rem;border-radius:50%;background:rgba(255,255,255,.15);overflow:hidden">
              <img src="https://images.pexels.com/photos/3184292/pexels-photo-3184292.jpeg?auto=compress&cs=tinysrgb&w=800" alt="CEO Portrait" style="width:100%;height:100%;object-fit:cover" />
            </div>
            <div>
              <div style="font-size:.9375rem;font-weight:700;color:#fff">Thomas Brandt</div>
              <div style="font-size:.875rem;color:#9CA3AF">Chief Executive Officer, EuroLogix Group (formerly LogiCon &amp; Meridian Freight)</div>
            </div>
          </div>
        </div>
      </section>

      <!-- 4 Testimonial Cards -->
      <section>
        <h2 style="font-size:1.5rem;font-weight:700;color:#111827;margin:0 0 2rem;letter-spacing:-.02em">Client Testimonials</h2>
        <div class="pp-testi-grid" style="display:grid;grid-template-columns:repeat(2,1fr);gap:1.75rem">

          <div style="background:#fff;padding:2.5rem;border-radius:1.5rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05)">
            <div style="margin-bottom:1.5rem">
              <div style="display:flex;gap:.25rem;margin-bottom:1.25rem">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="#111827"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="#111827"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="#111827"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="#111827"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="#111827"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              </div>
              <blockquote style="font-size:.9375rem;color:#4B5563;line-height:1.75;margin:0;font-style:italic">"Edward's advice on our board restructuring ahead of our public market debut was invaluable. He identified governance gaps that our own legal team had missed and architected a committee structure that significantly improved our regulatory confidence. The IPO went ahead on schedule and above valuation estimates."</blockquote>
            </div>
            <div style="display:flex;align-items:center;gap:1rem;padding-top:1.25rem;border-top:1px solid #F3F4F6">
              <div style="width:2.75rem;height:2.75rem;border-radius:50%;background:#F3F4F6;overflow:hidden;flex-shrink:0">
                <img src="https://images.pexels.com/photos/3184360/pexels-photo-3184360.jpeg?auto=compress&cs=tinysrgb&w=800" alt="" style="width:100%;height:100%;object-fit:cover" />
              </div>
              <div>
                <div style="font-size:.9375rem;font-weight:700;color:#111827">Sarah Chen</div>
                <div style="font-size:.8125rem;color:#6B7280">CEO, Atlas Capital (pre-IPO FinTech, $4.2B valuation)</div>
              </div>
            </div>
          </div>

          <div style="background:#fff;padding:2.5rem;border-radius:1.5rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05)">
            <div style="margin-bottom:1.5rem">
              <div style="display:flex;gap:.25rem;margin-bottom:1.25rem">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="#111827"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="#111827"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="#111827"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="#111827"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="#111827"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              </div>
              <blockquote style="font-size:.9375rem;color:#4B5563;line-height:1.75;margin:0;font-style:italic">"I have worked with scores of advisors over 25 years of leading public companies. Edward is categorically different. He brings no agenda, no pre-packaged frameworks — just forensic analysis and direct counsel. During our operational restructuring, he told us things we needed to hear but weren't ready to hear. He was right. Every time."</blockquote>
            </div>
            <div style="display:flex;align-items:center;gap:1rem;padding-top:1.25rem;border-top:1px solid #F3F4F6">
              <div style="width:2.75rem;height:2.75rem;border-radius:50%;background:#F3F4F6;overflow:hidden;flex-shrink:0">
                <img src="https://images.pexels.com/photos/3183197/pexels-photo-3183197.jpeg?auto=compress&cs=tinysrgb&w=800" alt="" style="width:100%;height:100%;object-fit:cover" />
              </div>
              <div>
                <div style="font-size:.9375rem;font-weight:700;color:#111827">Marcus Webb</div>
                <div style="font-size:.8125rem;color:#6B7280">Chairman, EuroGrid Energy (FTSE 100)</div>
              </div>
            </div>
          </div>

          <div style="background:#fff;padding:2.5rem;border-radius:1.5rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05)">
            <div style="margin-bottom:1.5rem">
              <div style="display:flex;gap:.25rem;margin-bottom:1.25rem">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="#111827"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="#111827"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="#111827"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="#111827"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="#111827"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              </div>
              <blockquote style="font-size:.9375rem;color:#4B5563;line-height:1.75;margin:0;font-style:italic">"When we acquired Meridian Freight, we expected a 24-month integration. Within the first month of Edward's engagement, he had reframed the entire approach. His cultural alignment methodology reduced attrition during the integration to near zero. We attribute a significant portion of our subsequent growth directly to his work."</blockquote>
            </div>
            <div style="display:flex;align-items:center;gap:1rem;padding-top:1.25rem;border-top:1px solid #F3F4F6">
              <div style="width:2.75rem;height:2.75rem;border-radius:50%;background:#F3F4F6;overflow:hidden;flex-shrink:0">
                <img src="https://images.pexels.com/photos/3184291/pexels-photo-3184291.jpeg?auto=compress&cs=tinysrgb&w=800" alt="" style="width:100%;height:100%;object-fit:cover" />
              </div>
              <div>
                <div style="font-size:.9375rem;font-weight:700;color:#111827">Isabelle Fontaine</div>
                <div style="font-size:.8125rem;color:#6B7280">Group CEO, EuroLogix Group (post-acquisition)</div>
              </div>
            </div>
          </div>

          <div style="background:#fff;padding:2.5rem;border-radius:1.5rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05)">
            <div style="margin-bottom:1.5rem">
              <div style="display:flex;gap:.25rem;margin-bottom:1.25rem">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="#111827"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="#111827"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="#111827"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="#111827"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="#111827"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              </div>
              <blockquote style="font-size:.9375rem;color:#4B5563;line-height:1.75;margin:0;font-style:italic">"Edward's advisory retainer has been the best investment our board has made in five years. Having his external perspective available for major decisions — particularly around risk thresholds and executive transitions — has demonstrably improved the quality of our governance. He's the kind of advisor who changes how you think, not just what you decide."</blockquote>
            </div>
            <div style="display:flex;align-items:center;gap:1rem;padding-top:1.25rem;border-top:1px solid #F3F4F6">
              <div style="width:2.75rem;height:2.75rem;border-radius:50%;background:#F3F4F6;overflow:hidden;flex-shrink:0">
                <img src="https://images.pexels.com/photos/3184338/pexels-photo-3184338.jpeg?auto=compress&cs=tinysrgb&w=800" alt="" style="width:100%;height:100%;object-fit:cover" />
              </div>
              <div>
                <div style="font-size:.9375rem;font-weight:700;color:#111827">James Whitmore</div>
                <div style="font-size:.8125rem;color:#6B7280">Lead Independent Director, Whitmore Financial Group</div>
              </div>
            </div>
          </div>

        </div>
      </section>

      <!-- Board Endorsements -->
      <section>
        <h2 style="font-size:1.5rem;font-weight:700;color:#111827;margin:0 0 2rem;letter-spacing:-.02em">Board Endorsements</h2>
        <div class="pp-endorse-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:1.25rem">

          <div style="background:#fff;padding:1.75rem;border-radius:1.25rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05)">
            <p style="font-size:.875rem;color:#4B5563;line-height:1.7;margin:0 0 1.25rem;font-style:italic">"A rare combination of strategic acuity and genuine intellectual honesty. His analysis of our governance structure was both rigorous and practically actionable."</p>
            <div>
              <div style="font-size:.9rem;font-weight:700;color:#111827">Helena Marchetti</div>
              <div style="font-size:.8125rem;color:#6B7280">Board Chair, Meridian Health Network</div>
            </div>
          </div>

          <div style="background:#fff;padding:1.75rem;border-radius:1.25rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05)">
            <p style="font-size:.875rem;color:#4B5563;line-height:1.7;margin:0 0 1.25rem;font-style:italic">"Edward's engagement discipline is exceptional. He commits fully, delivers what he commits to, and exits cleanly. No engagement theatre, no recurring revenue padding."</p>
            <div>
              <div style="font-size:.9rem;font-weight:700;color:#111827">Prof. David Okafor</div>
              <div style="font-size:.8125rem;color:#6B7280">Non-Executive Director, Atlas Capital</div>
            </div>
          </div>

          <div style="background:#fff;padding:1.75rem;border-radius:1.25rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05)">
            <p style="font-size:.875rem;color:#4B5563;line-height:1.7;margin:0 0 1.25rem;font-style:italic">"The clearest strategic thinker I have worked with in 20 years on public company boards. He operates without ego, which is extraordinarily rare at this level."</p>
            <div>
              <div style="font-size:.9rem;font-weight:700;color:#111827">Carolyn Steele</div>
              <div style="font-size:.8125rem;color:#6B7280">Senior Independent Director, EuroGrid Energy</div>
            </div>
          </div>

        </div>
      </section>

    </div>
  </main>

  <!-- Footer -->
  <footer style="background:#fff;border-top:1px solid #E5E7EB;padding:3rem 1.5rem;font-family:'Inter',sans-serif">
    <div style="max-width:1280px;margin-inline:auto;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1.5rem">
      <div style="display:flex;align-items:center;gap:.625rem">
        <div style="width:2rem;height:2rem;background:#111827;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:.6875rem;font-weight:700">EJ</div>
        <span style="font-size:.9375rem;font-weight:600;color:#111827">Edward James</span>
      </div>
      <div style="display:flex;align-items:center;gap:2rem;flex-wrap:wrap">
        <span style="font-size:.875rem;color:#6B7280">&copy; 2025 Edward James.</span>
        <div style="display:flex;gap:1rem">
          <a href="https://linkedin.com" target="_blank" rel="noopener" style="color:#6B7280;text-decoration:none" aria-label="LinkedIn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
          </a>
          <a href="https://twitter.com" target="_blank" rel="noopener" style="color:#6B7280;text-decoration:none" aria-label="Twitter">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </footer>

  <style>
    @media (max-width: 767px) {
      .pp-testi-grid { grid-template-columns: 1fr !important; }
      .pp-endorse-grid { grid-template-columns: 1fr !important; }
    }
  </style>
</BaseLayout>
