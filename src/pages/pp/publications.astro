---
import BaseLayout from '../../layouts/Base.astro';
import PPNav from '../../components/PPNav.astro';
---
<BaseLayout title="Publications — Edward James" theme="pp">
  <link rel="stylesheet" href="/styles/rv.css" slot="head" />
  <PPNav active="publications" />
  <main style="padding-top:5rem;background:#F9FAFB;min-height:100vh;font-family:'Inter',sans-serif">

    <div style="max-width:1280px;margin-inline:auto;padding:4rem 1.5rem;display:flex;flex-direction:column;gap:4.5rem">

      <!-- Header -->
      <section>
        <h1 style="font-size:clamp(2.25rem,4vw,3.25rem);font-weight:700;color:#111827;letter-spacing:-.03em;margin:0 0 1rem">Publications &amp; Speaking</h1>
        <p style="font-size:1.0625rem;color:#4B5563;line-height:1.7;margin:0;max-width:42rem">Thought leadership on corporate governance, organizational resilience, and strategic execution — developed through decades of high-stakes advisory practice.</p>
      </section>

      <!-- Articles & Whitepapers -->
      <section>
        <h2 style="font-size:1.5rem;font-weight:700;color:#111827;border-bottom:1px solid #E5E7EB;padding-bottom:1rem;margin:0 0 2.5rem;letter-spacing:-.02em">Articles &amp; Whitepapers</h2>
        <div style="display:flex;flex-direction:column;gap:1.5rem">

          <div style="background:#fff;border-radius:1.5rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05);overflow:hidden">
            <div class="pp-pub-row" style="display:grid;grid-template-columns:280px 1fr">
              <div style="overflow:hidden;background:#F3F4F6">
                <img src="https://images.pexels.com/photos/3184360/pexels-photo-3184360.jpeg?auto=compress&cs=tinysrgb&w=800" alt="The Resilience Protocol" style="width:100%;height:100%;object-fit:cover" />
              </div>
              <div style="padding:2.5rem">
                <div style="display:flex;gap:.75rem;align-items:center;margin-bottom:1rem">
                  <span style="font-size:.75rem;font-weight:600;color:#4F46E5;background:rgba(79,70,229,.08);padding:.25rem .875rem;border-radius:9999px;text-transform:uppercase;letter-spacing:.05em">Whitepaper</span>
                  <span style="font-size:.8125rem;color:#6B7280">2021 · Harvard Business Review Press</span>
                </div>
                <h3 style="font-size:1.375rem;font-weight:700;color:#111827;margin:0 0 .875rem;line-height:1.3">"The Resilience Protocol: A Framework for Enterprise Risk Architecture"</h3>
                <p style="font-size:.9375rem;color:#4B5563;line-height:1.7;margin:0 0 1.5rem">A comprehensive framework for organizational risk management that addresses structural, cultural, and operational resilience. This whitepaper has been adopted as a standard reference by risk committees at 50+ Fortune 500 companies and is taught in three executive education programs.</p>
                <div style="display:flex;gap:1.5rem;align-items:center">
                  <a href="#" style="display:inline-flex;align-items:center;gap:.375rem;font-size:.875rem;font-weight:600;color:#111827;text-decoration:none">
                    Download PDF
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                  </a>
                  <span style="font-size:.875rem;color:#9CA3AF">12,000+ downloads</span>
                </div>
              </div>
            </div>
          </div>

          <div style="background:#fff;border-radius:1.5rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05);padding:2rem">
            <div style="display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:1.5rem">
              <div style="flex:1;min-width:260px">
                <div style="display:flex;gap:.75rem;align-items:center;margin-bottom:.75rem">
                  <span style="font-size:.75rem;font-weight:600;color:#4B5563;background:#F3F4F6;padding:.2rem .75rem;border-radius:9999px;text-transform:uppercase;letter-spacing:.05em">Article</span>
                  <span style="font-size:.8125rem;color:#6B7280">2023 · Financial Times</span>
                </div>
                <h3 style="font-size:1.125rem;font-weight:700;color:#111827;margin:0 0 .625rem">"Why 70% of M&amp;A Deals Underperform Their Synergy Targets"</h3>
                <p style="font-size:.9rem;color:#4B5563;line-height:1.65;margin:0">An evidence-based analysis of integration failure patterns across 200 deals, identifying the cultural, operational, and governance factors that predict success or failure.</p>
              </div>
              <a href="#" style="display:inline-flex;align-items:center;gap:.375rem;font-size:.875rem;font-weight:600;color:#111827;text-decoration:none;flex-shrink:0">
                Read Article
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
              </a>
            </div>
          </div>

          <div style="background:#fff;border-radius:1.5rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05);padding:2rem">
            <div style="display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:1.5rem">
              <div style="flex:1;min-width:260px">
                <div style="display:flex;gap:.75rem;align-items:center;margin-bottom:.75rem">
                  <span style="font-size:.75rem;font-weight:600;color:#4B5563;background:#F3F4F6;padding:.2rem .75rem;border-radius:9999px;text-transform:uppercase;letter-spacing:.05em">Article</span>
                  <span style="font-size:.8125rem;color:#6B7280">2024 · Harvard Business Review</span>
                </div>
                <h3 style="font-size:1.125rem;font-weight:700;color:#111827;margin:0 0 .625rem">"When Boards Need to Intervene — And How to Do It Without Triggering a Crisis"</h3>
                <p style="font-size:.9rem;color:#4B5563;line-height:1.65;margin:0">A practical guide for independent board directors on recognizing the signals of executive leadership failure and deploying structured intervention without destabilizing market confidence.</p>
              </div>
              <a href="#" style="display:inline-flex;align-items:center;gap:.375rem;font-size:.875rem;font-weight:600;color:#111827;text-decoration:none;flex-shrink:0">
                Read Article
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
              </a>
            </div>
          </div>

          <div style="background:#fff;border-radius:1.5rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05);padding:2rem">
            <div style="display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:1.5rem">
              <div style="flex:1;min-width:260px">
                <div style="display:flex;gap:.75rem;align-items:center;margin-bottom:.75rem">
                  <span style="font-size:.75rem;font-weight:600;color:#4B5563;background:#F3F4F6;padding:.2rem .75rem;border-radius:9999px;text-transform:uppercase;letter-spacing:.05em">Report</span>
                  <span style="font-size:.8125rem;color:#6B7280">2022 · McKinsey Global Institute</span>
                </div>
                <h3 style="font-size:1.125rem;font-weight:700;color:#111827;margin:0 0 .625rem">"The Board Composition Problem: Closing the Competency Gap"</h3>
                <p style="font-size:.9rem;color:#4B5563;line-height:1.65;margin:0">Contributing author to the MGI annual governance report examining board skill gaps across FTSE 500 and Fortune 500 companies, with structured remediation frameworks.</p>
              </div>
              <a href="#" style="display:inline-flex;align-items:center;gap:.375rem;font-size:.875rem;font-weight:600;color:#111827;text-decoration:none;flex-shrink:0">
                View Report
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
              </a>
            </div>
          </div>

        </div>
      </section>

      <!-- Speaking History -->
      <section>
        <h2 style="font-size:1.5rem;font-weight:700;color:#111827;border-bottom:1px solid #E5E7EB;padding-bottom:1rem;margin:0 0 2.5rem;letter-spacing:-.02em">Speaking History</h2>
        <div class="pp-speaking-grid" style="display:grid;grid-template-columns:repeat(2,1fr);gap:1.25rem">

          <div style="background:#fff;padding:1.75rem;border-radius:1.25rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05)">
            <div style="font-size:.75rem;color:#6B7280;font-weight:600;margin-bottom:.75rem">January 2024 · Davos, Switzerland</div>
            <h3 style="font-size:1rem;font-weight:700;color:#111827;margin:0 0 .375rem">World Economic Forum Annual Meeting</h3>
            <p style="font-size:.875rem;color:#4B5563;margin:0">Plenary keynote on "Rebuilding Trust in Corporate Institutions: From Governance Reform to Cultural Change."</p>
          </div>

          <div style="background:#fff;padding:1.75rem;border-radius:1.25rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05)">
            <div style="font-size:.75rem;color:#6B7280;font-weight:600;margin-bottom:.75rem">October 2023 · London</div>
            <h3 style="font-size:1rem;font-weight:700;color:#111827;margin:0 0 .375rem">Confederation of British Industry Annual Conference</h3>
            <p style="font-size:.875rem;color:#4B5563;margin:0">Keynote address on enterprise resilience strategies and the role of independent boards in navigating systemic economic disruption.</p>
          </div>

          <div style="background:#fff;padding:1.75rem;border-radius:1.25rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05)">
            <div style="font-size:.75rem;color:#6B7280;font-weight:600;margin-bottom:.75rem">March 2023 · New York</div>
            <h3 style="font-size:1rem;font-weight:700;color:#111827;margin:0 0 .375rem">Harvard Business School Executive Education</h3>
            <p style="font-size:.875rem;color:#4B5563;margin:0">Guest lecturer on M&amp;A integration best practices for the Advanced Management Program cohort.</p>
          </div>

          <div style="background:#fff;padding:1.75rem;border-radius:1.25rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05)">
            <div style="font-size:.75rem;color:#6B7280;font-weight:600;margin-bottom:.75rem">September 2022 · Frankfurt</div>
            <h3 style="font-size:1rem;font-weight:700;color:#111827;margin:0 0 .375rem">European Business Forum</h3>
            <p style="font-size:.875rem;color:#4B5563;margin:0">Panel moderator and keynote speaker on post-pandemic corporate restructuring and the evolving role of corporate boards in digital transformation.</p>
          </div>

        </div>
      </section>

      <!-- Awards -->
      <section>
        <h2 style="font-size:1.5rem;font-weight:700;color:#111827;border-bottom:1px solid #E5E7EB;padding-bottom:1rem;margin:0 0 2.5rem;letter-spacing:-.02em">Awards &amp; Recognition</h2>
        <div class="pp-awards-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:1.25rem">

          <div style="background:#fff;padding:2rem;border-radius:1.25rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05);text-align:center">
            <div style="font-size:2.5rem;font-weight:700;color:#111827;margin-bottom:.5rem">2024</div>
            <h3 style="font-size:1rem;font-weight:700;color:#111827;margin:0 0 .375rem">Top 50 Business Advisors</h3>
            <p style="font-size:.875rem;color:#4B5563;margin:0">Financial Times Global Advisory Rankings</p>
          </div>

          <div style="background:#fff;padding:2rem;border-radius:1.25rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05);text-align:center">
            <div style="font-size:2.5rem;font-weight:700;color:#111827;margin-bottom:.5rem">2022</div>
            <h3 style="font-size:1rem;font-weight:700;color:#111827;margin:0 0 .375rem">Excellence in M&amp;A Advisory</h3>
            <p style="font-size:.875rem;color:#4B5563;margin:0">Global M&amp;A Network Awards</p>
          </div>

          <div style="background:#fff;padding:2rem;border-radius:1.25rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05);text-align:center">
            <div style="font-size:2.5rem;font-weight:700;color:#111827;margin-bottom:.5rem">2021</div>
            <h3 style="font-size:1rem;font-weight:700;color:#111827;margin:0 0 .375rem">Board Director of the Year</h3>
            <p style="font-size:.875rem;color:#4B5563;margin:0">Corporate Governance Institute UK</p>
          </div>

        </div>
      </section>

    </div>
  </main>

  <!-- Footer -->
  <footer style="background:#fff;border-top:1px solid #E5E7EB;padding:3rem 1.5rem;font-family:'Inter',sans-serif">
    <div style="max-width:1280px;margin-inline:auto;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1.5rem">
      <div style="display:flex;align-items:center;gap:.625rem">
        <div style="width:2rem;height:2rem;background:#111827;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:.6875rem;font-weight:700">EJ</div>
        <span style="font-size:.9375rem;font-weight:600;color:#111827">Edward James</span>
      </div>
      <div style="display:flex;align-items:center;gap:2rem;flex-wrap:wrap">
        <span style="font-size:.875rem;color:#6B7280">&copy; 2025 Edward James.</span>
        <div style="display:flex;gap:1rem">
          <a href="https://linkedin.com" target="_blank" rel="noopener" style="color:#6B7280;text-decoration:none" aria-label="LinkedIn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
          </a>
          <a href="https://twitter.com" target="_blank" rel="noopener" style="color:#6B7280;text-decoration:none" aria-label="Twitter">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </footer>

  <style>
    @media (max-width: 767px) {
      .pp-pub-row { grid-template-columns: 1fr !important; }
      .pp-speaking-grid { grid-template-columns: 1fr !important; }
      .pp-awards-grid { grid-template-columns: 1fr !important; }
    }
    @media (min-width: 768px) and (max-width: 1023px) {
      .pp-awards-grid { grid-template-columns: repeat(2,1fr) !important; }
    }
  </style>
</BaseLayout>
