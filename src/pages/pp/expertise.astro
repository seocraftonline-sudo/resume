---
import BaseLayout from '../../layouts/Base.astro';
import PPNav from '../../components/PPNav.astro';
---
<BaseLayout title="Expertise — Edward James" theme="pp">
  <link rel="stylesheet" href="/styles/rv.css" slot="head" />
  <PPNav active="expertise" />
  <main style="padding-top:5rem;background:#F9FAFB;min-height:100vh;font-family:'Inter',sans-serif">

    <div style="max-width:1280px;margin-inline:auto;padding:4rem 1.5rem;display:flex;flex-direction:column;gap:4.5rem">

      <!-- Header -->
      <section style="text-align:center;max-width:48rem;margin-inline:auto">
        <h1 style="font-size:clamp(2.25rem,4vw,3.25rem);font-weight:700;color:#111827;letter-spacing:-.03em;margin:0 0 1.25rem">Depth of Expertise</h1>
        <p style="font-size:1.0625rem;color:#4B5563;line-height:1.7;margin:0">Two decades of compounding specialization across corporate strategy, M&amp;A, operations, and governance — each discipline reinforcing the others.</p>
      </section>

      <!-- Core Competency Areas -->
      <section>
        <h2 style="font-size:1.625rem;font-weight:700;color:#111827;margin:0 0 2rem;letter-spacing:-.02em">Core Competency Areas</h2>
        <div class="pp-exp-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem">

          <div style="background:#fff;padding:2.5rem;border-radius:1.5rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05)">
            <div style="width:3.5rem;height:3.5rem;background:#111827;border-radius:.875rem;display:flex;align-items:center;justify-content:center;margin-bottom:1.5rem">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <h3 style="font-size:1.125rem;font-weight:700;color:#111827;margin:0 0 .875rem">M&amp;A Advisory</h3>
            <p style="font-size:.9rem;color:#4B5563;line-height:1.7;margin:0 0 1.25rem">End-to-end guidance from pre-deal structural assessment through post-merger integration. I have overseen $50B+ in transaction value across 15 major deals spanning financial services, technology, and industrials.</p>
            <div style="display:flex;flex-wrap:wrap;gap:.5rem">
              <span style="font-size:.75rem;background:#F3F4F6;color:#4B5563;padding:.25rem .625rem;border-radius:9999px;border:1px solid #E5E7EB">Due Diligence</span>
              <span style="font-size:.75rem;background:#F3F4F6;color:#4B5563;padding:.25rem .625rem;border-radius:9999px;border:1px solid #E5E7EB">PMI Strategy</span>
              <span style="font-size:.75rem;background:#F3F4F6;color:#4B5563;padding:.25rem .625rem;border-radius:9999px;border:1px solid #E5E7EB">Synergy Mapping</span>
            </div>
          </div>

          <div style="background:#fff;padding:2.5rem;border-radius:1.5rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05)">
            <div style="width:3.5rem;height:3.5rem;background:#111827;border-radius:.875rem;display:flex;align-items:center;justify-content:center;margin-bottom:1.5rem">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            </div>
            <h3 style="font-size:1.125rem;font-weight:700;color:#111827;margin:0 0 .875rem">Growth Strategy</h3>
            <p style="font-size:.9rem;color:#4B5563;line-height:1.7;margin:0 0 1.25rem">Developing and executing comprehensive growth frameworks for mid-to-large cap enterprises entering new markets, launching new product lines, or scaling through technological transformation.</p>
            <div style="display:flex;flex-wrap:wrap;gap:.5rem">
              <span style="font-size:.75rem;background:#F3F4F6;color:#4B5563;padding:.25rem .625rem;border-radius:9999px;border:1px solid #E5E7EB">Market Entry</span>
              <span style="font-size:.75rem;background:#F3F4F6;color:#4B5563;padding:.25rem .625rem;border-radius:9999px;border:1px solid #E5E7EB">GTM Strategy</span>
              <span style="font-size:.75rem;background:#F3F4F6;color:#4B5563;padding:.25rem .625rem;border-radius:9999px;border:1px solid #E5E7EB">Revenue Scaling</span>
            </div>
          </div>

          <div style="background:#fff;padding:2.5rem;border-radius:1.5rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05)">
            <div style="width:3.5rem;height:3.5rem;background:#111827;border-radius:.875rem;display:flex;align-items:center;justify-content:center;margin-bottom:1.5rem">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14"/></svg>
            </div>
            <h3 style="font-size:1.125rem;font-weight:700;color:#111827;margin:0 0 .875rem">Operations Optimization</h3>
            <p style="font-size:.9rem;color:#4B5563;line-height:1.7;margin:0 0 1.25rem">Identifying operational inefficiencies, restructuring executive hierarchies, and implementing process governance that reduces friction while maintaining strategic agility across global operations.</p>
            <div style="display:flex;flex-wrap:wrap;gap:.5rem">
              <span style="font-size:.75rem;background:#F3F4F6;color:#4B5563;padding:.25rem .625rem;border-radius:9999px;border:1px solid #E5E7EB">Process Redesign</span>
              <span style="font-size:.75rem;background:#F3F4F6;color:#4B5563;padding:.25rem .625rem;border-radius:9999px;border:1px solid #E5E7EB">Org Design</span>
              <span style="font-size:.75rem;background:#F3F4F6;color:#4B5563;padding:.25rem .625rem;border-radius:9999px;border:1px solid #E5E7EB">KPI Frameworks</span>
            </div>
          </div>

          <div style="background:#fff;padding:2.5rem;border-radius:1.5rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05)">
            <div style="width:3.5rem;height:3.5rem;background:#111827;border-radius:.875rem;display:flex;align-items:center;justify-content:center;margin-bottom:1.5rem">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
            </div>
            <h3 style="font-size:1.125rem;font-weight:700;color:#111827;margin:0 0 .875rem">Board Governance</h3>
            <p style="font-size:.9rem;color:#4B5563;line-height:1.7;margin:0 0 1.25rem">Establishing best-practice governance frameworks, restructuring board composition for IPO readiness, and designing oversight protocols that satisfy both regulatory and investor expectations.</p>
            <div style="display:flex;flex-wrap:wrap;gap:.5rem">
              <span style="font-size:.75rem;background:#F3F4F6;color:#4B5563;padding:.25rem .625rem;border-radius:9999px;border:1px solid #E5E7EB">Committee Design</span>
              <span style="font-size:.75rem;background:#F3F4F6;color:#4B5563;padding:.25rem .625rem;border-radius:9999px;border:1px solid #E5E7EB">Compliance Audit</span>
              <span style="font-size:.75rem;background:#F3F4F6;color:#4B5563;padding:.25rem .625rem;border-radius:9999px;border:1px solid #E5E7EB">ESG Integration</span>
            </div>
          </div>

          <div style="background:#fff;padding:2.5rem;border-radius:1.5rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05)">
            <div style="width:3.5rem;height:3.5rem;background:#111827;border-radius:.875rem;display:flex;align-items:center;justify-content:center;margin-bottom:1.5rem">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h3 style="font-size:1.125rem;font-weight:700;color:#111827;margin:0 0 .875rem">Risk Architecture</h3>
            <p style="font-size:.9rem;color:#4B5563;line-height:1.7;margin:0 0 1.25rem">Enterprise-wide risk framework redesigns, predictive system development, and crisis response protocol engineering for organizations managing complex multi-jurisdictional exposures.</p>
            <div style="display:flex;flex-wrap:wrap;gap:.5rem">
              <span style="font-size:.75rem;background:#F3F4F6;color:#4B5563;padding:.25rem .625rem;border-radius:9999px;border:1px solid #E5E7EB">Risk Modeling</span>
              <span style="font-size:.75rem;background:#F3F4F6;color:#4B5563;padding:.25rem .625rem;border-radius:9999px;border:1px solid #E5E7EB">Crisis Protocols</span>
              <span style="font-size:.75rem;background:#F3F4F6;color:#4B5563;padding:.25rem .625rem;border-radius:9999px;border:1px solid #E5E7EB">Scenario Planning</span>
            </div>
          </div>

          <div style="background:#fff;padding:2.5rem;border-radius:1.5rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05)">
            <div style="width:3.5rem;height:3.5rem;background:#111827;border-radius:.875rem;display:flex;align-items:center;justify-content:center;margin-bottom:1.5rem">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M3 3h18v18H3z"/><path d="M9 3v18M15 3v18M3 9h18M3 15h18"/></svg>
            </div>
            <h3 style="font-size:1.125rem;font-weight:700;color:#111827;margin:0 0 .875rem">Digital Transformation</h3>
            <p style="font-size:.9rem;color:#4B5563;line-height:1.7;margin:0 0 1.25rem">Strategy-anchored digital transformation programs for legacy enterprises, ensuring technology investment aligns to strategic intent rather than tactical capability accumulation.</p>
            <div style="display:flex;flex-wrap:wrap;gap:.5rem">
              <span style="font-size:.75rem;background:#F3F4F6;color:#4B5563;padding:.25rem .625rem;border-radius:9999px;border:1px solid #E5E7EB">Tech Roadmapping</span>
              <span style="font-size:.75rem;background:#F3F4F6;color:#4B5563;padding:.25rem .625rem;border-radius:9999px;border:1px solid #E5E7EB">Change Management</span>
              <span style="font-size:.75rem;background:#F3F4F6;color:#4B5563;padding:.25rem .625rem;border-radius:9999px;border:1px solid #E5E7EB">Platform Strategy</span>
            </div>
          </div>

        </div>
      </section>

      <!-- Industry Verticals -->
      <section>
        <h2 style="font-size:1.625rem;font-weight:700;color:#111827;margin:0 0 2rem;letter-spacing:-.02em">Industry Verticals Served</h2>
        <div class="pp-vertical-grid" style="display:grid;grid-template-columns:repeat(4,1fr);gap:1.25rem">
          <div style="background:#fff;padding:1.75rem;border-radius:1.25rem;border:1px solid #E5E7EB;text-align:center">
            <div style="font-size:1.5rem;font-weight:700;color:#111827;margin-bottom:.375rem">FinTech</div>
            <div style="font-size:.8125rem;color:#6B7280">Banking, Payments, InsurTech</div>
          </div>
          <div style="background:#fff;padding:1.75rem;border-radius:1.25rem;border:1px solid #E5E7EB;text-align:center">
            <div style="font-size:1.5rem;font-weight:700;color:#111827;margin-bottom:.375rem">Technology</div>
            <div style="font-size:.8125rem;color:#6B7280">Enterprise SaaS, Infrastructure</div>
          </div>
          <div style="background:#fff;padding:1.75rem;border-radius:1.25rem;border:1px solid #E5E7EB;text-align:center">
            <div style="font-size:1.5rem;font-weight:700;color:#111827;margin-bottom:.375rem">Industrials</div>
            <div style="font-size:.8125rem;color:#6B7280">Logistics, Manufacturing</div>
          </div>
          <div style="background:#fff;padding:1.75rem;border-radius:1.25rem;border:1px solid #E5E7EB;text-align:center">
            <div style="font-size:1.5rem;font-weight:700;color:#111827;margin-bottom:.375rem">Healthcare</div>
            <div style="font-size:.8125rem;color:#6B7280">Hospital Networks, MedTech</div>
          </div>
          <div style="background:#fff;padding:1.75rem;border-radius:1.25rem;border:1px solid #E5E7EB;text-align:center">
            <div style="font-size:1.5rem;font-weight:700;color:#111827;margin-bottom:.375rem">Energy</div>
            <div style="font-size:.8125rem;color:#6B7280">Utilities, Renewables</div>
          </div>
          <div style="background:#fff;padding:1.75rem;border-radius:1.25rem;border:1px solid #E5E7EB;text-align:center">
            <div style="font-size:1.5rem;font-weight:700;color:#111827;margin-bottom:.375rem">Retail</div>
            <div style="font-size:.8125rem;color:#6B7280">Luxury, Mass Market</div>
          </div>
          <div style="background:#fff;padding:1.75rem;border-radius:1.25rem;border:1px solid #E5E7EB;text-align:center">
            <div style="font-size:1.5rem;font-weight:700;color:#111827;margin-bottom:.375rem">Private Equity</div>
            <div style="font-size:.8125rem;color:#6B7280">Portfolio, Fund Strategy</div>
          </div>
          <div style="background:#fff;padding:1.75rem;border-radius:1.25rem;border:1px solid #E5E7EB;text-align:center">
            <div style="font-size:1.5rem;font-weight:700;color:#111827;margin-bottom:.375rem">Media</div>
            <div style="font-size:.8125rem;color:#6B7280">Broadcasting, Digital</div>
          </div>
        </div>
      </section>

      <!-- Methodology Deep-Dive -->
      <section style="background:#111827;border-radius:2rem;padding:3.5rem;color:#fff">
        <div style="display:flex;flex-direction:column;gap:2.5rem;max-width:52rem">
          <div>
            <h2 style="font-size:1.625rem;font-weight:700;color:#fff;margin:0 0 .75rem">Proprietary Methodology: The Resilience Protocol</h2>
            <p style="font-size:1rem;color:#9CA3AF;line-height:1.7;margin:0">A framework developed over a decade of post-merger integrations and organizational restructurings, now adopted by 50+ Fortune 500 companies as a standard risk management tool.</p>
          </div>
          <div class="pp-protocol-grid" style="display:grid;grid-template-columns:repeat(2,1fr);gap:1.25rem">
            <div style="background:rgba(255,255,255,.06);padding:1.5rem;border-radius:1rem;border:1px solid rgba(255,255,255,.1)">
              <div style="font-size:.75rem;font-weight:700;color:#4F46E5;text-transform:uppercase;letter-spacing:.08em;margin-bottom:.625rem">Principle 01</div>
              <h3 style="font-size:1rem;font-weight:700;color:#fff;margin:0 0 .5rem">Fault Line Identification</h3>
              <p style="font-size:.875rem;color:#9CA3AF;line-height:1.6;margin:0">Map the invisible structural and cultural fractures in an organization before they become failure events.</p>
            </div>
            <div style="background:rgba(255,255,255,.06);padding:1.5rem;border-radius:1rem;border:1px solid rgba(255,255,255,.1)">
              <div style="font-size:.75rem;font-weight:700;color:#4F46E5;text-transform:uppercase;letter-spacing:.08em;margin-bottom:.625rem">Principle 02</div>
              <h3 style="font-size:1rem;font-weight:700;color:#fff;margin:0 0 .5rem">Resilience Architecture</h3>
              <p style="font-size:.875rem;color:#9CA3AF;line-height:1.6;margin:0">Design structural systems that absorb shocks and recalibrate without catastrophic disruption to operations.</p>
            </div>
            <div style="background:rgba(255,255,255,.06);padding:1.5rem;border-radius:1rem;border:1px solid rgba(255,255,255,.1)">
              <div style="font-size:.75rem;font-weight:700;color:#4F46E5;text-transform:uppercase;letter-spacing:.08em;margin-bottom:.625rem">Principle 03</div>
              <h3 style="font-size:1rem;font-weight:700;color:#fff;margin:0 0 .5rem">Cultural Anchoring</h3>
              <p style="font-size:.875rem;color:#9CA3AF;line-height:1.6;margin:0">Align incentive frameworks, leadership signals, and organizational rituals to reinforce the desired operating culture.</p>
            </div>
            <div style="background:rgba(255,255,255,.06);padding:1.5rem;border-radius:1rem;border:1px solid rgba(255,255,255,.1)">
              <div style="font-size:.75rem;font-weight:700;color:#4F46E5;text-transform:uppercase;letter-spacing:.08em;margin-bottom:.625rem">Principle 04</div>
              <h3 style="font-size:1rem;font-weight:700;color:#fff;margin:0 0 .5rem">Continuous Calibration</h3>
              <p style="font-size:.875rem;color:#9CA3AF;line-height:1.6;margin:0">Establish feedback mechanisms and measurement cadences to detect strategic drift before it becomes operational crisis.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Certifications -->
      <section>
        <h2 style="font-size:1.625rem;font-weight:700;color:#111827;margin:0 0 2rem;letter-spacing:-.02em">Certifications &amp; Credentials</h2>
        <div class="pp-certs-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:1.25rem">
          <div style="background:#fff;padding:1.75rem;border-radius:1.25rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05)">
            <div style="font-size:.75rem;color:#4F46E5;font-weight:600;text-transform:uppercase;letter-spacing:.06em;margin-bottom:.625rem">2018</div>
            <h3 style="font-size:1rem;font-weight:700;color:#111827;margin:0 0 .25rem">Certified Board Director</h3>
            <p style="font-size:.875rem;color:#4B5563;margin:0">Corporate Governance Institute</p>
          </div>
          <div style="background:#fff;padding:1.75rem;border-radius:1.25rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05)">
            <div style="font-size:.75rem;color:#4F46E5;font-weight:600;text-transform:uppercase;letter-spacing:.06em;margin-bottom:.625rem">2012</div>
            <h3 style="font-size:1rem;font-weight:700;color:#111827;margin:0 0 .25rem">Advanced Risk Management</h3>
            <p style="font-size:.875rem;color:#4B5563;margin:0">Global Risk Management Association</p>
          </div>
          <div style="background:#fff;padding:1.75rem;border-radius:1.25rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05)">
            <div style="font-size:.75rem;color:#4F46E5;font-weight:600;text-transform:uppercase;letter-spacing:.06em;margin-bottom:.625rem">2010</div>
            <h3 style="font-size:1rem;font-weight:700;color:#111827;margin:0 0 .25rem">Executive Leadership Program</h3>
            <p style="font-size:.875rem;color:#4B5563;margin:0">Harvard Business School</p>
          </div>
        </div>
      </section>

    </div>
  </main>

  <!-- Footer -->
  <footer style="background:#fff;border-top:1px solid #E5E7EB;padding:3rem 1.5rem;font-family:'Inter',sans-serif">
    <div style="max-width:1280px;margin-inline:auto;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1.5rem">
      <div style="display:flex;align-items:center;gap:.625rem">
        <div style="width:2rem;height:2rem;background:#111827;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:.6875rem;font-weight:700">EJ</div>
        <span style="font-size:.9375rem;font-weight:600;color:#111827">Edward James</span>
      </div>
      <div style="display:flex;align-items:center;gap:2rem;flex-wrap:wrap">
        <span style="font-size:.875rem;color:#6B7280">&copy; 2025 Edward James.</span>
        <div style="display:flex;gap:1rem">
          <a href="https://linkedin.com" target="_blank" rel="noopener" style="color:#6B7280;text-decoration:none" aria-label="LinkedIn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
          </a>
          <a href="https://twitter.com" target="_blank" rel="noopener" style="color:#6B7280;text-decoration:none" aria-label="Twitter">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </footer>

  <style>
    @media (max-width: 767px) {
      .pp-exp-grid { grid-template-columns: 1fr !important; }
      .pp-vertical-grid { grid-template-columns: repeat(2,1fr) !important; }
      .pp-protocol-grid { grid-template-columns: 1fr !important; }
      .pp-certs-grid { grid-template-columns: 1fr !important; }
    }
    @media (min-width: 768px) and (max-width: 1023px) {
      .pp-exp-grid { grid-template-columns: repeat(2,1fr) !important; }
      .pp-vertical-grid { grid-template-columns: repeat(2,1fr) !important; }
    }
  </style>
</BaseLayout>
