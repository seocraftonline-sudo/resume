---
import BaseLayout from '../../layouts/Base.astro';
import PPNav from '../../components/PPNav.astro';
---
<BaseLayout title="Services — Edward James" theme="pp">
  <link rel="stylesheet" href="/styles/rv.css" slot="head" />
  <PPNav active="services" />
  <main style="padding-top:5rem;background:#F9FAFB;min-height:100vh;font-family:'Inter',sans-serif">

    <!-- Services Hero -->
    <section style="text-align:center;padding:5rem 1.5rem 3rem;max-width:900px;margin-inline:auto">
      <span style="display:inline-block;padding:.5rem 1.25rem;background:#fff;border:1px solid #E5E7EB;border-radius:9999px;font-size:.8125rem;font-weight:500;color:#4B5563;margin-bottom:1.5rem;box-shadow:0 4px 20px rgba(0,0,0,.05)">Strategic Expertise</span>
      <h1 style="font-size:clamp(2.5rem,5vw,4rem);font-weight:700;color:#111827;letter-spacing:-.03em;line-height:1.1;margin:0 0 1.25rem">Architecting<br><span style="color:#4B5563">Enterprise Resilience</span></h1>
      <p style="font-size:1.125rem;color:#4B5563;line-height:1.7;margin:0 0 2.5rem;max-width:44rem;margin-inline:auto">Delivering structural interventions and executive oversight to organizations navigating complex transitions, regulatory shifts, and high-stakes scaling.</p>
      <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap">
        <a href="/pp/contact/" style="display:inline-block;padding:1rem 2rem;background:#111827;color:#fff;border-radius:9999px;font-size:.9375rem;font-weight:600;text-decoration:none">Discuss an Engagement</a>
        <a href="#process" style="display:inline-flex;align-items:center;gap:.5rem;padding:1rem 2rem;background:#fff;border:1px solid #E5E7EB;color:#111827;border-radius:9999px;font-size:.9375rem;font-weight:600;text-decoration:none">
          View Process
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
        </a>
      </div>
    </section>

    <div style="max-width:1280px;margin-inline:auto;padding:0 1.5rem 5rem;display:flex;flex-direction:column;gap:4rem">

      <!-- Service Cards -->
      <section>
        <div style="text-align:center;margin-bottom:2.5rem">
          <h2 style="font-size:2rem;font-weight:700;color:#111827;margin:0 0 .75rem;letter-spacing:-.025em">Core Service Areas</h2>
          <p style="font-size:1rem;color:#4B5563;margin:0">Focused methodologies designed for board-level impact and institutional longevity.</p>
        </div>
        <div class="pp-services-cards" style="display:grid;grid-template-columns:repeat(2,1fr);gap:2rem">

          <!-- Service 1 -->
          <div style="background:#fff;border-radius:1.5rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05);padding:2.5rem;display:flex;flex-direction:column">
            <div style="width:3rem;height:3rem;background:#F3F4F6;border-radius:.75rem;display:flex;align-items:center;justify-content:center;margin-bottom:2rem;border:1px solid #E5E7EB">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
            </div>
            <h3 style="font-size:1.25rem;font-weight:700;color:#111827;margin:0 0 1rem">Board Governance Structuring</h3>
            <p style="font-size:.9375rem;color:#4B5563;line-height:1.7;margin:0 0 1.5rem;flex:1">Establishing public-market ready governance frameworks for pre-IPO entities and restructuring legacy boards for modern compliance demands. I assess current board composition, identify structural deficiencies, and architect committees, charters, and oversight protocols that satisfy both regulatory and investor expectations.</p>
            <div style="background:#F9FAFB;border-radius:.875rem;padding:1.375rem;border:1px solid #E5E7EB;margin-bottom:1.5rem">
              <div style="font-size:.6875rem;font-weight:700;color:#111827;text-transform:uppercase;letter-spacing:.08em;margin-bottom:.875rem">Key Deliverables</div>
              <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:.625rem">
                <li style="display:flex;align-items:flex-start;gap:.625rem;font-size:.875rem;color:#4B5563">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="2.5" style="flex-shrink:0;margin-top:2px"><polyline points="20 6 9 17 4 12"/></svg>
                  Committee charter development &amp; implementation
                </li>
                <li style="display:flex;align-items:flex-start;gap:.625rem;font-size:.875rem;color:#4B5563">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="2.5" style="flex-shrink:0;margin-top:2px"><polyline points="20 6 9 17 4 12"/></svg>
                  Executive oversight protocols &amp; escalation frameworks
                </li>
                <li style="display:flex;align-items:flex-start;gap:.625rem;font-size:.875rem;color:#4B5563">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="2.5" style="flex-shrink:0;margin-top:2px"><polyline points="20 6 9 17 4 12"/></svg>
                  Regulatory compliance alignment audits
                </li>
              </ul>
            </div>
            <div style="display:flex;align-items:center;justify-content:space-between;border-top:1px solid #F3F4F6;padding-top:1.25rem">
              <div>
                <div style="font-size:.6875rem;color:#6B7280;text-transform:uppercase;letter-spacing:.06em;font-weight:600">Typical Duration</div>
                <div style="font-size:.9375rem;font-weight:600;color:#111827;margin-top:.25rem">3 – 6 Months</div>
              </div>
              <a href="/pp/contact/" style="display:inline-flex;align-items:center;gap:.375rem;font-size:.875rem;font-weight:700;color:#111827;text-decoration:none">
                Enquire
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
              </a>
            </div>
          </div>

          <!-- Service 2 -->
          <div style="background:#fff;border-radius:1.5rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05);padding:2.5rem;display:flex;flex-direction:column">
            <div style="width:3rem;height:3rem;background:#F3F4F6;border-radius:.75rem;display:flex;align-items:center;justify-content:center;margin-bottom:2rem;border:1px solid #E5E7EB">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h3 style="font-size:1.25rem;font-weight:700;color:#111827;margin:0 0 1rem">Risk Architecture &amp; Mitigation</h3>
            <p style="font-size:.9375rem;color:#4B5563;line-height:1.7;margin:0 0 1.5rem;flex:1">Comprehensive overhauls of enterprise risk frameworks, integrating predictive modeling to preempt systemic failures across global operations. I design early-warning systems, restructure risk committees, and align risk appetite to strategic objectives.</p>
            <div style="background:#F9FAFB;border-radius:.875rem;padding:1.375rem;border:1px solid #E5E7EB;margin-bottom:1.5rem">
              <div style="font-size:.6875rem;font-weight:700;color:#111827;text-transform:uppercase;letter-spacing:.08em;margin-bottom:.875rem">Key Deliverables</div>
              <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:.625rem">
                <li style="display:flex;align-items:flex-start;gap:.625rem;font-size:.875rem;color:#4B5563">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="2.5" style="flex-shrink:0;margin-top:2px"><polyline points="20 6 9 17 4 12"/></svg>
                  Supply chain vulnerability mapping
                </li>
                <li style="display:flex;align-items:flex-start;gap:.625rem;font-size:.875rem;color:#4B5563">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="2.5" style="flex-shrink:0;margin-top:2px"><polyline points="20 6 9 17 4 12"/></svg>
                  Crisis response protocol design &amp; simulation
                </li>
                <li style="display:flex;align-items:flex-start;gap:.625rem;font-size:.875rem;color:#4B5563">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="2.5" style="flex-shrink:0;margin-top:2px"><polyline points="20 6 9 17 4 12"/></svg>
                  Multi-jurisdiction regulatory exposure mapping
                </li>
              </ul>
            </div>
            <div style="display:flex;align-items:center;justify-content:space-between;border-top:1px solid #F3F4F6;padding-top:1.25rem">
              <div>
                <div style="font-size:.6875rem;color:#6B7280;text-transform:uppercase;letter-spacing:.06em;font-weight:600">Typical Duration</div>
                <div style="font-size:.9375rem;font-weight:600;color:#111827;margin-top:.25rem">6 – 12 Months</div>
              </div>
              <a href="/pp/contact/" style="display:inline-flex;align-items:center;gap:.375rem;font-size:.875rem;font-weight:700;color:#111827;text-decoration:none">
                Enquire
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
              </a>
            </div>
          </div>

          <!-- Service 3 -->
          <div style="background:#fff;border-radius:1.5rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05);padding:2.5rem;display:flex;flex-direction:column">
            <div style="width:3rem;height:3rem;background:#F3F4F6;border-radius:.75rem;display:flex;align-items:center;justify-content:center;margin-bottom:2rem;border:1px solid #E5E7EB">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <h3 style="font-size:1.25rem;font-weight:700;color:#111827;margin:0 0 1rem">Post-Merger Integration</h3>
            <p style="font-size:.9375rem;color:#4B5563;line-height:1.7;margin:0 0 1.5rem;flex:1">Strategic alignment of conflicting management hierarchies, cultural frameworks, and incentive structures following major acquisitions. I lead the full integration lifecycle, ensuring operational momentum is preserved while cultural friction is systematically reduced.</p>
            <div style="background:#F9FAFB;border-radius:.875rem;padding:1.375rem;border:1px solid #E5E7EB;margin-bottom:1.5rem">
              <div style="font-size:.6875rem;font-weight:700;color:#111827;text-transform:uppercase;letter-spacing:.08em;margin-bottom:.875rem">Key Deliverables</div>
              <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:.625rem">
                <li style="display:flex;align-items:flex-start;gap:.625rem;font-size:.875rem;color:#4B5563">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="2.5" style="flex-shrink:0;margin-top:2px"><polyline points="20 6 9 17 4 12"/></svg>
                  Executive leadership consolidation plans
                </li>
                <li style="display:flex;align-items:flex-start;gap:.625rem;font-size:.875rem;color:#4B5563">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="2.5" style="flex-shrink:0;margin-top:2px"><polyline points="20 6 9 17 4 12"/></svg>
                  Cultural friction point analysis &amp; mediation
                </li>
                <li style="display:flex;align-items:flex-start;gap:.625rem;font-size:.875rem;color:#4B5563">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="2.5" style="flex-shrink:0;margin-top:2px"><polyline points="20 6 9 17 4 12"/></svg>
                  Unified KPI &amp; incentive restructuring
                </li>
              </ul>
            </div>
            <div style="display:flex;align-items:center;justify-content:space-between;border-top:1px solid #F3F4F6;padding-top:1.25rem">
              <div>
                <div style="font-size:.6875rem;color:#6B7280;text-transform:uppercase;letter-spacing:.06em;font-weight:600">Typical Duration</div>
                <div style="font-size:.9375rem;font-weight:600;color:#111827;margin-top:.25rem">9 – 18 Months</div>
              </div>
              <a href="/pp/contact/" style="display:inline-flex;align-items:center;gap:.375rem;font-size:.875rem;font-weight:700;color:#111827;text-decoration:none">
                Enquire
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
              </a>
            </div>
          </div>

          <!-- Service 4 -->
          <div style="background:#fff;border-radius:1.5rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05);padding:2.5rem;display:flex;flex-direction:column">
            <div style="width:3rem;height:3rem;background:#F3F4F6;border-radius:.75rem;display:flex;align-items:center;justify-content:center;margin-bottom:2rem;border:1px solid #E5E7EB">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            </div>
            <h3 style="font-size:1.25rem;font-weight:700;color:#111827;margin:0 0 1rem">Executive Advisory Retainer</h3>
            <p style="font-size:.9375rem;color:#4B5563;line-height:1.7;margin:0 0 1.5rem;flex:1">Ongoing strategic counsel for C-suite executives and board chairs, providing an external, objective lens on critical corporate decisions. Advisory retainers are strictly limited to ensure dedicated attention and uncompromised quality of counsel.</p>
            <div style="background:#F9FAFB;border-radius:.875rem;padding:1.375rem;border:1px solid #E5E7EB;margin-bottom:1.5rem">
              <div style="font-size:.6875rem;font-weight:700;color:#111827;text-transform:uppercase;letter-spacing:.08em;margin-bottom:.875rem">Engagement Model</div>
              <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:.625rem">
                <li style="display:flex;align-items:flex-start;gap:.625rem;font-size:.875rem;color:#4B5563">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="2.5" style="flex-shrink:0;margin-top:2px"><polyline points="20 6 9 17 4 12"/></svg>
                  Monthly dedicated strategy sessions
                </li>
                <li style="display:flex;align-items:flex-start;gap:.625rem;font-size:.875rem;color:#4B5563">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="2.5" style="flex-shrink:0;margin-top:2px"><polyline points="20 6 9 17 4 12"/></svg>
                  On-call crisis counsel access
                </li>
                <li style="display:flex;align-items:flex-start;gap:.625rem;font-size:.875rem;color:#4B5563">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="2.5" style="flex-shrink:0;margin-top:2px"><polyline points="20 6 9 17 4 12"/></svg>
                  Quarterly board presentation preparation &amp; review
                </li>
              </ul>
            </div>
            <div style="display:flex;align-items:center;justify-content:space-between;border-top:1px solid #F3F4F6;padding-top:1.25rem">
              <div>
                <div style="font-size:.6875rem;color:#6B7280;text-transform:uppercase;letter-spacing:.06em;font-weight:600">Availability</div>
                <div style="font-size:.9375rem;font-weight:600;color:#111827;margin-top:.25rem">Limited Capacity</div>
              </div>
              <a href="/pp/contact/" style="display:inline-flex;align-items:center;gap:.375rem;font-size:.875rem;font-weight:700;color:#111827;text-decoration:none">
                Enquire
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
              </a>
            </div>
          </div>

        </div>
      </section>

      <!-- Engagement Process -->
      <section id="process" style="background:#fff;border-radius:2rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05);padding:3.5rem">
        <div style="text-align:center;margin-bottom:3rem">
          <span style="display:inline-block;padding:.375rem 1rem;background:#F9FAFB;border:1px solid #E5E7EB;border-radius:9999px;font-size:.8125rem;font-weight:500;color:#4B5563;margin-bottom:1rem">Methodology</span>
          <h2 style="font-size:2rem;font-weight:700;color:#111827;margin:0 0 .75rem;letter-spacing:-.025em">The Engagement Process</h2>
          <p style="font-size:1rem;color:#4B5563;margin:0">A disciplined, structured approach to defining scope, executing strategy, and measuring impact.</p>
        </div>
        <div style="display:flex;flex-direction:column;gap:2.5rem;position:relative">
          <div style="position:absolute;left:1.6875rem;top:3.5rem;bottom:3.5rem;width:1px;background:#E5E7EB"></div>
          <div style="display:flex;gap:2rem;align-items:flex-start;position:relative;z-index:1">
            <div style="width:3.5rem;height:3.5rem;border-radius:.875rem;background:#111827;color:#fff;display:flex;align-items:center;justify-content:center;font-size:1rem;font-weight:700;flex-shrink:0">01</div>
            <div style="padding-top:.625rem">
              <h3 style="font-size:1.125rem;font-weight:700;color:#111827;margin:0 0 .625rem">Initial Diagnostics &amp; Alignment</h3>
              <p style="font-size:.9375rem;color:#4B5563;line-height:1.7;margin:0 0 1rem">We begin with a confidential briefing to understand the macro-level challenges. This phase involves reviewing existing documentation, identifying structural friction points, and determining mutual fit.</p>
              <div style="background:#F9FAFB;padding:1rem 1.25rem;border-radius:.75rem;border:1px solid #E5E7EB;font-size:.875rem;color:#4B5563"><strong style="color:#111827">Output:</strong> Preliminary diagnostic report outlining core issues and proposed strategic direction.</div>
            </div>
          </div>
          <div style="display:flex;gap:2rem;align-items:flex-start;position:relative;z-index:1">
            <div style="width:3.5rem;height:3.5rem;border-radius:.875rem;background:#111827;color:#fff;display:flex;align-items:center;justify-content:center;font-size:1rem;font-weight:700;flex-shrink:0">02</div>
            <div style="padding-top:.625rem">
              <h3 style="font-size:1.125rem;font-weight:700;color:#111827;margin:0 0 .625rem">Scope &amp; Architecture Design</h3>
              <p style="font-size:.9375rem;color:#4B5563;line-height:1.7;margin:0 0 1rem">Once aligned, we architect the specific interventions. Precise deliverables, timelines, stakeholder mapping, and commercial terms are formalized in a comprehensive engagement document.</p>
              <div style="background:#F9FAFB;padding:1rem 1.25rem;border-radius:.75rem;border:1px solid #E5E7EB;font-size:.875rem;color:#4B5563"><strong style="color:#111827">Output:</strong> Comprehensive Statement of Work detailing the full engagement architecture.</div>
            </div>
          </div>
          <div style="display:flex;gap:2rem;align-items:flex-start;position:relative;z-index:1">
            <div style="width:3.5rem;height:3.5rem;border-radius:.875rem;background:#111827;color:#fff;display:flex;align-items:center;justify-content:center;font-size:1rem;font-weight:700;flex-shrink:0">03</div>
            <div style="padding-top:.625rem">
              <h3 style="font-size:1.125rem;font-weight:700;color:#111827;margin:0 0 .625rem">Execution &amp; Integration</h3>
              <p style="font-size:.9375rem;color:#4B5563;line-height:1.7;margin:0">Active implementation phase. We implement structural changes, working directly with the board or C-suite. Characterized by rigorous oversight, weekly progress reporting, and adaptive problem-solving in real time.</p>
            </div>
          </div>
          <div style="display:flex;gap:2rem;align-items:flex-start;position:relative;z-index:1">
            <div style="width:3.5rem;height:3.5rem;border-radius:.875rem;background:#111827;color:#fff;display:flex;align-items:center;justify-content:center;font-size:1rem;font-weight:700;flex-shrink:0">04</div>
            <div style="padding-top:.625rem">
              <h3 style="font-size:1.125rem;font-weight:700;color:#111827;margin:0 0 .625rem">Handoff &amp; Institutionalization</h3>
              <p style="font-size:.9375rem;color:#4B5563;line-height:1.7;margin:0">Strategies are only valuable if they endure. The final phase embeds frameworks into the organization's DNA, trains internal teams for continuity, and establishes long-term measurement metrics.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- FAQ -->
      <section>
        <div style="text-align:center;margin-bottom:2.5rem">
          <h2 style="font-size:2rem;font-weight:700;color:#111827;margin:0 0 .75rem;letter-spacing:-.025em">Engagement Parameters</h2>
          <p style="font-size:1rem;color:#4B5563;margin:0">Common queries regarding scope, availability, and operational mechanics.</p>
        </div>
        <div style="max-width:50rem;margin-inline:auto;display:flex;flex-direction:column;gap:1rem">
          <div style="background:#fff;border-radius:1.25rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05);padding:1.75rem">
            <h3 style="font-size:1.0625rem;font-weight:700;color:#111827;margin:0 0 .75rem">What size organizations do you typically advise?</h3>
            <p style="font-size:.9375rem;color:#4B5563;line-height:1.7;margin:0">Engagements are focused on mid-market to enterprise-level organizations (revenues of $50M – $1B+), pre-IPO tech firms, and established financial institutions where structural complexity requires specialized oversight.</p>
          </div>
          <div style="background:#fff;border-radius:1.25rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05);padding:1.75rem">
            <h3 style="font-size:1.0625rem;font-weight:700;color:#111827;margin:0 0 .75rem">Do you work with internal teams or independently?</h3>
            <p style="font-size:.9375rem;color:#4B5563;line-height:1.7;margin:0">I operate primarily at the board and C-suite level but interface closely with internal execution teams — legal, finance, operations — to ensure strategic directives are practically implementable and culturally aligned.</p>
          </div>
          <div style="background:#fff;border-radius:1.25rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05);padding:1.75rem">
            <h3 style="font-size:1.0625rem;font-weight:700;color:#111827;margin:0 0 .75rem">How is your availability structured?</h3>
            <p style="font-size:.9375rem;color:#4B5563;line-height:1.7;margin:0">To ensure absolute focus and quality of execution, I limit active project engagements to three concurrent clients. Advisory retainers are capped separately. Please enquire regarding current Q3/Q4 availability.</p>
          </div>
          <div style="background:#fff;border-radius:1.25rem;border:1px solid #E5E7EB;box-shadow:0 4px 20px rgba(0,0,0,.05);padding:1.75rem">
            <h3 style="font-size:1.0625rem;font-weight:700;color:#111827;margin:0 0 .75rem">How is pricing structured?</h3>
            <p style="font-size:.9375rem;color:#4B5563;line-height:1.7;margin:0">Project engagements are priced on a fixed-fee basis determined by scope and duration. Advisory retainers are structured as monthly arrangements. All commercial terms are defined in a formal Statement of Work prior to engagement commencement.</p>
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section style="background:#111827;border-radius:2rem;padding:4rem 3rem;text-align:center;position:relative;overflow:hidden">
