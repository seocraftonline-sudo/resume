---
import BaseLayout from '../../layouts/Base.astro';
import HCNav from '../../components/HCNav.astro';
---
<BaseLayout title="Programs & Initiatives — Michael Rivera" theme="hc">
  <link rel="stylesheet" href="/styles/rv.css" slot="head" />
  <HCNav active="projects" />

  <style>
    *{box-sizing:border-box}
    body{background:#0F172A;color:#F8FAFC;font-family:'Inter',sans-serif;overflow-x:hidden}
    .glass-card{background:rgba(255,255,255,.03);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.05);border-radius:24px}
    .section-pad{padding:6rem 1.5rem}
    .container{max-width:1280px;margin-inline:auto}
    .serif{font-family:'Playfair Display',serif}
    .btn-green{display:inline-flex;align-items:center;gap:.5rem;background:#4ADE80;color:#0F172A;font-weight:600;font-size:.9375rem;padding:.875rem 2rem;border-radius:9999px;text-decoration:none;transition:box-shadow .2s ease}
    .btn-green:hover{box-shadow:0 0 24px rgba(74,222,128,.4)}
    @media(max-width:767px){
      .feat-inner{flex-direction:column!important}
      .archive-grid{grid-template-columns:1fr!important}
      .group-grid{grid-template-columns:1fr!important}
      .section-pad{padding:4rem 1.25rem}
    }
  </style>

  <main style="padding-top:5rem">

    <!-- Hero -->
    <section style="padding:6rem 1.5rem 4rem;background:linear-gradient(180deg,rgba(26,54,38,.9) 0%,rgba(15,23,42,1) 100%)">
      <div class="container" style="text-align:center;max-width:720px">
        <div style="display:inline-flex;align-items:center;gap:.5rem;padding:.375rem 1rem;border-radius:9999px;background:rgba(74,222,128,.08);border:1px solid rgba(74,222,128,.2);font-size:.8125rem;color:#94A3B8;margin-bottom:1.5rem">
          <span style="width:6px;height:6px;border-radius:50%;background:#4ADE80;display:inline-block"></span>
          Workshops &amp; Programs
        </div>
        <h1 class="serif" style="font-size:clamp(2rem,4vw,3.5rem);font-weight:700;color:#F8FAFC;line-height:1.2;margin-bottom:1.25rem">Programs &amp; Initiatives</h1>
        <p style="color:#94A3B8;font-size:1.0625rem;line-height:1.75">From flagship group programs to community workshops, these are the spaces I've built for collective growth and transformation.</p>
      </div>
    </section>

    <!-- Featured Program -->
    <section class="section-pad" style="background:#0F172A">
      <div class="container">
        <div style="font-size:.8125rem;text-transform:uppercase;letter-spacing:.12em;color:#4ADE80;margin-bottom:1.5rem">Featured Program</div>
        <div class="feat-inner" style="display:flex;gap:4rem;align-items:center">
          <div style="flex:1">
            <div style="display:inline-flex;align-items:center;gap:.5rem;padding:.375rem 1rem;border-radius:9999px;background:rgba(74,222,128,.1);border:1px solid rgba(74,222,128,.25);font-size:.8125rem;color:#4ADE80;margin-bottom:1.25rem;font-weight:600">
              ✦ Flagship Program
            </div>
            <h2 class="serif" style="font-size:clamp(1.75rem,3.5vw,3rem);font-weight:700;color:#F8FAFC;margin-bottom:1rem;line-height:1.2">Roots &amp; Direction</h2>
            <p style="color:#94A3B8;font-size:1.0625rem;line-height:1.75;margin-bottom:1.5rem">A 12-week cohort program for people at career and life crossroads. Built on the insight that sustainable direction only comes after you understand what you're rooted in.</p>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:2rem">
              <div class="glass-card" style="padding:1rem;border-radius:16px">
                <div style="font-size:.75rem;color:#94A3B8;margin-bottom:.25rem">Duration</div>
                <div style="font-size:.9375rem;color:#F8FAFC;font-weight:600">12 Weeks</div>
              </div>
              <div class="glass-card" style="padding:1rem;border-radius:16px">
                <div style="font-size:.75rem;color:#94A3B8;margin-bottom:.25rem">Cohort Size</div>
                <div style="font-size:.9375rem;color:#F8FAFC;font-weight:600">8–12 People</div>
              </div>
              <div class="glass-card" style="padding:1rem;border-radius:16px">
                <div style="font-size:.75rem;color:#94A3B8;margin-bottom:.25rem">Format</div>
                <div style="font-size:.9375rem;color:#F8FAFC;font-weight:600">Virtual + 1 Retreat</div>
              </div>
              <div class="glass-card" style="padding:1rem;border-radius:16px">
                <div style="font-size:.75rem;color:#94A3B8;margin-bottom:.25rem">Alumni</div>
                <div style="font-size:.9375rem;color:#F8FAFC;font-weight:600">120+ in 12 Countries</div>
              </div>
            </div>
            <div style="display:flex;gap:1rem;flex-wrap:wrap">
              <a href="/hc/contact/" class="btn-green">Apply for Next Cohort</a>
              <a href="/hc/services/" style="display:inline-flex;align-items:center;gap:.5rem;color:rgba(248,250,252,.7);font-size:.9375rem;text-decoration:none;padding:.875rem 2rem;border:1px solid rgba(255,255,255,.15);border-radius:9999px;transition:border-color .2s ease">Learn More</a>
            </div>
          </div>
          <div style="flex:0 0 440px">
            <div style="border-radius:24px;overflow:hidden;border:1px solid rgba(255,255,255,.08);box-shadow:0 24px 64px rgba(0,0,0,.4)">
              <img src="https://images.pexels.com/photos/3184325/pexels-photo-3184325.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Roots and Direction program" style="width:100%;height:400px;object-fit:cover;display:block" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Archive List -->
    <section class="section-pad" style="background:#1A3626;background:rgba(26,54,38,.2);border-top:1px solid rgba(255,255,255,.05)">
      <div class="container">
        <div style="text-align:center;margin-bottom:3.5rem">
          <h2 class="serif" style="font-size:clamp(1.75rem,3vw,2.5rem);font-weight:700;color:#F8FAFC;margin-bottom:.75rem">Initiative Archive</h2>
          <p style="color:#94A3B8;max-width:520px;margin-inline:auto;line-height:1.7">Past programs and workshops that have shaped the community over the years.</p>
        </div>
        <div class="archive-grid" style="display:grid;grid-template-columns:repeat(2,1fr);gap:1.25rem;max-width:900px;margin-inline:auto">
          <div class="glass-card" style="padding:1.75rem;display:flex;gap:1.25rem;align-items:start">
            <div style="flex-shrink:0;width:44px;height:44px;border-radius:10px;background:rgba(74,222,128,.08);border:1px solid rgba(74,222,128,.15);display:flex;align-items:center;justify-content:center">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4ADE80" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
            </div>
            <div>
              <div style="font-size:.75rem;color:#94A3B8;margin-bottom:.25rem">2023 · Workshop</div>
              <h3 style="font-size:1rem;font-weight:600;color:#F8FAFC;margin-bottom:.4rem">Clarity Under Pressure</h3>
              <p style="font-size:.8125rem;color:#94A3B8;line-height:1.6">A half-day intensive for high-performers navigating burnout and overwhelm. 140 attendees across 3 cities.</p>
            </div>
          </div>
          <div class="glass-card" style="padding:1.75rem;display:flex;gap:1.25rem;align-items:start">
            <div style="flex-shrink:0;width:44px;height:44px;border-radius:10px;background:rgba(74,222,128,.08);border:1px solid rgba(74,222,128,.15);display:flex;align-items:center;justify-content:center">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4ADE80" stroke-width="1.8"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <div>
              <div style="font-size:.75rem;color:#94A3B8;margin-bottom:.25rem">2022 · Group Program</div>
              <h3 style="font-size:1rem;font-weight:600;color:#F8FAFC;margin-bottom:.4rem">The Men's Circle</h3>
              <p style="font-size:.8125rem;color:#94A3B8;line-height:1.6">A 6-week program for men exploring emotional intelligence, vulnerability, and authentic leadership. First-of-its-kind in Austin.</p>
            </div>
          </div>
          <div class="glass-card" style="padding:1.75rem;display:flex;gap:1.25rem;align-items:start">
            <div style="flex-shrink:0;width:44px;height:44px;border-radius:10px;background:rgba(74,222,128,.08);border:1px solid rgba(74,222,128,.15);display:flex;align-items:center;justify-content:center">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4ADE80" stroke-width="1.8"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
            </div>
            <div>
              <div style="font-size:.75rem;color:#94A3B8;margin-bottom:.25rem">2022 · Workshop Series</div>
              <h3 style="font-size:1rem;font-weight:600;color:#F8FAFC;margin-bottom:.4rem">Career Pivot Bootcamp</h3>
              <p style="font-size:.8125rem;color:#94A3B8;line-height:1.6">4-week program with tools, community, and accountability for navigating major career transitions. 80+ graduates.</p>
            </div>
          </div>
          <div class="glass-card" style="padding:1.75rem;display:flex;gap:1.25rem;align-items:start">
            <div style="flex-shrink:0;width:44px;height:44px;border-radius:10px;background:rgba(74,222,128,.08);border:1px solid rgba(74,222,128,.15);display:flex;align-items:center;justify-content:center">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4ADE80" stroke-width="1.8"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            </div>
            <div>
              <div style="font-size:.75rem;color:#94A3B8;margin-bottom:.25rem">2021 · Online Program</div>
              <h3 style="font-size:1rem;font-weight:600;color:#F8FAFC;margin-bottom:.4rem">Relationship Reset</h3>
              <p style="font-size:.8125rem;color:#94A3B8;line-height:1.6">Helping couples and individuals rebuild communication after conflict. Ran twice with 35 participants total.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Group Programs -->
    <section class="section-pad" style="background:#0F172A;border-top:1px solid rgba(255,255,255,.05)">
      <div class="container">
        <div style="text-align:center;margin-bottom:3.5rem">
          <h2 class="serif" style="font-size:clamp(1.75rem,3vw,2.5rem);font-weight:700;color:#F8FAFC;margin-bottom:.75rem">Current Group Programs</h2>
          <p style="color:#94A3B8;max-width:520px;margin-inline:auto;line-height:1.7">Open for enrollment. Join a cohort of people committed to real change.</p>
        </div>
        <div class="group-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem">
          <div class="glass-card" style="padding:2rem;border-color:rgba(74,222,128,.15);background:#1A3626;position:relative;overflow:hidden">
            <div style="position:absolute;top:1rem;right:1rem;padding:.25rem .75rem;background:rgba(74,222,128,.15);border:1px solid rgba(74,222,128,.3);border-radius:9999px;font-size:.7rem;color:#4ADE80;font-weight:600">Open</div>
            <h3 class="serif" style="font-size:1.2rem;font-weight:700;color:#F8FAFC;margin-bottom:.75rem">Roots &amp; Direction</h3>
            <p style="font-size:.8125rem;color:#94A3B8;line-height:1.6;margin-bottom:1.25rem">The flagship 12-week cohort program for navigating major life transitions with clarity and community.</p>
            <div style="font-size:.8125rem;color:#94A3B8;margin-bottom:1.5rem">Starts: February 2026 · 8 spots left</div>
            <a href="/hc/contact/" style="font-size:.8125rem;color:#4ADE80;text-decoration:none;font-weight:500">Apply now →</a>
          </div>
          <div class="glass-card" style="padding:2rem">
            <div style="display:inline-block;padding:.25rem .75rem;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:9999px;font-size:.7rem;color:#94A3B8;font-weight:600;margin-bottom:1.25rem">Waitlist</div>
            <h3 class="serif" style="font-size:1.2rem;font-weight:700;color:#F8FAFC;margin-bottom:.75rem">The Authentic Leader</h3>
            <p style="font-size:.8125rem;color:#94A3B8;line-height:1.6;margin-bottom:1.25rem">For managers and executives learning to lead from a place of values rather than fear. 8-week intensive.</p>
            <div style="font-size:.8125rem;color:#94A3B8;margin-bottom:1.5rem">Q2 2026 · Building waitlist now</div>
            <a href="/hc/contact/" style="font-size:.8125rem;color:#4ADE80;text-decoration:none;font-weight:500">Join waitlist →</a>
          </div>
          <div class="glass-card" style="padding:2rem">
            <div style="display:inline-block;padding:.25rem .75rem;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:9999px;font-size:.7rem;color:#94A3B8;font-weight:600;margin-bottom:1.25rem">Coming Soon</div>
            <h3 class="serif" style="font-size:1.2rem;font-weight:700;color:#F8FAFC;margin-bottom:.75rem">Midlife, Reimagined</h3>
            <p style="font-size:.8125rem;color:#94A3B8;line-height:1.6;margin-bottom:1.25rem">A new program for people in their 40s–50s navigating the second chapter with curiosity instead of dread.</p>
            <div style="font-size:.8125rem;color:#94A3B8;margin-bottom:1.5rem">Q3 2026 · Interest list open</div>
            <a href="/hc/contact/" style="font-size:.8125rem;color:#4ADE80;text-decoration:none;font-weight:500">Express interest →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer style="padding:3rem 1.5rem;background:rgba(0,0,0,.3);border-top:1px solid rgba(255,255,255,.05)">
      <div class="container" style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:1.5rem">
        <div style="font-family:'Playfair Display',serif;font-size:1.25rem;font-weight:700;color:#F8FAFC;display:flex;align-items:center;gap:.35rem">Michael <span style="color:#4ADE80;font-size:.8rem">✦</span></div>
        <div style="display:flex;gap:1.5rem">
          <a href="#" style="color:#94A3B8"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a>
          <a href="#" style="color:#94A3B8"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg></a>
        </div>
        <p style="font-size:.8125rem;color:#94A3B8">© 2025 Michael Rivera. All rights reserved.</p>
      </div>
    </footer>
  </main>
</BaseLayout>
