---
import BaseLayout from '../../layouts/Base.astro';
import HCNav from '../../components/HCNav.astro';
---
<BaseLayout title="Publications & Media — Michael Rivera" theme="hc">
  <link rel="stylesheet" href="/styles/rv.css" slot="head" />
  <HCNav active="publications" />

  <style>
    *{box-sizing:border-box}
    body{background:#0F172A;color:#F8FAFC;font-family:'Inter',sans-serif;overflow-x:hidden}
    .glass-card{background:rgba(255,255,255,.03);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.05);border-radius:24px}
    .section-pad{padding:6rem 1.5rem}
    .container{max-width:1280px;margin-inline:auto}
    .serif{font-family:'Playfair Display',serif}
    @media(max-width:767px){
      .pub-grid{grid-template-columns:1fr!important}
      .pod-grid{grid-template-columns:1fr!important}
      .section-pad{padding:4rem 1.25rem}
    }
  </style>

  <main style="padding-top:5rem">

    <!-- Hero -->
    <section style="padding:6rem 1.5rem 4rem;background:linear-gradient(180deg,rgba(26,54,38,.9) 0%,rgba(15,23,42,1) 100%)">
      <div class="container" style="text-align:center;max-width:720px">
        <div style="display:inline-flex;align-items:center;gap:.5rem;padding:.375rem 1rem;border-radius:9999px;background:rgba(74,222,128,.08);border:1px solid rgba(74,222,128,.2);font-size:.8125rem;color:#94A3B8;margin-bottom:1.5rem">
          <span style="width:6px;height:6px;border-radius:50%;background:#4ADE80;display:inline-block"></span>
          Words, Ideas, Conversations
        </div>
        <h1 class="serif" style="font-size:clamp(2rem,4vw,3.5rem);font-weight:700;color:#F8FAFC;line-height:1.2;margin-bottom:1.25rem">Publications &amp; Media</h1>
        <p style="color:#94A3B8;font-size:1.0625rem;line-height:1.75">Essays, podcast conversations, workshops, and recognition that have come from a decade of thinking deeply about how humans change.</p>
      </div>
    </section>

    <!-- Articles & Essays -->
    <section class="section-pad" style="background:#0F172A">
      <div class="container">
        <div style="margin-bottom:3rem">
          <h2 class="serif" style="font-size:clamp(1.5rem,3vw,2.25rem);font-weight:700;color:#F8FAFC;margin-bottom:.5rem">Articles &amp; Essays</h2>
          <p style="color:#94A3B8">Published across platforms and in my own newsletter.</p>
        </div>
        <div class="pub-grid" style="display:grid;grid-template-columns:repeat(2,1fr);gap:1.25rem">

          <div class="glass-card" style="padding:2rem;display:flex;flex-direction:column;gap:1rem">
            <div style="display:flex;align-items:start;justify-content:space-between;flex-wrap:wrap;gap:.5rem">
              <span style="padding:.25rem .75rem;background:rgba(74,222,128,.08);border:1px solid rgba(74,222,128,.2);border-radius:9999px;font-size:.75rem;color:#4ADE80">Psychology Today</span>
              <span style="font-size:.8125rem;color:#94A3B8">Nov 2024</span>
            </div>
            <h3 class="serif" style="font-size:1.1rem;font-weight:700;color:#F8FAFC;line-height:1.4">"Why High Achievers Often Feel Like Impostors (And What to Do About It)"</h3>
            <p style="font-size:.8125rem;color:#94A3B8;line-height:1.6">An exploration of imposter syndrome not as a belief problem but as a disconnection between values and identity.</p>
            <a href="#" style="font-size:.8125rem;color:#4ADE80;text-decoration:none;font-weight:500;display:flex;align-items:center;gap:.35rem;margin-top:auto">Read article <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
          </div>

          <div class="glass-card" style="padding:2rem;display:flex;flex-direction:column;gap:1rem">
            <div style="display:flex;align-items:start;justify-content:space-between;flex-wrap:wrap;gap:.5rem">
              <span style="padding:.25rem .75rem;background:rgba(74,222,128,.08);border:1px solid rgba(74,222,128,.2);border-radius:9999px;font-size:.75rem;color:#4ADE80">Harvard Business Review</span>
              <span style="font-size:.8125rem;color:#94A3B8">Mar 2024</span>
            </div>
            <h3 class="serif" style="font-size:1.1rem;font-weight:700;color:#F8FAFC;line-height:1.4">"The Leadership Crisis Nobody Talks About: Emotional Loneliness at the Top"</h3>
            <p style="font-size:.8125rem;color:#94A3B8;line-height:1.6">How organizational structures isolate leaders just when they need human connection most — and what can be done.</p>
            <a href="#" style="font-size:.8125rem;color:#4ADE80;text-decoration:none;font-weight:500;display:flex;align-items:center;gap:.35rem;margin-top:auto">Read article <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
          </div>

          <div class="glass-card" style="padding:2rem;display:flex;flex-direction:column;gap:1rem">
            <div style="display:flex;align-items:start;justify-content:space-between;flex-wrap:wrap;gap:.5rem">
              <span style="padding:.25rem .75rem;background:rgba(74,222,128,.08);border:1px solid rgba(74,222,128,.2);border-radius:9999px;font-size:.75rem;color:#4ADE80">Substack Newsletter</span>
              <span style="font-size:.8125rem;color:#94A3B8">Jan 2025</span>
            </div>
            <h3 class="serif" style="font-size:1.1rem;font-weight:700;color:#F8FAFC;line-height:1.4">"On Grief as a Career Strategy"</h3>
            <p style="font-size:.8125rem;color:#94A3B8;line-height:1.6">What if the transitions that feel like failures are actually the ones that make everything after them more true?</p>
            <a href="#" style="font-size:.8125rem;color:#4ADE80;text-decoration:none;font-weight:500;display:flex;align-items:center;gap:.35rem;margin-top:auto">Read essay <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
          </div>

          <div class="glass-card" style="padding:2rem;display:flex;flex-direction:column;gap:1rem">
            <div style="display:flex;align-items:start;justify-content:space-between;flex-wrap:wrap;gap:.5rem">
              <span style="padding:.25rem .75rem;background:rgba(74,222,128,.08);border:1px solid rgba(74,222,128,.2);border-radius:9999px;font-size:.75rem;color:#4ADE80">Medium</span>
              <span style="font-size:.8125rem;color:#94A3B8">Sep 2023</span>
            </div>
            <h3 class="serif" style="font-size:1.1rem;font-weight:700;color:#F8FAFC;line-height:1.4">"The Myth of the Perfect Pivot: Why Career Change Is Usually Messier Than the Highlight Reel"</h3>
            <p style="font-size:.8125rem;color:#94A3B8;line-height:1.6">Shared by 4,000+ people. A corrective to the "I quit my job and followed my passion" narrative that erases the hard middle.</p>
            <a href="#" style="font-size:.8125rem;color:#4ADE80;text-decoration:none;font-weight:500;display:flex;align-items:center;gap:.35rem;margin-top:auto">Read article <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
          </div>

          <div class="glass-card" style="padding:2rem;display:flex;flex-direction:column;gap:1rem">
            <div style="display:flex;align-items:start;justify-content:space-between;flex-wrap:wrap;gap:.5rem">
              <span style="padding:.25rem .75rem;background:rgba(74,222,128,.08);border:1px solid rgba(74,222,128,.2);border-radius:9999px;font-size:.75rem;color:#4ADE80">Mindful Magazine</span>
              <span style="font-size:.8125rem;color:#94A3B8">Jun 2023</span>
            </div>
            <h3 class="serif" style="font-size:1.1rem;font-weight:700;color:#F8FAFC;line-height:1.4">"Stillness as Productivity: A Reframe for the Achievement-Addicted"</h3>
            <p style="font-size:.8125rem;color:#94A3B8;line-height:1.6">For those who can't stop without feeling guilty — and why that feeling is worth examining closely.</p>
            <a href="#" style="font-size:.8125rem;color:#4ADE80;text-decoration:none;font-weight:500;display:flex;align-items:center;gap:.35rem;margin-top:auto">Read article <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
          </div>

          <div class="glass-card" style="padding:2rem;display:flex;flex-direction:column;gap:1rem">
            <div style="display:flex;align-items:start;justify-content:space-between;flex-wrap:wrap;gap:.5rem">
              <span style="padding:.25rem .75rem;background:rgba(74,222,128,.08);border:1px solid rgba(74,222,128,.2);border-radius:9999px;font-size:.75rem;color:#4ADE80">Coaching World</span>
              <span style="font-size:.8125rem;color:#94A3B8">Feb 2023</span>
            </div>
            <h3 class="serif" style="font-size:1.1rem;font-weight:700;color:#F8FAFC;line-height:1.4">"Integrating Somatic Awareness into Career Coaching: A Practitioner's Guide"</h3>
            <p style="font-size:.8125rem;color:#94A3B8;line-height:1.6">A practical framework for coaches wanting to bring body-based awareness into professional development sessions.</p>
            <a href="#" style="font-size:.8125rem;color:#4ADE80;text-decoration:none;font-weight:500;display:flex;align-items:center;gap:.35rem;margin-top:auto">Read article <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
          </div>
        </div>
      </div>
    </section>

    <!-- Podcast Appearances -->
    <section class="section-pad" style="background:rgba(26,54,38,.15);border-top:1px solid rgba(255,255,255,.05)">
      <div class="container">
        <div style="margin-bottom:3rem">
          <h2 class="serif" style="font-size:clamp(1.5rem,3vw,2.25rem);font-weight:700;color:#F8FAFC;margin-bottom:.5rem">Podcast Appearances</h2>
          <p style="color:#94A3B8">Conversations that went deep on human change, transitions, and what it means to live well.</p>
        </div>
        <div class="pod-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:1.25rem">
          <div class="glass-card" style="padding:1.75rem">
            <div style="width:44px;height:44px;border-radius:10px;background:rgba(74,222,128,.08);border:1px solid rgba(74,222,128,.15);display:flex;align-items:center;justify-content:center;margin-bottom:1.25rem">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4ADE80" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
            </div>
            <div style="font-size:.75rem;color:#94A3B8;margin-bottom:.35rem">The Tim Ferriss Show · Ep. 601</div>
            <h3 style="font-size:.9375rem;font-weight:600;color:#F8FAFC;margin-bottom:.5rem;line-height:1.4">"The Difference Between Being Lost and Being Between Stories"</h3>
            <a href="#" style="font-size:.8125rem;color:#4ADE80;text-decoration:none">Listen →</a>
          </div>
          <div class="glass-card" style="padding:1.75rem">
            <div style="width:44px;height:44px;border-radius:10px;background:rgba(74,222,128,.08);border:1px solid rgba(74,222,128,.15);display:flex;align-items:center;justify-content:center;margin-bottom:1.25rem">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4ADE80" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
            </div>
            <div style="font-size:.75rem;color:#94A3B8;margin-bottom:.35rem">How I Built This · Guest Segment</div>
            <h3 style="font-size:.9375rem;font-weight:600;color:#F8FAFC;margin-bottom:.5rem;line-height:1.4">"Leaving a Career That Looked Perfect — and Building One That Felt Real"</h3>
            <a href="#" style="font-size:.8125rem;color:#4ADE80;text-decoration:none">Listen →</a>
          </div>
          <div class="glass-card" style="padding:1.75rem">
            <div style="width:44px;height:44px;border-radius:10px;background:rgba(74,222,128,.08);border:1px solid rgba(74,222,128,.15);display:flex;align-items:center;justify-content:center;margin-bottom:1.25rem">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4ADE80" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
            </div>
            <div style="font-size:.75rem;color:#94A3B8;margin-bottom:.35rem">The Good Life Project</div>
            <h3 style="font-size:.9375rem;font-weight:600;color:#F8FAFC;margin-bottom:.5rem;line-height:1.4">"What Somatic Coaching Taught Me About Knowing What You Want"</h3>
            <a href="#" style="font-size:.8125rem;color:#4ADE80;text-decoration:none">Listen →</a>
          </div>
          <div class="glass-card" style="padding:1.75rem">
            <div style="width:44px;height:44px;border-radius:10px;background:rgba(74,222,128,.08);border:1px solid rgba(74,222,128,.15);display:flex;align-items:center;justify-content:center;margin-bottom:1.25rem">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4ADE80" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
            </div>
            <div style="font-size:.75rem;color:#94A3B8;margin-bottom:.35rem">Unlocking Us with Brené Brown</div>
            <h3 style="font-size:.9375rem;font-weight:600;color:#F8FAFC;margin-bottom:.5rem;line-height:1.4">"On Midlife, Meaning, and the Stories We Inherit"</h3>
            <a href="#" style="font-size:.8125rem;color:#4ADE80;text-decoration:none">Listen →</a>
          </div>
          <div class="glass-card" style="padding:1.75rem">
            <div style="width:44px;height:44px;border-radius:10px;background:rgba(74,222,128,.08);border:1px solid rgba(74,222,128,.15);display:flex;align-items:center;justify-content:center;margin-bottom:1.25rem">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4ADE80" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
            </div>
            <div style="font-size:.75rem;color:#94A3B8;margin-bottom:.35rem">Working It — BBC World Service</div>
            <h3 style="font-size:.9375rem;font-weight:600;color:#F8FAFC;margin-bottom:.5rem;line-height:1.4">"The Hidden Grief of Career Pivots"</h3>
            <a href="#" style="font-size:.8125rem;color:#4ADE80;text-decoration:none">Listen →</a>
          </div>
          <div class="glass-card" style="padding:1.75rem">
            <div style="width:44px;height:44px;border-radius:10px;background:rgba(74,222,128,.08);border:1px solid rgba(74,222,128,.15);display:flex;align-items:center;justify-content:center;margin-bottom:1.25rem">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4ADE80" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
            </div>
            <div style="font-size:.75rem;color:#94A3B8;margin-bottom:.35rem">On Being with Krista Tippett</div>
            <h3 style="font-size:.9375rem;font-weight:600;color:#F8FAFC;margin-bottom:.5rem;line-height:1.4">"Purpose, Pain, and the Long Work of Becoming"</h3>
            <a href="#" style="font-size:.8125rem;color:#4ADE80;text-decoration:none">Listen →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Workshop Materials & Awards -->
    <section class="section-pad" style="background:#0F172A;border-top:1px solid rgba(255,255,255,.05)">
      <div class="container">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:3rem;flex-wrap:wrap">
          <div>
            <h2 class="serif" style="font-size:clamp(1.5rem,2.5vw,2rem);font-weight:700;color:#F8FAFC;margin-bottom:2rem">Workshop Materials</h2>
            <div style="display:flex;flex-direction:column;gap:1rem">
              <div class="glass-card" style="padding:1.5rem;display:flex;gap:1rem;align-items:start">
                <div style="flex-shrink:0;width:36px;height:36px;border-radius:8px;background:rgba(74,222,128,.08);border:1px solid rgba(74,222,128,.15);display:flex;align-items:center;justify-content:center">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#4ADE80" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                </div>
                <div>
                  <div style="font-size:.875rem;font-weight:500;color:#F8FAFC;margin-bottom:.2rem">The Roots &amp; Direction Workbook</div>
                  <div style="font-size:.8125rem;color:#94A3B8">84-page self-guided companion to the flagship program</div>
                </div>
              </div>
              <div class="glass-card" style="padding:1.5rem;display:flex;gap:1rem;align-items:start">
                <div style="flex-shrink:0;width:36px;height:36px;border-radius:8px;background:rgba(74,222,128,.08);border:1px solid rgba(74,222,128,.15);display:flex;align-items:center;justify-content:center">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#4ADE80" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                </div>
                <div>
                  <div style="font-size:.875rem;font-weight:500;color:#F8FAFC;margin-bottom:.2rem">Values Mapping Exercise (Free Download)</div>
                  <div style="font-size:.8125rem;color:#94A3B8">Used by 8,000+ people to clarify what actually matters</div>
                </div>
              </div>
              <div class="glass-card" style="padding:1.5rem;display:flex;gap:1rem;align-items:start">
                <div style="flex-shrink:0;width:36px;height:36px;border-radius:8px;background:rgba(74,222,128,.08);border:1px solid rgba(74,222,128,.15);display:flex;align-items:center;justify-content:center">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#4ADE80" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                </div>
                <div>
                  <div style="font-size:.875rem;font-weight:500;color:#F8FAFC;margin-bottom:.2rem">Career Transition Field Guide</div>
                  <div style="font-size:.8125rem;color:#94A3B8">Step-by-step navigation from corporate exit to next chapter</div>
                </div>
              </div>
            </div>
          </div>
          <div>
            <h2 class="serif" style="font-size:clamp(1.5rem,2.5vw,2rem);font-weight:700;color:#F8FAFC;margin-bottom:2rem">Awards &amp; Recognition</h2>
            <div style="display:flex;flex-direction:column;gap:1rem">
              <div class="glass-card" style="padding:1.5rem;background:#1A3626;border-color:rgba(74,222,128,.15);display:flex;gap:1rem;align-items:start">
                <span style="font-size:1.5rem;flex-shrink:0">🏆</span>
                <div>
                  <div style="font-size:.875rem;font-weight:500;color:#F8FAFC;margin-bottom:.2rem">ICF Prism Award Nominee</div>
                  <div style="font-size:.8125rem;color:#94A3B8">Excellence in coaching within an organization — 2024</div>
                </div>
              </div>
              <div class="glass-card" style="padding:1.5rem;display:flex;gap:1rem;align-items:start">
                <span style="font-size:1.5rem;flex-shrink:0">🌟</span>
                <div>
                  <div style="font-size:.875rem;font-weight:500;color:#F8FAFC;margin-bottom:.2rem">Top Life Coach — Austin Business Journal</div>
                  <div style="font-size:.8125rem;color:#94A3B8">Readers' Choice Award 2023 &amp; 2024</div>
                </div>
              </div>
              <div class="glass-card" style="padding:1.5rem;display:flex;gap:1rem;align-items:start">
                <span style="font-size:1.5rem;flex-shrink:0">📣</span>
                <div>
                  <div style="font-size:.875rem;font-weight:500;color:#F8FAFC;margin-bottom:.2rem">TEDx Speaker</div>
                  <div style="font-size:.8125rem;color:#94A3B8">TEDx Austin 2023 — "The Courage to Not Know"</div>
                </div>
              </div>
              <div class="glass-card" style="padding:1.5rem;display:flex;gap:1rem;align-items:start">
                <span style="font-size:1.5rem;flex-shrink:0">✍️</span>
                <div>
                  <div style="font-size:.875rem;font-weight:500;color:#F8FAFC;margin-bottom:.2rem">Best Essay of 2023 — Substack Staff Pick</div>
                  <div style="font-size:.8125rem;color:#94A3B8">"On Grief as a Career Strategy"</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer style="padding:3rem 1.5rem;background:rgba(0,0,0,.3);border-top:1px solid rgba(255,255,255,.05)">
      <div class="container" style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:1.5rem">
        <div style="font-family:'Playfair Display',serif;font-size:1.25rem;font-weight:700;color:#F8FAFC;display:flex;align-items:center;gap:.35rem">Michael <span style="color:#4ADE80;font-size:.8rem">✦</span></div>
        <div style="display:flex;gap:1.5rem">
          <a href="#" style="color:#94A3B8"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a>
          <a href="#" style="color:#94A3B8"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg></a>
        </div>
        <p style="font-size:.8125rem;color:#94A3B8">© 2025 Michael Rivera. All rights reserved.</p>
      </div>
    </footer>
  </main>
</BaseLayout>
