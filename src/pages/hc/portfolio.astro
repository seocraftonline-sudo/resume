---
import BaseLayout from '../../layouts/Base.astro';
import HCNav from '../../components/HCNav.astro';
---
<BaseLayout title="Client Transformations — Michael Rivera" theme="hc">
  <link rel="stylesheet" href="/styles/rv.css" slot="head" />
  <HCNav active="portfolio" />

  <style>
    *{box-sizing:border-box}
    body{background:#0F172A;color:#F8FAFC;font-family:'Inter',sans-serif;overflow-x:hidden}
    .glass-card{background:rgba(255,255,255,.03);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.05);border-radius:24px}
    .section-pad{padding:6rem 1.5rem}
    .container{max-width:1280px;margin-inline:auto}
    .serif{font-family:'Playfair Display',serif}
    .btn-green{display:inline-flex;align-items:center;gap:.5rem;background:#4ADE80;color:#0F172A;font-weight:600;font-size:.9375rem;padding:.875rem 2rem;border-radius:9999px;text-decoration:none;transition:box-shadow .2s ease}
    .btn-green:hover{box-shadow:0 0 24px rgba(74,222,128,.4)}
    .filter-btn{padding:.5rem 1.25rem;border-radius:9999px;border:1px solid rgba(255,255,255,.1);background:transparent;color:#94A3B8;font-size:.8125rem;cursor:pointer;transition:all .2s ease;font-family:'Inter',sans-serif}
    .filter-btn.active,.filter-btn:hover{background:rgba(74,222,128,.1);border-color:rgba(74,222,128,.3);color:#F8FAFC}
    @media(max-width:767px){
      .cards-grid{grid-template-columns:1fr!important}
      .section-pad{padding:4rem 1.25rem}
    }
  </style>

  <main style="padding-top:5rem">

    <!-- Hero -->
    <section style="padding:6rem 1.5rem 4rem;background:linear-gradient(180deg,rgba(26,54,38,.9) 0%,rgba(15,23,42,1) 100%)">
      <div class="container" style="text-align:center;max-width:720px">
        <div style="display:inline-flex;align-items:center;gap:.5rem;padding:.375rem 1rem;border-radius:9999px;background:rgba(74,222,128,.08);border:1px solid rgba(74,222,128,.2);font-size:.8125rem;color:#94A3B8;margin-bottom:1.5rem">
          <span style="width:6px;height:6px;border-radius:50%;background:#4ADE80;display:inline-block"></span>
          Real People, Real Change
        </div>
        <h1 class="serif" style="font-size:clamp(2rem,4vw,3.5rem);font-weight:700;color:#F8FAFC;line-height:1.2;margin-bottom:1.25rem">Client Transformations</h1>
        <p style="color:#94A3B8;font-size:1.0625rem;line-height:1.75;max-width:560px;margin-inline:auto">
          These are real stories (names changed for privacy) from people who showed up, did the work, and changed the trajectory of their lives. I'm honored to share them.
        </p>
      </div>
    </section>

    <!-- Filter -->
    <section style="padding:2rem 1.5rem 0;background:#0F172A">
      <div class="container" style="display:flex;gap:.75rem;flex-wrap:wrap;justify-content:center" id="hc-filters">
        <button class="filter-btn active" data-filter="all">All</button>
        <button class="filter-btn" data-filter="career">Career</button>
        <button class="filter-btn" data-filter="life">Life</button>
        <button class="filter-btn" data-filter="relationships">Relationships</button>
        <button class="filter-btn" data-filter="purpose">Purpose</button>
      </div>
    </section>

    <!-- Case Studies -->
    <section class="section-pad" style="background:#0F172A">
      <div class="container">
        <div class="cards-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:1.75rem" id="hc-cases">

          <!-- Case 1 -->
          <div class="glass-card" data-cat="career" style="overflow:hidden;display:flex;flex-direction:column">
            <div style="padding:1.75rem 1.75rem 1.25rem;border-bottom:1px solid rgba(255,255,255,.05)">
              <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.25rem">
                <div style="width:52px;height:52px;border-radius:50%;background:linear-gradient(135deg,#1A3626,#0F2318);border:2px solid rgba(74,222,128,.3);display:flex;align-items:center;justify-content:center;font-family:'Playfair Display',serif;font-size:1.1rem;font-weight:700;color:#4ADE80">J.M.</div>
                <span style="padding:.25rem .75rem;background:rgba(74,222,128,.08);border:1px solid rgba(74,222,128,.2);border-radius:9999px;font-size:.75rem;color:#4ADE80">Career</span>
              </div>
              <h3 class="serif" style="font-size:1.15rem;font-weight:700;color:#F8FAFC;margin-bottom:.5rem">From Burnout to Breakthrough</h3>
              <p style="font-size:.8125rem;color:#94A3B8;line-height:1.6">Corporate attorney, 38. 12 years in a career that was consuming her identity. She came in exhausted and certain she had no options.</p>
            </div>
            <div style="padding:1.25rem 1.75rem;flex:1;display:flex;flex-direction:column">
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1.25rem">
                <div style="padding:1rem;background:rgba(255,255,255,.02);border-radius:12px;border:1px solid rgba(255,255,255,.05)">
                  <div style="font-size:.7rem;text-transform:uppercase;letter-spacing:.08em;color:#94A3B8;margin-bottom:.35rem">Challenge</div>
                  <div style="font-size:.8125rem;color:rgba(248,250,252,.8)">Chronic burnout, lost sense of self outside work</div>
                </div>
                <div style="padding:1rem;background:rgba(74,222,128,.04);border-radius:12px;border:1px solid rgba(74,222,128,.12)">
                  <div style="font-size:.7rem;text-transform:uppercase;letter-spacing:.08em;color:#4ADE80;margin-bottom:.35rem">Outcome</div>
                  <div style="font-size:.8125rem;color:rgba(248,250,252,.8)">Transitioned to in-house counsel, works 30% fewer hours</div>
                </div>
              </div>
              <blockquote style="font-size:.8125rem;font-style:italic;color:#94A3B8;line-height:1.65;border-left:2px solid rgba(74,222,128,.3);padding-left:.75rem;margin-top:auto">
                "Michael helped me realize I wasn't lazy — I was depleted. And depleted people need rest, not more discipline."
              </blockquote>
            </div>
          </div>

          <!-- Case 2 -->
          <div class="glass-card" data-cat="purpose" style="overflow:hidden;display:flex;flex-direction:column">
            <div style="padding:1.75rem 1.75rem 1.25rem;border-bottom:1px solid rgba(255,255,255,.05)">
              <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.25rem">
                <div style="width:52px;height:52px;border-radius:50%;background:linear-gradient(135deg,#1A3626,#0F2318);border:2px solid rgba(74,222,128,.3);display:flex;align-items:center;justify-content:center;font-family:'Playfair Display',serif;font-size:1.1rem;font-weight:700;color:#4ADE80">D.K.</div>
                <span style="padding:.25rem .75rem;background:rgba(74,222,128,.08);border:1px solid rgba(74,222,128,.2);border-radius:9999px;font-size:.75rem;color:#4ADE80">Purpose</span>
              </div>
              <h3 class="serif" style="font-size:1.15rem;font-weight:700;color:#F8FAFC;margin-bottom:.5rem">Finding Meaning After Success</h3>
              <p style="font-size:.8125rem;color:#94A3B8;line-height:1.6">Entrepreneur, 45. Built and sold two companies. Had everything — and felt nothing. The emptiness was terrifying to admit.</p>
            </div>
            <div style="padding:1.25rem 1.75rem;flex:1;display:flex;flex-direction:column">
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1.25rem">
                <div style="padding:1rem;background:rgba(255,255,255,.02);border-radius:12px;border:1px solid rgba(255,255,255,.05)">
                  <div style="font-size:.7rem;text-transform:uppercase;letter-spacing:.08em;color:#94A3B8;margin-bottom:.35rem">Challenge</div>
                  <div style="font-size:.8125rem;color:rgba(248,250,252,.8)">Existential emptiness despite external achievement</div>
                </div>
                <div style="padding:1rem;background:rgba(74,222,128,.04);border-radius:12px;border:1px solid rgba(74,222,128,.12)">
                  <div style="font-size:.7rem;text-transform:uppercase;letter-spacing:.08em;color:#4ADE80;margin-bottom:.35rem">Outcome</div>
                  <div style="font-size:.8125rem;color:rgba(248,250,252,.8)">Founded a non-profit, reconnected with family, reports genuine fulfillment</div>
                </div>
              </div>
              <blockquote style="font-size:.8125rem;font-style:italic;color:#94A3B8;line-height:1.65;border-left:2px solid rgba(74,222,128,.3);padding-left:.75rem;margin-top:auto">
                "I thought I was coming in to figure out my next business. I left figuring out my next life."
              </blockquote>
            </div>
          </div>

          <!-- Case 3 -->
          <div class="glass-card" data-cat="life" style="overflow:hidden;display:flex;flex-direction:column">
            <div style="padding:1.75rem 1.75rem 1.25rem;border-bottom:1px solid rgba(255,255,255,.05)">
              <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.25rem">
                <div style="width:52px;height:52px;border-radius:50%;background:linear-gradient(135deg,#1A3626,#0F2318);border:2px solid rgba(74,222,128,.3);display:flex;align-items:center;justify-content:center;font-family:'Playfair Display',serif;font-size:1.1rem;font-weight:700;color:#4ADE80">M.T.</div>
                <span style="padding:.25rem .75rem;background:rgba(74,222,128,.08);border:1px solid rgba(74,222,128,.2);border-radius:9999px;font-size:.75rem;color:#4ADE80">Life</span>
              </div>
              <h3 class="serif" style="font-size:1.15rem;font-weight:700;color:#F8FAFC;margin-bottom:.5rem">Rebuilding After Divorce</h3>
              <p style="font-size:.8125rem;color:#94A3B8;line-height:1.6">Teacher, 52. Eighteen-year marriage ended. She didn't know who she was without the role of "wife." The grief was layered and complicated.</p>
            </div>
            <div style="padding:1.25rem 1.75rem;flex:1;display:flex;flex-direction:column">
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1.25rem">
                <div style="padding:1rem;background:rgba(255,255,255,.02);border-radius:12px;border:1px solid rgba(255,255,255,.05)">
                  <div style="font-size:.7rem;text-transform:uppercase;letter-spacing:.08em;color:#94A3B8;margin-bottom:.35rem">Challenge</div>
                  <div style="font-size:.8125rem;color:rgba(248,250,252,.8)">Identity collapse after major life transition</div>
                </div>
                <div style="padding:1rem;background:rgba(74,222,128,.04);border-radius:12px;border:1px solid rgba(74,222,128,.12)">
                  <div style="font-size:.7rem;text-transform:uppercase;letter-spacing:.08em;color:#4ADE80;margin-bottom:.35rem">Outcome</div>
                  <div style="font-size:.8125rem;color:rgba(248,250,252,.8)">Rediscovered passions, stronger relationships with children, travel abroad</div>
                </div>
              </div>
              <blockquote style="font-size:.8125rem;font-style:italic;color:#94A3B8;line-height:1.65;border-left:2px solid rgba(74,222,128,.3);padding-left:.75rem;margin-top:auto">
                "I came in thinking I needed to survive. Michael helped me realize I could actually thrive."
              </blockquote>
            </div>
          </div>

          <!-- Case 4 -->
          <div class="glass-card" data-cat="relationships" style="overflow:hidden;display:flex;flex-direction:column">
            <div style="padding:1.75rem 1.75rem 1.25rem;border-bottom:1px solid rgba(255,255,255,.05)">
              <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.25rem">
                <div style="width:52px;height:52px;border-radius:50%;background:linear-gradient(135deg,#1A3626,#0F2318);border:2px solid rgba(74,222,128,.3);display:flex;align-items:center;justify-content:center;font-family:'Playfair Display',serif;font-size:1.1rem;font-weight:700;color:#4ADE80">R.L.</div>
                <span style="padding:.25rem .75rem;background:rgba(74,222,128,.08);border:1px solid rgba(74,222,128,.2);border-radius:9999px;font-size:.75rem;color:#4ADE80">Relationships</span>
              </div>
              <h3 class="serif" style="font-size:1.15rem;font-weight:700;color:#F8FAFC;margin-bottom:.5rem">Breaking the Pattern</h3>
              <p style="font-size:.8125rem;color:#94A3B8;line-height:1.6">Software engineer, 31. Third relationship ending the same way. Tired of repeating the same argument with a different person.</p>
            </div>
            <div style="padding:1.25rem 1.75rem;flex:1;display:flex;flex-direction:column">
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1.25rem">
                <div style="padding:1rem;background:rgba(255,255,255,.02);border-radius:12px;border:1px solid rgba(255,255,255,.05)">
                  <div style="font-size:.7rem;text-transform:uppercase;letter-spacing:.08em;color:#94A3B8;margin-bottom:.35rem">Challenge</div>
                  <div style="font-size:.8125rem;color:rgba(248,250,252,.8)">Recurring attachment patterns in relationships</div>
                </div>
                <div style="padding:1rem;background:rgba(74,222,128,.04);border-radius:12px;border:1px solid rgba(74,222,128,.12)">
                  <div style="font-size:.7rem;text-transform:uppercase;letter-spacing:.08em;color:#4ADE80;margin-bottom:.35rem">Outcome</div>
                  <div style="font-size:.8125rem;color:rgba(248,250,252,.8)">Deep self-awareness, healthier communication, 2-year relationship thriving</div>
                </div>
              </div>
              <blockquote style="font-size:.8125rem;font-style:italic;color:#94A3B8;line-height:1.65;border-left:2px solid rgba(74,222,128,.3);padding-left:.75rem;margin-top:auto">
                "The patterns were never about the other person. That was the hard truth — and the most liberating one."
              </blockquote>
            </div>
          </div>

          <!-- Case 5 -->
          <div class="glass-card" data-cat="career" style="overflow:hidden;display:flex;flex-direction:column">
            <div style="padding:1.75rem 1.75rem 1.25rem;border-bottom:1px solid rgba(255,255,255,.05)">
              <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.25rem">
                <div style="width:52px;height:52px;border-radius:50%;background:linear-gradient(135deg,#1A3626,#0F2318);border:2px solid rgba(74,222,128,.3);display:flex;align-items:center;justify-content:center;font-family:'Playfair Display',serif;font-size:1.1rem;font-weight:700;color:#4ADE80">A.W.</div>
                <span style="padding:.25rem .75rem;background:rgba(74,222,128,.08);border:1px solid rgba(74,222,128,.2);border-radius:9999px;font-size:.75rem;color:#4ADE80">Career</span>
              </div>
              <h3 class="serif" style="font-size:1.15rem;font-weight:700;color:#F8FAFC;margin-bottom:.5rem">The Leap Into Entrepreneurship</h3>
              <p style="font-size:.8125rem;color:#94A3B8;line-height:1.6">Graphic designer, 29. Dream of owning her studio. Fear of failure was keeping her in a comfortable but unfulfilling agency role.</p>
            </div>
            <div style="padding:1.25rem 1.75rem;flex:1;display:flex;flex-direction:column">
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1.25rem">
                <div style="padding:1rem;background:rgba(255,255,255,.02);border-radius:12px;border:1px solid rgba(255,255,255,.05)">
                  <div style="font-size:.7rem;text-transform:uppercase;letter-spacing:.08em;color:#94A3B8;margin-bottom:.35rem">Challenge</div>
                  <div style="font-size:.8125rem;color:rgba(248,250,252,.8)">Fear-based paralysis blocking meaningful risk</div>
                </div>
                <div style="padding:1rem;background:rgba(74,222,128,.04);border-radius:12px;border:1px solid rgba(74,222,128,.12)">
                  <div style="font-size:.7rem;text-transform:uppercase;letter-spacing:.08em;color:#4ADE80;margin-bottom:.35rem">Outcome</div>
                  <div style="font-size:.8125rem;color:rgba(248,250,252,.8)">Launched studio, 8 clients in first quarter, booked 3 months out</div>
                </div>
              </div>
              <blockquote style="font-size:.8125rem;font-style:italic;color:#94A3B8;line-height:1.65;border-left:2px solid rgba(74,222,128,.3);padding-left:.75rem;margin-top:auto">
                "Michael helped me see that the fear wasn't a stop sign. It was proof I actually cared about this."
              </blockquote>
            </div>
          </div>

          <!-- Case 6 -->
          <div class="glass-card" data-cat="life" style="overflow:hidden;display:flex;flex-direction:column">
            <div style="padding:1.75rem 1.75rem 1.25rem;border-bottom:1px solid rgba(255,255,255,.05)">
              <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.25rem">
                <div style="width:52px;height:52px;border-radius:50%;background:linear-gradient(135deg,#1A3626,#0F2318);border:2px solid rgba(74,222,128,.3);display:flex;align-items:center;justify-content:center;font-family:'Playfair Display',serif;font-size:1.1rem;font-weight:700;color:#4ADE80">P.N.</div>
                <span style="padding:.25rem .75rem;background:rgba(74,222,128,.08);border:1px solid rgba(74,222,128,.2);border-radius:9999px;font-size:.75rem;color:#4ADE80">Life</span>
              </div>
              <h3 class="serif" style="font-size:1.15rem;font-weight:700;color:#F8FAFC;margin-bottom:.5rem">Grieving and Moving Forward</h3>
              <p style="font-size:.8125rem;color:#94A3B8;line-height:1.6">Nurse, 44. Lost her father and her marriage in the same year. Processing both while maintaining her demanding career felt impossible.</p>
            </div>
            <div style="padding:1.25rem 1.75rem;flex:1;display:flex;flex-direction:column">
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1.25rem">
                <div style="padding:1rem;background:rgba(255,255,255,.02);border-radius:12px;border:1px solid rgba(255,255,255,.05)">
                  <div style="font-size:.7rem;text-transform:uppercase;letter-spacing:.08em;color:#94A3B8;margin-bottom:.35rem">Challenge</div>
                  <div style="font-size:.8125rem;color:rgba(248,250,252,.8)">Compounded grief and caregiver exhaustion</div>
                </div>
                <div style="padding:1rem;background:rgba(74,222,128,.04);border-radius:12px;border:1px solid rgba(74,222,128,.12)">
                  <div style="font-size:.7rem;text-transform:uppercase;letter-spacing:.08em;color:#4ADE80;margin-bottom:.35rem">Outcome</div>
                  <div style="font-size:.8125rem;color:rgba(248,250,252,.8)">Developed sustainable self-care, promoted to charge nurse, found joy again</div>
                </div>
              </div>
              <blockquote style="font-size:.8125rem;font-style:italic;color:#94A3B8;line-height:1.65;border-left:2px solid rgba(74,222,128,.3);padding-left:.75rem;margin-top:auto">
                "Being witnessed in my grief without being rushed through it — I didn't know how much I needed that."
              </blockquote>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section style="padding:5rem 1.5rem;background:linear-gradient(135deg,#1A3626 0%,#0F2318 100%);text-align:center">
      <div class="container" style="max-width:680px">
        <h2 class="serif" style="font-size:clamp(1.75rem,3.5vw,2.75rem);font-weight:700;color:#F8FAFC;margin-bottom:1.25rem">Your Story Could Be Next</h2>
        <p style="color:#94A3B8;line-height:1.7;margin-bottom:2.5rem">Every transformation starts with a single conversation. No pressure, no agenda.</p>
        <a href="/hc/contact/" class="btn-green">Start the Conversation</a>
      </div>
    </section>

    <!-- Footer -->
    <footer style="padding:3rem 1.5rem;background:rgba(0,0,0,.3);border-top:1px solid rgba(255,255,255,.05)">
      <div class="container" style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:1.5rem">
        <div style="font-family:'Playfair Display',serif;font-size:1.25rem;font-weight:700;color:#F8FAFC;display:flex;align-items:center;gap:.35rem">Michael <span style="color:#4ADE80;font-size:.8rem">✦</span></div>
        <div style="display:flex;gap:1.5rem">
          <a href="#" style="color:#94A3B8"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a>
          <a href="#" style="color:#94A3B8"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg></a>
        </div>
        <p style="font-size:.8125rem;color:#94A3B8">© 2025 Michael Rivera. All rights reserved.</p>
      </div>
    </footer>
  </main>

  <script>
    const filterBtns = document.querySelectorAll('[data-filter]');
    const cards = document.querySelectorAll('#hc-cases [data-cat]');
    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const filter = (btn as HTMLElement).dataset.filter;
        cards.forEach(card => {
          const el = card as HTMLElement;
          if (filter === 'all' || el.dataset.cat === filter) {
            el.style.display = '';
          } else {
            el.style.display = 'none';
          }
        });
      });
    });
  </script>
</BaseLayout>
