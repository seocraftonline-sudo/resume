---
import BaseLayout from '../../layouts/Base.astro';
import HCNav from '../../components/HCNav.astro';
---
<BaseLayout title="Resume — Michael Rivera" theme="hc">
  <link rel="stylesheet" href="/styles/rv.css" slot="head" />
  <HCNav active="resume" />

  <style>
    *{box-sizing:border-box}
    body{background:#0F172A;color:#F8FAFC;font-family:'Inter',sans-serif;overflow-x:hidden}
    .glass-card{background:rgba(255,255,255,.03);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.05);border-radius:24px}
    .section-pad{padding:6rem 1.5rem}
    .container{max-width:1280px;margin-inline:auto}
    .serif{font-family:'Playfair Display',serif}
    .btn-green{display:inline-flex;align-items:center;gap:.5rem;background:#4ADE80;color:#0F172A;font-weight:600;font-size:.9375rem;padding:.875rem 2rem;border-radius:9999px;text-decoration:none;transition:box-shadow .2s ease}
    .btn-green:hover{box-shadow:0 0 24px rgba(74,222,128,.4)}
    @media(max-width:767px){
      .resume-grid{grid-template-columns:1fr!important}
      .section-pad{padding:4rem 1.25rem}
    }
  </style>

  <main style="padding-top:5rem">

    <!-- Header -->
    <section style="padding:6rem 1.5rem 4rem;background:linear-gradient(180deg,rgba(26,54,38,.9) 0%,rgba(15,23,42,1) 100%)">
      <div class="container">
        <div style="display:flex;align-items:start;justify-content:space-between;flex-wrap:wrap;gap:2rem">
          <div>
            <div style="display:inline-flex;align-items:center;gap:.5rem;padding:.375rem 1rem;border-radius:9999px;background:rgba(74,222,128,.08);border:1px solid rgba(74,222,128,.2);font-size:.8125rem;color:#94A3B8;margin-bottom:1.5rem">Professional Background</div>
            <h1 class="serif" style="font-size:clamp(2rem,4vw,3.25rem);font-weight:700;color:#F8FAFC;line-height:1.2;margin-bottom:.75rem">Michael Rivera</h1>
            <p style="font-size:1.125rem;color:#4ADE80;font-weight:500;margin-bottom:.5rem">Life &amp; Career Coach · ICF-PCC Certified</p>
            <p style="color:#94A3B8;font-size:.9375rem">Austin, TX · michael@michaelrivera.co · (512) 555-0192</p>
          </div>
          <a href="#" class="btn-green">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Download CV
          </a>
        </div>
        <div style="margin-top:2rem;max-width:700px">
          <p style="color:#94A3B8;line-height:1.75;font-size:1rem">
            ICF-certified life and career coach with 8+ years helping individuals navigate transitions, rediscover purpose, and build lives that feel genuinely theirs. Trained in somatic coaching, ACT, and narrative therapy. Former marketing executive turned human-change practitioner.
          </p>
        </div>
      </div>
    </section>

    <!-- Main Content -->
    <section class="section-pad" style="background:#0F172A">
      <div class="container">
        <div class="resume-grid" style="display:grid;grid-template-columns:2fr 1fr;gap:3rem">

          <!-- Left: Experience -->
          <div>
            <h2 class="serif" style="font-size:1.5rem;font-weight:700;color:#F8FAFC;margin-bottom:2rem;padding-bottom:.75rem;border-bottom:1px solid rgba(255,255,255,.08)">Professional Experience</h2>

            <div style="display:flex;flex-direction:column;gap:2rem">

              <div>
                <div style="display:flex;align-items:start;justify-content:space-between;flex-wrap:wrap;gap:.5rem;margin-bottom:.75rem">
                  <div>
                    <h3 style="font-size:1rem;font-weight:600;color:#F8FAFC;margin-bottom:.2rem">Founder &amp; Head Coach</h3>
                    <div style="font-size:.875rem;color:#4ADE80">Michael Rivera Coaching</div>
                  </div>
                  <span style="font-size:.8125rem;color:#94A3B8;white-space:nowrap">2021 – Present</span>
                </div>
                <ul style="list-style:none;padding:0;display:flex;flex-direction:column;gap:.5rem">
                  <li style="display:flex;align-items:start;gap:.5rem;font-size:.875rem;color:#94A3B8;line-height:1.6"><span style="color:#4ADE80;margin-top:4px;flex-shrink:0">·</span>Built a full-time coaching practice serving 200+ clients across 15 countries</li>
                  <li style="display:flex;align-items:start;gap:.5rem;font-size:.875rem;color:#94A3B8;line-height:1.6"><span style="color:#4ADE80;margin-top:4px;flex-shrink:0">·</span>Launched the "Roots &amp; Direction" cohort program (120+ alumni)</li>
                  <li style="display:flex;align-items:start;gap:.5rem;font-size:.875rem;color:#94A3B8;line-height:1.6"><span style="color:#4ADE80;margin-top:4px;flex-shrink:0">·</span>Delivered workshops to corporate teams including tech startups and healthcare organizations</li>
                  <li style="display:flex;align-items:start;gap:.5rem;font-size:.875rem;color:#94A3B8;line-height:1.6"><span style="color:#4ADE80;margin-top:4px;flex-shrink:0">·</span>Published monthly essays on life transitions reaching 12,000+ subscribers</li>
                </ul>
              </div>

              <div style="border-top:1px solid rgba(255,255,255,.06);padding-top:2rem">
                <div style="display:flex;align-items:start;justify-content:space-between;flex-wrap:wrap;gap:.5rem;margin-bottom:.75rem">
                  <div>
                    <h3 style="font-size:1rem;font-weight:600;color:#F8FAFC;margin-bottom:.2rem">Associate Coach</h3>
                    <div style="font-size:.875rem;color:#4ADE80">BetterUp · Remote</div>
                  </div>
                  <span style="font-size:.8125rem;color:#94A3B8;white-space:nowrap">2018 – 2021</span>
                </div>
                <ul style="list-style:none;padding:0;display:flex;flex-direction:column;gap:.5rem">
                  <li style="display:flex;align-items:start;gap:.5rem;font-size:.875rem;color:#94A3B8;line-height:1.6"><span style="color:#4ADE80;margin-top:4px;flex-shrink:0">·</span>Coached 300+ sessions annually with professionals from Fortune 500 companies</li>
                  <li style="display:flex;align-items:start;gap:.5rem;font-size:.875rem;color:#94A3B8;line-height:1.6"><span style="color:#4ADE80;margin-top:4px;flex-shrink:0">·</span>Specialization in career transition, burnout recovery, and leadership development</li>
                  <li style="display:flex;align-items:start;gap:.5rem;font-size:.875rem;color:#94A3B8;line-height:1.6"><span style="color:#4ADE80;margin-top:4px;flex-shrink:0">·</span>Maintained 4.9/5 client satisfaction rating across entire tenure</li>
                </ul>
              </div>

              <div style="border-top:1px solid rgba(255,255,255,.06);padding-top:2rem">
                <div style="display:flex;align-items:start;justify-content:space-between;flex-wrap:wrap;gap:.5rem;margin-bottom:.75rem">
                  <div>
                    <h3 style="font-size:1rem;font-weight:600;color:#F8FAFC;margin-bottom:.2rem">Senior Marketing Manager</h3>
                    <div style="font-size:.875rem;color:#4ADE80">Dell Technologies · Austin, TX</div>
                  </div>
                  <span style="font-size:.8125rem;color:#94A3B8;white-space:nowrap">2013 – 2017</span>
                </div>
                <ul style="list-style:none;padding:0;display:flex;flex-direction:column;gap:.5rem">
                  <li style="display:flex;align-items:start;gap:.5rem;font-size:.875rem;color:#94A3B8;line-height:1.6"><span style="color:#4ADE80;margin-top:4px;flex-shrink:0">·</span>Led a team of 12 across B2B marketing campaigns generating $40M+ in pipeline</li>
                  <li style="display:flex;align-items:start;gap:.5rem;font-size:.875rem;color:#94A3B8;line-height:1.6"><span style="color:#4ADE80;margin-top:4px;flex-shrink:0">·</span>This role taught me everything I needed to know about what success without fulfillment feels like — which became the foundation of my coaching philosophy</li>
                </ul>
              </div>
            </div>

            <!-- Approach/Methodology -->
            <h2 class="serif" style="font-size:1.5rem;font-weight:700;color:#F8FAFC;margin-top:3rem;margin-bottom:2rem;padding-bottom:.75rem;border-bottom:1px solid rgba(255,255,255,.08)">Coaching Approach</h2>
            <div class="glass-card" style="padding:2rem;background:#1A3626;border-color:rgba(74,222,128,.15)">
              <p style="font-size:.9375rem;color:#94A3B8;line-height:1.75;margin-bottom:1.25rem">My approach integrates insights from <strong style="color:rgba(248,250,252,.85)">Acceptance &amp; Commitment Therapy (ACT)</strong>, somatic coaching, and narrative therapy. I believe lasting change comes from expanding psychological flexibility — learning to hold discomfort while moving toward what genuinely matters.</p>
              <p style="font-size:.9375rem;color:#94A3B8;line-height:1.75">Sessions are non-directive but purposeful. I ask hard questions, hold space for silence, and trust the process of emergence over the seduction of quick fixes.</p>
            </div>

            <!-- Media -->
            <h2 class="serif" style="font-size:1.5rem;font-weight:700;color:#F8FAFC;margin-top:3rem;margin-bottom:2rem;padding-bottom:.75rem;border-bottom:1px solid rgba(255,255,255,.08)">Media &amp; Speaking</h2>
            <div style="display:flex;flex-direction:column;gap:1rem">
              <div class="glass-card" style="padding:1.25rem 1.5rem;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.75rem">
                <div>
                  <div style="font-size:.875rem;font-weight:500;color:#F8FAFC">TEDx Austin: "The Courage to Not Know"</div>
                  <div style="font-size:.8125rem;color:#94A3B8">2023 · 18 min · 140k views</div>
                </div>
                <span style="padding:.25rem .75rem;background:rgba(74,222,128,.08);border:1px solid rgba(74,222,128,.2);border-radius:9999px;font-size:.75rem;color:#4ADE80">Talk</span>
              </div>
              <div class="glass-card" style="padding:1.25rem 1.5rem;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.75rem">
                <div>
                  <div style="font-size:.875rem;font-weight:500;color:#F8FAFC">The Tim Ferriss Show — Guest Episode</div>
                  <div style="font-size:.8125rem;color:#94A3B8">2022 · Episode #601</div>
                </div>
                <span style="padding:.25rem .75rem;background:rgba(74,222,128,.08);border:1px solid rgba(74,222,128,.2);border-radius:9999px;font-size:.75rem;color:#4ADE80">Podcast</span>
              </div>
              <div class="glass-card" style="padding:1.25rem 1.5rem;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.75rem">
                <div>
                  <div style="font-size:.875rem;font-weight:500;color:#F8FAFC">Wisdom 2.0 Conference — Keynote</div>
                  <div style="font-size:.8125rem;color:#94A3B8">2023 · San Francisco</div>
                </div>
                <span style="padding:.25rem .75rem;background:rgba(74,222,128,.08);border:1px solid rgba(74,222,128,.2);border-radius:9999px;font-size:.75rem;color:#4ADE80">Keynote</span>
              </div>
            </div>
          </div>

          <!-- Right: Education, Certs -->
          <div>
            <h2 class="serif" style="font-size:1.5rem;font-weight:700;color:#F8FAFC;margin-bottom:2rem;padding-bottom:.75rem;border-bottom:1px solid rgba(255,255,255,.08)">Education</h2>
            <div style="display:flex;flex-direction:column;gap:1.25rem;margin-bottom:3rem">
              <div class="glass-card" style="padding:1.5rem">
                <div style="font-size:.9rem;font-weight:600;color:#F8FAFC;margin-bottom:.25rem">M.A. Counseling Psychology</div>
                <div style="font-size:.8125rem;color:#4ADE80;margin-bottom:.2rem">University of Texas at Austin</div>
                <div style="font-size:.8125rem;color:#94A3B8">2016</div>
              </div>
              <div class="glass-card" style="padding:1.5rem">
                <div style="font-size:.9rem;font-weight:600;color:#F8FAFC;margin-bottom:.25rem">B.S. Business Administration</div>
                <div style="font-size:.8125rem;color:#4ADE80;margin-bottom:.2rem">Texas A&amp;M University</div>
                <div style="font-size:.8125rem;color:#94A3B8">2010 · Dean's List</div>
              </div>
            </div>

            <h2 class="serif" style="font-size:1.5rem;font-weight:700;color:#F8FAFC;margin-bottom:2rem;padding-bottom:.75rem;border-bottom:1px solid rgba(255,255,255,.08)">Certifications</h2>
            <div style="display:flex;flex-direction:column;gap:.75rem;margin-bottom:3rem">
              <div style="display:flex;align-items:center;gap:.75rem;font-size:.875rem;color:rgba(248,250,252,.8)">
                <span style="width:8px;height:8px;border-radius:50%;background:#4ADE80;flex-shrink:0"></span>ICF Professional Certified Coach (PCC)
              </div>
              <div style="display:flex;align-items:center;gap:.75rem;font-size:.875rem;color:rgba(248,250,252,.8)">
                <span style="width:8px;height:8px;border-radius:50%;background:#4ADE80;flex-shrink:0"></span>Somatic Coaching — Strozzi Institute
              </div>
              <div style="display:flex;align-items:center;gap:.75rem;font-size:.875rem;color:rgba(248,250,252,.8)">
                <span style="width:8px;height:8px;border-radius:50%;background:#4ADE80;flex-shrink:0"></span>ACT Practitioner — ACBS
              </div>
              <div style="display:flex;align-items:center;gap:.75rem;font-size:.875rem;color:rgba(248,250,252,.8)">
                <span style="width:8px;height:8px;border-radius:50%;background:#4ADE80;flex-shrink:0"></span>Narrative Therapy Foundations
              </div>
              <div style="display:flex;align-items:center;gap:.75rem;font-size:.875rem;color:rgba(248,250,252,.8)">
                <span style="width:8px;height:8px;border-radius:50%;background:#4ADE80;flex-shrink:0"></span>Positive Psychology — UPenn
              </div>
            </div>

            <h2 class="serif" style="font-size:1.5rem;font-weight:700;color:#F8FAFC;margin-bottom:2rem;padding-bottom:.75rem;border-bottom:1px solid rgba(255,255,255,.08)">Key Numbers</h2>
            <div style="display:flex;flex-direction:column;gap:1rem">
              <div class="glass-card" style="padding:1.25rem;text-align:center;background:#1A3626;border-color:rgba(74,222,128,.15)">
                <div class="serif" style="font-size:2rem;font-weight:700;color:#F8FAFC">200+</div>
                <div style="font-size:.8125rem;color:#94A3B8">Clients Coached</div>
              </div>
              <div class="glass-card" style="padding:1.25rem;text-align:center">
                <div class="serif" style="font-size:2rem;font-weight:700;color:#F8FAFC">1,200+</div>
                <div style="font-size:.8125rem;color:#94A3B8">Sessions Delivered</div>
              </div>
              <div class="glass-card" style="padding:1.25rem;text-align:center">
                <div class="serif" style="font-size:2rem;font-weight:700;color:#F8FAFC">15</div>
                <div style="font-size:.8125rem;color:#94A3B8">Countries Served</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer style="padding:3rem 1.5rem;background:rgba(0,0,0,.3);border-top:1px solid rgba(255,255,255,.05)">
      <div class="container" style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:1.5rem">
        <div style="font-family:'Playfair Display',serif;font-size:1.25rem;font-weight:700;color:#F8FAFC;display:flex;align-items:center;gap:.35rem">Michael <span style="color:#4ADE80;font-size:.8rem">✦</span></div>
        <div style="display:flex;gap:1.5rem">
          <a href="#" style="color:#94A3B8"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a>
          <a href="#" style="color:#94A3B8"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg></a>
        </div>
        <p style="font-size:.8125rem;color:#94A3B8">© 2025 Michael Rivera. All rights reserved.</p>
      </div>
    </footer>
  </main>
</BaseLayout>
