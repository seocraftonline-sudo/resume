---
import BaseLayout from '../../layouts/Base.astro';
import QGNav from '../../components/QGNav.astro';
---
<BaseLayout title="Blog — Alex Law" theme="qg">
  <Fragment slot="head">
    <link rel="stylesheet" href="/styles/rv.css" />
    <style>
      .deco{position:fixed;border-radius:50%;pointer-events:none;z-index:0}
      .deco1{width:40%;height:40%;top:-10%;left:-10%;background:radial-gradient(circle,rgba(238,242,255,.5) 0%,transparent 70%);filter:blur(60px)}
      .deco2{width:50%;height:50%;bottom:-10%;right:-5%;background:radial-gradient(circle,rgba(245,243,255,.4) 0%,transparent 70%);filter:blur(60px)}
      .blog-card{background:#fff;border-radius:24px;border:1px solid rgba(229,231,235,.6);box-shadow:0 4px 20px -2px rgba(0,0,0,.05);overflow:hidden;transition:all .3s ease;cursor:pointer;display:flex;flex-direction:column}
      .blog-card:hover{transform:translateY(-4px);box-shadow:0 12px 40px -8px rgba(0,0,0,.1)}
      .blog-img{height:240px;overflow:hidden}
      .blog-img img{width:100%;height:100%;object-fit:cover;transition:transform .6s ease}
      .blog-card:hover .blog-img img{transform:scale(1.05)}
      .tag-pill{font-size:.65rem;text-transform:uppercase;letter-spacing:.1em;color:#6B7280;border:1px solid #E5E7EB;padding:.2rem .7rem;border-radius:999px;display:inline-block}
    </style>
  </Fragment>
  <div class="deco deco1"></div>
  <div class="deco deco2"></div>
  <QGNav active="blog" />

  <main style="padding-top:5rem;position:relative;z-index:1">
    <div style="max-width:1440px;margin-inline:auto;padding:5rem 1.5rem 6rem;display:flex;flex-direction:column;gap:4rem">

      <!-- Header -->
      <section style="border-bottom:1px solid #E5E7EB;padding-bottom:3rem">
        <h1 style="font-family:'Playfair Display',serif;font-size:clamp(2.5rem,6vw,4rem);font-weight:500;line-height:1.1;letter-spacing:-.03em;color:#111827;margin-bottom:1rem">Insights &amp; Observations</h1>
        <p style="font-size:1.125rem;color:#6B7280;font-weight:300;max-width:560px;line-height:1.7">Long-form thinking on design, product, and the slow craft of making things that last.</p>
      </section>

      <!-- Featured -->
      <section>
        <p style="font-size:.65rem;color:#6B7280;text-transform:uppercase;letter-spacing:.12em;margin-bottom:1.5rem">Featured Post</p>
        <div style="background:#fff;border-radius:32px;border:1px solid rgba(229,231,235,.6);box-shadow:0 4px 20px -2px rgba(0,0,0,.05);overflow:hidden;display:grid;grid-template-columns:1fr 1fr;cursor:pointer;transition:all .3s ease" onmouseover="this.style.boxShadow='0 16px 48px -12px rgba(0,0,0,.12)'" onmouseout="this.style.boxShadow='0 4px 20px -2px rgba(0,0,0,.05)'">
          <div style="height:100%;min-height:400px;overflow:hidden">
            <img src="https://images.pexels.com/photos/3183150/pexels-photo-3183150.jpeg?auto=compress&cs=tinysrgb&w=900" alt="Featured post" style="width:100%;height:100%;object-fit:cover" loading="eager" />
          </div>
          <div style="padding:clamp(2rem,4vw,3.5rem);display:flex;flex-direction:column;gap:1.5rem">
            <div style="display:flex;align-items:center;gap:.75rem">
              <span class="tag-pill">Design</span>
              <span style="font-size:.75rem;color:#6B7280">Oct 12, 2023 &mdash; 8 min read</span>
            </div>
            <h2 style="font-family:'Playfair Display',serif;font-size:clamp(1.5rem,3vw,2rem);font-weight:400;color:#111827;line-height:1.3">The Architecture of Silence in UI</h2>
            <p style="font-size:.9375rem;color:#6B7280;line-height:1.75;font-weight:300">Why removing elements is harder than adding them, and what negative space can teach us about human cognition, trust, and the quiet power of restraint in digital design.</p>
            <a href="#" style="display:inline-flex;align-items:center;gap:.5rem;font-size:.875rem;font-weight:500;color:#111827;margin-top:auto">
              Read Article
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          </div>
        </div>
      </section>

      <!-- Blog Grid -->
      <section>
        <p style="font-size:.65rem;color:#6B7280;text-transform:uppercase;letter-spacing:.12em;margin-bottom:1.5rem">Recent Posts</p>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.5rem">
          <div class="blog-card">
            <div class="blog-img"><img src="https://images.pexels.com/photos/3184298/pexels-photo-3184298.jpeg?auto=compress&cs=tinysrgb&w=700" alt="Designing for Trust" loading="lazy" /></div>
            <div style="padding:1.5rem;display:flex;flex-direction:column;gap:1rem;flex:1">
              <div style="display:flex;justify-content:space-between;align-items:center"><span class="tag-pill">Trust &amp; UX</span><span style="font-size:.72rem;color:#6B7280">Sep 28, 2023</span></div>
              <h3 style="font-family:'Playfair Display',serif;font-size:1.25rem;font-weight:400;color:#111827;line-height:1.35">Designing for Trust</h3>
              <p style="font-size:.875rem;color:#6B7280;line-height:1.7;flex:1">Visual cues that communicate institutional stability — a study of what makes users feel safe in digital environments.</p>
              <a href="#" style="font-size:.8125rem;font-weight:500;color:#111827;display:inline-flex;align-items:center;gap:.4rem;margin-top:.5rem">Read <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
            </div>
          </div>
          <div class="blog-card">
            <div class="blog-img"><img src="https://images.pexels.com/photos/196644/pexels-photo-196644.jpeg?auto=compress&cs=tinysrgb&w=700" alt="Typography as Hierarchy" loading="lazy" /></div>
            <div style="padding:1.5rem;display:flex;flex-direction:column;gap:1rem;flex:1">
              <div style="display:flex;justify-content:space-between;align-items:center"><span class="tag-pill">Typography</span><span style="font-size:.72rem;color:#6B7280">Sep 05, 2023</span></div>
              <h3 style="font-family:'Playfair Display',serif;font-size:1.25rem;font-weight:400;color:#111827;line-height:1.35">Typography as Hierarchy</h3>
              <p style="font-size:.875rem;color:#6B7280;line-height:1.7;flex:1">Structuring information without relying on borders or dividers — how typographic rhythm can replace visual noise.</p>
              <a href="#" style="font-size:.8125rem;font-weight:500;color:#111827;display:inline-flex;align-items:center;gap:.4rem;margin-top:.5rem">Read <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
            </div>
          </div>
          <div class="blog-card">
            <div class="blog-img"><img src="https://images.pexels.com/photos/265087/pexels-photo-265087.jpeg?auto=compress&cs=tinysrgb&w=700" alt="The Fintech Aesthetic" loading="lazy" /></div>
            <div style="padding:1.5rem;display:flex;flex-direction:column;gap:1rem;flex:1">
              <div style="display:flex;justify-content:space-between;align-items:center"><span class="tag-pill">Fintech</span><span style="font-size:.72rem;color:#6B7280">Aug 14, 2023</span></div>
              <h3 style="font-family:'Playfair Display',serif;font-size:1.25rem;font-weight:400;color:#111827;line-height:1.35">The Fintech Aesthetic</h3>
              <p style="font-size:.875rem;color:#6B7280;line-height:1.7;flex:1">Why the best financial interfaces borrow more from Swiss design than from Silicon Valley's default playbook.</p>
              <a href="#" style="font-size:.8125rem;font-weight:500;color:#111827;display:inline-flex;align-items:center;gap:.4rem;margin-top:.5rem">Read <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
            </div>
          </div>
        </div>
      </section>

      <!-- Newsletter -->
      <section style="background:#111827;border-radius:32px;padding:clamp(2.5rem,5vw,4rem);display:flex;flex-direction:column;align-items:center;text-align:center;gap:1.5rem">
        <h2 style="font-family:'Playfair Display',serif;font-size:clamp(1.5rem,3vw,2.25rem);font-weight:400;color:#fff">Subscribe to the newsletter</h2>
        <p style="font-size:.9375rem;color:rgba(255,255,255,.55);font-weight:300;max-width:400px;line-height:1.65">Long-form essays, rare thoughts, and the occasional recommendation. No frequency promises.</p>
        <form style="display:flex;gap:.75rem;flex-wrap:wrap;justify-content:center;width:100%;max-width:480px" onsubmit="this.innerHTML='<p style=\'color:rgba(255,255,255,.8);font-size:.875rem\'>You\'re subscribed.</p>';return false">
          <input type="email" placeholder="your@email.com" required style="flex:1;min-width:200px;padding:.875rem 1.25rem;border-radius:12px;border:1px solid rgba(255,255,255,.1);background:rgba(255,255,255,.05);color:#fff;font-size:.875rem;font-family:'Inter',sans-serif;outline:none" />
          <button type="submit" style="padding:.875rem 1.75rem;background:#fff;color:#111827;border:none;border-radius:12px;font-size:.875rem;font-weight:500;cursor:pointer;font-family:'Inter',sans-serif;white-space:nowrap">Subscribe</button>
        </form>
      </section>

    </div>
  </main>

  <footer style="border-top:1px solid #E5E7EB;background:#F9FAFB;padding:2rem 0">
    <div style="max-width:1440px;margin-inline:auto;padding-inline:1.5rem"><p style="font-size:.75rem;color:#6B7280">&copy; 2025 Alex Law. All rights reserved.</p></div>
  </footer>
</BaseLayout>
