---
import BaseLayout from '../../layouts/Base.astro';
import QGNav from '../../components/QGNav.astro';
---
<BaseLayout title="Contact — Alex Law" theme="qg">
  <Fragment slot="head">
    <link rel="stylesheet" href="/styles/rv.css" />
    <style>
      .deco{position:fixed;border-radius:50%;pointer-events:none;z-index:0}
      .deco1{width:40%;height:40%;top:-10%;left:-10%;background:radial-gradient(circle,rgba(238,242,255,.5) 0%,transparent 70%);filter:blur(60px)}
      .deco2{width:50%;height:50%;bottom:-10%;right:-5%;background:radial-gradient(circle,rgba(245,243,255,.4) 0%,transparent 70%);filter:blur(60px)}
      .fl-wrap{position:relative}
      .fl-input{width:100%;background:transparent;border:none;border-bottom:1px solid #E5E7EB;padding:1.5rem 0 .5rem;font-size:1rem;color:#111827;transition:border-color .3s ease;font-family:'Inter',sans-serif;outline:none}
      .fl-input:focus{border-bottom-color:#111827}
      .fl-label{position:absolute;left:0;top:1.5rem;color:#6B7280;font-size:1rem;font-weight:300;pointer-events:none;transition:all .3s ease}
      .fl-input:focus~.fl-label,.fl-input:not(:placeholder-shown)~.fl-label{top:0;font-size:.75rem;color:#111827;font-weight:500;text-transform:uppercase;letter-spacing:.05em}
      .fl-textarea{width:100%;background:transparent;border:none;border-bottom:1px solid #E5E7EB;padding:.75rem 0;font-size:1rem;color:#111827;transition:border-color .3s ease;font-family:'Inter',sans-serif;outline:none;resize:none}
      .fl-textarea:focus{border-bottom-color:#111827}
      .ping-dot{width:.5rem;height:.5rem;border-radius:50%;background:#111827;position:relative}
      .ping-dot::after{content:'';position:absolute;inset:0;border-radius:50%;background:#111827;animation:ping .9s cubic-bezier(0,0,.2,1) infinite;opacity:.75}
      @keyframes ping{75%,100%{transform:scale(2);opacity:0}}
      @media(max-width:767px){.contact-grid{grid-template-columns:1fr!important}.form-name-row{grid-template-columns:1fr!important}}
    </style>
  </Fragment>
  <div class="deco deco1"></div>
  <div class="deco deco2"></div>
  <QGNav active="contact" />

  <main style="padding-top:5rem;position:relative;z-index:1">
    <div style="max-width:1440px;margin-inline:auto;padding:5rem 1.5rem 6rem;display:flex;flex-direction:column;gap:4rem">

      <!-- Hero -->
      <section style="max-width:900px">
        <h1 style="font-family:'Playfair Display',serif;font-size:clamp(2.5rem,7vw,5rem);font-weight:500;line-height:1.05;letter-spacing:-.03em;color:#111827;margin-bottom:1.5rem">Let&rsquo;s build something intentional.</h1>
        <p style="font-size:1.125rem;color:#6B7280;font-weight:300;line-height:1.75;max-width:600px;margin-bottom:2rem">I am always open to discussing new projects, creative ideas or opportunities to be part of your visions. Whether you have a specific brief or just a rough concept, the conversation starts here.</p>
        <div style="display:flex;align-items:center;gap:1rem">
          <div style="display:flex;align-items:center;gap:.6rem"><div class="ping-dot"></div><span style="font-size:.8125rem;font-weight:500;text-transform:uppercase;letter-spacing:.1em;color:#111827">Currently Available</span></div>
          <span style="color:rgba(107,114,128,.4)">|</span>
          <span style="font-size:.8125rem;color:#6B7280;font-weight:300">Accepting projects for Q4 2025</span>
        </div>
      </section>

      <!-- Main Hub -->
      <section style="background:#fff;border-radius:32px;border:1px solid rgba(229,231,235,.6);box-shadow:0 4px 20px -2px rgba(0,0,0,.05);overflow:hidden">
        <div class="contact-grid" style="display:grid;grid-template-columns:3fr 2fr">

          <!-- Form -->
          <div style="padding:clamp(2rem,5vw,5rem);border-right:1px solid rgba(229,231,235,.5)">
            <div style="margin-bottom:3rem">
              <p style="font-size:.65rem;font-weight:500;color:#6B7280;text-transform:uppercase;letter-spacing:.12em;margin-bottom:.35rem">Send a message</p>
              <p style="font-size:.8125rem;color:#6B7280;font-weight:300">Typical response time: 24-48 hours.</p>
            </div>
            <form id="contact-form" style="display:flex;flex-direction:column;gap:2rem">
              <div class="form-name-row" style="display:grid;grid-template-columns:1fr 1fr;gap:2rem">
                <div class="fl-wrap"><input type="text" id="name" class="fl-input" placeholder=" " required /><label for="name" class="fl-label">Full Name</label></div>
                <div class="fl-wrap"><input type="email" id="email" class="fl-input" placeholder=" " required /><label for="email" class="fl-label">Email Address</label></div>
              </div>
              <div class="fl-wrap"><input type="text" id="company" class="fl-input" placeholder=" " /><label for="company" class="fl-label">Company / Organization (Optional)</label></div>
              <div class="fl-wrap"><input type="text" id="subject" class="fl-input" placeholder=" " required /><label for="subject" class="fl-label">Subject / Nature of Enquiry</label></div>
              <div style="padding-top:1rem">
                <textarea id="message" rows="4" class="fl-textarea" placeholder="Tell me about your project, timeline, and expectations..." required></textarea>
              </div>
              <div style="display:flex;justify-content:flex-end;padding-top:1rem">
                <button type="submit" style="display:inline-flex;align-items:center;gap:.75rem;padding:.9rem 2rem;border-radius:999px;background:#111827;color:#F9FAFB;font-size:.875rem;font-weight:500;border:none;cursor:pointer;transition:all .2s ease;font-family:'Inter',sans-serif">
                  Submit Enquiry
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </button>
              </div>
            </form>
            <div id="form-success" style="display:none;padding:1.5rem;background:#F0FDF4;border:1px solid #BBF7D0;border-radius:16px;color:#166534;font-size:.875rem;margin-top:1rem">Message sent successfully! I'll get back to you within 24-48 hours.</div>
          </div>

          <!-- Details -->
          <div style="padding:clamp(2rem,5vw,5rem);background:rgba(249,250,251,.5);display:flex;flex-direction:column;gap:3rem">
            <div>
              <h3 style="font-size:.65rem;font-weight:500;color:#6B7280;text-transform:uppercase;letter-spacing:.12em;margin-bottom:1rem">Direct Contact</h3>
              <div style="display:flex;flex-direction:column;gap:.75rem">
                <a href="mailto:hello@alexlaw.design" style="display:flex;align-items:center;gap:.75rem;font-size:.9375rem;color:#111827;transition:color .2s ease">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                  hello@alexlaw.design
                </a>
                <a href="tel:+15551234567" style="display:flex;align-items:center;gap:.75rem;font-size:.9375rem;color:#111827;transition:color .2s ease">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.44 2 2 0 0 1 3.58 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.16 6.16l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                  +1 (555) 123-4567
                </a>
              </div>
            </div>
            <div>
              <h3 style="font-size:.65rem;font-weight:500;color:#6B7280;text-transform:uppercase;letter-spacing:.12em;margin-bottom:1rem">Location</h3>
              <p style="font-size:.9375rem;color:#111827;line-height:1.6">New York, NY<br/><span style="color:#6B7280;font-size:.875rem">Available for remote and select on-site engagements worldwide.</span></p>
            </div>
            <div>
              <h3 style="font-size:.65rem;font-weight:500;color:#6B7280;text-transform:uppercase;letter-spacing:.12em;margin-bottom:1rem">Connect</h3>
              <div style="display:flex;gap:1rem">
                <a href="#" aria-label="LinkedIn" style="width:2.25rem;height:2.25rem;border-radius:50%;background:#fff;border:1px solid #E5E7EB;display:flex;align-items:center;justify-content:center;color:#6B7280;transition:all .2s ease" onmouseover="this.style.color='#111827';this.style.borderColor='#111827'" onmouseout="this.style.color='#6B7280';this.style.borderColor='#E5E7EB'"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg></a>
                <a href="#" aria-label="Twitter/X" style="width:2.25rem;height:2.25rem;border-radius:50%;background:#fff;border:1px solid #E5E7EB;display:flex;align-items:center;justify-content:center;color:#6B7280;transition:all .2s ease" onmouseover="this.style.color='#111827';this.style.borderColor='#111827'" onmouseout="this.style.color='#6B7280';this.style.borderColor='#E5E7EB'"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/></svg></a>
                <a href="#" aria-label="Dribbble" style="width:2.25rem;height:2.25rem;border-radius:50%;background:#fff;border:1px solid #E5E7EB;display:flex;align-items:center;justify-content:center;color:#6B7280;transition:all .2s ease" onmouseover="this.style.color='#111827';this.style.borderColor='#111827'" onmouseout="this.style.color='#6B7280';this.style.borderColor='#E5E7EB'"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M8.56 2.75c4.37 6.03 6.02 9.42 8.03 17.72m2.54-15.38c-3.72 4.35-8.94 5.66-16.88 5.85m19.5 1.9c-3.5-.93-6.63-.82-8.94 0-2.58.92-5.01 2.86-7.44 6.32"/></svg></a>
              </div>
            </div>
            <div style="background:#fff;border-radius:16px;border:1px solid #E5E7EB;padding:1.5rem">
              <p style="font-size:.65rem;color:#6B7280;text-transform:uppercase;letter-spacing:.1em;margin-bottom:.75rem">Book a Call</p>
              <a href="#" style="display:flex;align-items:center;justify-content:space-between;font-size:.875rem;color:#111827;font-weight:500;transition:color .2s ease">
                Schedule 30-min intro
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
            </div>
          </div>
        </div>
      </section>

    </div>
  </main>

  <footer style="border-top:1px solid #E5E7EB;background:#F9FAFB;padding:2rem 0">
    <div style="max-width:1440px;margin-inline:auto;padding-inline:1.5rem;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:1rem">
      <p style="font-size:.75rem;color:#6B7280">&copy; 2025 Alex Law. All rights reserved.</p>
    </div>
  </footer>

  <Fragment slot="scripts">
    <script>
      const form = document.getElementById('contact-form') as HTMLFormElement;
      const success = document.getElementById('form-success') as HTMLElement;
      if (form && success) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          form.style.opacity = '0';
          setTimeout(() => { form.style.display = 'none'; success.style.display = 'block'; }, 300);
        });
      }
    </script>
  </Fragment>
</BaseLayout>
