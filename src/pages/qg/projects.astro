---
import BaseLayout from '../../layouts/Base.astro';
import QGNav from '../../components/QGNav.astro';
---
<BaseLayout title="Projects — Alex Law" theme="qg">
  <Fragment slot="head">
    <link rel="stylesheet" href="/styles/rv.css" />
    <style>
      .deco{position:fixed;border-radius:50%;pointer-events:none;z-index:0}
      .deco1{width:40%;height:40%;top:-10%;left:-10%;background:radial-gradient(circle,rgba(238,242,255,.5) 0%,transparent 70%);filter:blur(60px)}
      .deco2{width:50%;height:50%;bottom:-10%;right:-5%;background:radial-gradient(circle,rgba(245,243,255,.4) 0%,transparent 70%);filter:blur(60px)}
      .arc-card{background:rgba(255,255,255,.8);backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,.3);border-radius:20px;padding:1.5rem;box-shadow:0 4px 20px -2px rgba(0,0,0,.05);display:flex;gap:1.25rem;transition:all .3s ease;cursor:pointer}
      .arc-card:hover{transform:translateX(4px);box-shadow:0 8px 32px -8px rgba(0,0,0,.08)}
      .arc-thumb{width:5rem;height:5rem;border-radius:12px;overflow:hidden;flex-shrink:0}
      .arc-thumb img{width:100%;height:100%;object-fit:cover}
    </style>
  </Fragment>
  <div class="deco deco1"></div>
  <div class="deco deco2"></div>
  <QGNav active="projects" />

  <main style="padding-top:5rem;position:relative;z-index:1">
    <div style="max-width:1440px;margin-inline:auto;padding:5rem 1.5rem 6rem;display:flex;flex-direction:column;gap:4rem">

      <!-- Header -->
      <section style="border-bottom:1px solid #E5E7EB;padding-bottom:3rem">
        <h1 style="font-family:'Playfair Display',serif;font-size:clamp(2.5rem,6vw,4rem);font-weight:500;line-height:1.1;letter-spacing:-.03em;color:#111827;margin-bottom:1rem">Projects</h1>
        <p style="font-size:1.125rem;color:#6B7280;font-weight:300;max-width:560px;line-height:1.7">Case studies in design architecture — every project telling a unique story of how form follows human behavior.</p>
      </section>

      <!-- Featured Case Study -->
      <section>
        <p style="font-size:.65rem;color:#6B7280;text-transform:uppercase;letter-spacing:.12em;margin-bottom:1.5rem">Featured Case Study</p>
        <div style="background:#fff;border-radius:32px;border:1px solid rgba(229,231,235,.6);box-shadow:0 4px 20px -2px rgba(0,0,0,.05);overflow:hidden">
          <div style="height:clamp(280px,40vw,520px);overflow:hidden;position:relative">
            <img src="https://images.pexels.com/photos/265087/pexels-photo-265087.jpeg?auto=compress&cs=tinysrgb&w=1400" alt="Lumina Wealth Case Study" style="width:100%;height:100%;object-fit:cover" loading="eager" />
            <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.6) 0%,transparent 60%)"></div>
            <div style="position:absolute;bottom:2rem;left:2rem;right:2rem;display:flex;justify-content:space-between;align-items:flex-end">
              <div><span style="font-size:.65rem;color:rgba(255,255,255,.6);text-transform:uppercase;letter-spacing:.1em;display:block;margin-bottom:.4rem">2021 — Fintech</span><h2 style="font-family:'Playfair Display',serif;font-size:clamp(1.5rem,3vw,2.25rem);font-weight:400;color:#fff">Lumina Wealth Platform</h2></div>
              <a href="#" style="display:flex;align-items:center;justify-content:center;width:3rem;height:3rem;border-radius:50%;background:rgba(255,255,255,.15);backdrop-filter:blur(8px);color:#fff;flex-shrink:0"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg></a>
            </div>
          </div>
          <div style="padding:2rem 2rem 2.5rem;display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1.5rem">
            <div><p style="font-size:.65rem;color:#6B7280;text-transform:uppercase;letter-spacing:.1em;margin-bottom:.4rem">Challenge</p><p style="font-size:.875rem;color:#111827;line-height:1.6">Redesign a complex wealth platform serving HNW clients without sacrificing depth or trust.</p></div>
            <div><p style="font-size:.65rem;color:#6B7280;text-transform:uppercase;letter-spacing:.1em;margin-bottom:.4rem">Outcome</p><p style="font-size:.875rem;color:#111827;line-height:1.6">40% reduction in task completion time, 98% user satisfaction, $1B+ AUM in first 6 months.</p></div>
            <div><p style="font-size:.65rem;color:#6B7280;text-transform:uppercase;letter-spacing:.1em;margin-bottom:.4rem">Scope</p><p style="font-size:.875rem;color:#111827;line-height:1.6">End-to-end UX, design system, interaction design, engineering handoff.</p></div>
          </div>
        </div>
      </section>

      <!-- Project Archive -->
      <section>
        <p style="font-size:.65rem;color:#6B7280;text-transform:uppercase;letter-spacing:.12em;margin-bottom:1.5rem">Project Archive</p>
        <div style="display:flex;flex-direction:column;gap:1rem">
          <div class="arc-card">
            <div class="arc-thumb"><img src="https://images.pexels.com/photos/1536619/pexels-photo-1536619.jpeg?auto=compress&cs=tinysrgb&w=200" alt="Maison Archive" loading="lazy" /></div>
            <div style="flex:1;min-width:0">
              <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:.4rem"><h3 style="font-size:1rem;font-weight:500;color:#111827">Maison Archive</h3><span style="font-size:.65rem;color:#6B7280;border:1px solid #E5E7EB;padding:.15rem .6rem;border-radius:999px;flex-shrink:0">Luxury</span></div>
              <p style="font-size:.8125rem;color:#6B7280;line-height:1.6">Digital rebranding and editorial e-commerce platform for a heritage fashion house.</p>
            </div>
          </div>
          <div class="arc-card">
            <div class="arc-thumb"><img src="https://images.pexels.com/photos/196645/pexels-photo-196645.jpeg?auto=compress&cs=tinysrgb&w=200" alt="Nexus System" loading="lazy" /></div>
            <div style="flex:1;min-width:0">
              <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:.4rem"><h3 style="font-size:1rem;font-weight:500;color:#111827">Nexus System</h3><span style="font-size:.65rem;color:#6B7280;border:1px solid #E5E7EB;padding:.15rem .6rem;border-radius:999px;flex-shrink:0">Systems</span></div>
              <p style="font-size:.8125rem;color:#6B7280;line-height:1.6">A scalable, multi-brand design language deployed across 14 international markets.</p>
            </div>
          </div>
          <div class="arc-card">
            <div class="arc-thumb"><img src="https://images.pexels.com/photos/323780/pexels-photo-323780.jpeg?auto=compress&cs=tinysrgb&w=200" alt="Aura Spaces" loading="lazy" /></div>
            <div style="flex:1;min-width:0">
              <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:.4rem"><h3 style="font-size:1rem;font-weight:500;color:#111827">Aura Spaces</h3><span style="font-size:.65rem;color:#6B7280;border:1px solid #E5E7EB;padding:.15rem .6rem;border-radius:999px;flex-shrink:0">Spatial</span></div>
              <p style="font-size:.8125rem;color:#6B7280;line-height:1.6">Translating physical wayfinding principles into a digital spatial navigation tool.</p>
            </div>
          </div>
        </div>
      </section>

    </div>
  </main>

  <footer style="border-top:1px solid #E5E7EB;background:#F9FAFB;padding:2rem 0">
    <div style="max-width:1440px;margin-inline:auto;padding-inline:1.5rem"><p style="font-size:.75rem;color:#6B7280">&copy; 2025 Alex Law. All rights reserved.</p></div>
  </footer>
</BaseLayout>
