---
import BaseLayout from '../../layouts/Base.astro';
import QGNav from '../../components/QGNav.astro';
---
<BaseLayout title="Testimonials — Alex Law" theme="qg">
  <Fragment slot="head">
    <link rel="stylesheet" href="/styles/rv.css" />
    <style>
      .deco{position:fixed;border-radius:50%;pointer-events:none;z-index:0}
      .deco1{width:40%;height:40%;top:-10%;left:-10%;background:radial-gradient(circle,rgba(238,242,255,.5) 0%,transparent 70%);filter:blur(60px)}
      .deco2{width:50%;height:50%;bottom:-10%;right:-5%;background:radial-gradient(circle,rgba(245,243,255,.4) 0%,transparent 70%);filter:blur(60px)}
      .t-card{background:rgba(255,255,255,.8);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,.3);border-radius:24px;padding:2rem;box-shadow:0 4px 20px -2px rgba(0,0,0,.05);display:flex;flex-direction:column;gap:1.25rem;transition:all .3s ease}
      .t-card:hover{transform:translateY(-4px);box-shadow:0 12px 40px -8px rgba(0,0,0,.08)}
    </style>
  </Fragment>
  <div class="deco deco1"></div>
  <div class="deco deco2"></div>
  <QGNav active="testimonials" />

  <main style="padding-top:5rem;position:relative;z-index:1">
    <div style="max-width:1440px;margin-inline:auto;padding:5rem 1.5rem 6rem;display:flex;flex-direction:column;gap:4rem">

      <!-- Header -->
      <section style="border-bottom:1px solid #E5E7EB;padding-bottom:3rem">
        <h1 style="font-family:'Playfair Display',serif;font-size:clamp(2.5rem,6vw,4rem);font-weight:500;line-height:1.1;letter-spacing:-.03em;color:#111827;margin-bottom:1rem">What Clients Say</h1>
        <p style="font-size:1.125rem;color:#6B7280;font-weight:300;max-width:560px;line-height:1.7">Partnerships built on clarity, mutual respect, and a shared obsession with getting the details right.</p>
      </section>

      <!-- Featured Testimonial -->
      <section>
        <div style="background:#fff;border-radius:32px;padding:clamp(2.5rem,5vw,4rem);box-shadow:0 4px 20px -2px rgba(0,0,0,.05);position:relative;overflow:hidden">
          <div style="position:absolute;top:2rem;left:2rem;opacity:.04;font-family:'Playfair Display',serif;font-size:8rem;line-height:1;color:#111827;pointer-events:none">&ldquo;</div>
          <div style="position:relative;z-index:1;display:flex;flex-direction:column;gap:2rem;max-width:800px">
            <p style="font-family:'Playfair Display',serif;font-size:clamp(1.25rem,2.5vw,1.625rem);color:#111827;line-height:1.65">&ldquo;Working with Alex felt less like hiring a designer and more like partnering with an architect. They didn&rsquo;t just make our product look better; they fundamentally clarified our thinking and elevated our entire brand presence.&rdquo;</p>
            <div style="display:flex;align-items:center;gap:1rem;border-top:1px solid rgba(229,231,235,.6);padding-top:1.5rem">
              <img src="https://images.pexels.com/photos/1181686/pexels-photo-1181686.jpeg?auto=compress&cs=tinysrgb&w=100" alt="Sarah Jenkins" style="width:3rem;height:3rem;border-radius:50%;object-fit:cover" loading="lazy" />
              <div><div style="font-size:.9375rem;font-weight:500;color:#111827">Sarah Jenkins</div><div style="font-size:.75rem;color:#6B7280">VP of Product, Lumina Wealth</div></div>
            </div>
          </div>
        </div>
      </section>

      <!-- Impact Metrics -->
      <section style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1.5rem">
        <div style="text-align:center;padding:2rem;background:#fff;border-radius:24px;border:1px solid rgba(229,231,235,.6);box-shadow:0 4px 20px -2px rgba(0,0,0,.05)">
          <div style="font-family:'Playfair Display',serif;font-size:2.5rem;font-weight:500;color:#111827">98%</div>
          <div style="font-size:.75rem;color:#6B7280;text-transform:uppercase;letter-spacing:.1em;margin-top:.5rem">Client Satisfaction</div>
        </div>
        <div style="text-align:center;padding:2rem;background:#fff;border-radius:24px;border:1px solid rgba(229,231,235,.6);box-shadow:0 4px 20px -2px rgba(0,0,0,.05)">
          <div style="font-family:'Playfair Display',serif;font-size:2.5rem;font-weight:500;color:#111827">45+</div>
          <div style="font-size:.75rem;color:#6B7280;text-transform:uppercase;letter-spacing:.1em;margin-top:.5rem">Projects Delivered</div>
        </div>
        <div style="text-align:center;padding:2rem;background:#fff;border-radius:24px;border:1px solid rgba(229,231,235,.6);box-shadow:0 4px 20px -2px rgba(0,0,0,.05)">
          <div style="font-family:'Playfair Display',serif;font-size:2.5rem;font-weight:500;color:#111827">85%</div>
          <div style="font-size:.75rem;color:#6B7280;text-transform:uppercase;letter-spacing:.1em;margin-top:.5rem">Repeat Clients</div>
        </div>
        <div style="text-align:center;padding:2rem;background:#fff;border-radius:24px;border:1px solid rgba(229,231,235,.6);box-shadow:0 4px 20px -2px rgba(0,0,0,.05)">
          <div style="font-family:'Playfair Display',serif;font-size:2.5rem;font-weight:500;color:#111827">12+</div>
          <div style="font-size:.75rem;color:#6B7280;text-transform:uppercase;letter-spacing:.1em;margin-top:.5rem">Years Experience</div>
        </div>
      </section>

      <!-- Testimonial Grid -->
      <section>
        <p style="font-size:.65rem;color:#6B7280;text-transform:uppercase;letter-spacing:.12em;margin-bottom:1.5rem">More Testimonials</p>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.5rem">
          <div class="t-card">
            <div style="font-size:1rem;color:#F59E0B">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
            <p style="font-size:.9375rem;color:#374151;line-height:1.75;font-style:italic">&ldquo;Alex has an uncanny ability to translate complex business logic into elegant, intuitive interfaces. Our conversion rates improved by 34% after the redesign.&rdquo;</p>
            <div style="display:flex;align-items:center;gap:.75rem;margin-top:auto;padding-top:1rem;border-top:1px solid rgba(229,231,235,.5)">
              <img src="https://images.pexels.com/photos/2379004/pexels-photo-2379004.jpeg?auto=compress&cs=tinysrgb&w=80" alt="Marcus Chen" style="width:2.5rem;height:2.5rem;border-radius:50%;object-fit:cover" loading="lazy" />
              <div><div style="font-size:.875rem;font-weight:500;color:#111827">Marcus Chen</div><div style="font-size:.75rem;color:#6B7280">CEO, Nexus Systems</div></div>
            </div>
          </div>
          <div class="t-card">
            <div style="font-size:1rem;color:#F59E0B">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
            <p style="font-size:.9375rem;color:#374151;line-height:1.75;font-style:italic">&ldquo;What sets Alex apart is the depth of thinking that precedes every decision. There's a reason for everything. The result feels inevitable, like it could never have been any other way.&rdquo;</p>
            <div style="display:flex;align-items:center;gap:.75rem;margin-top:auto;padding-top:1rem;border-top:1px solid rgba(229,231,235,.5)">
              <img src="https://images.pexels.com/photos/1239291/pexels-photo-1239291.jpeg?auto=compress&cs=tinysrgb&w=80" alt="Isabelle Moreau" style="width:2.5rem;height:2.5rem;border-radius:50%;object-fit:cover" loading="lazy" />
              <div><div style="font-size:.875rem;font-weight:500;color:#111827">Isabelle Moreau</div><div style="font-size:.75rem;color:#6B7280">Creative Director, Maison Archive</div></div>
            </div>
          </div>
          <div class="t-card">
            <div style="font-size:1rem;color:#F59E0B">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
            <p style="font-size:.9375rem;color:#374151;line-height:1.75;font-style:italic">&ldquo;We brought Alex in to fix a failing onboarding flow. They rebuilt the entire mental model in 3 weeks. Our activation rate jumped from 40% to 71%.&rdquo;</p>
            <div style="display:flex;align-items:center;gap:.75rem;margin-top:auto;padding-top:1rem;border-top:1px solid rgba(229,231,235,.5)">
              <img src="https://images.pexels.com/photos/1516680/pexels-photo-1516680.jpeg?auto=compress&cs=tinysrgb&w=80" alt="James Okonkwo" style="width:2.5rem;height:2.5rem;border-radius:50%;object-fit:cover" loading="lazy" />
              <div><div style="font-size:.875rem;font-weight:500;color:#111827">James Okonkwo</div><div style="font-size:.75rem;color:#6B7280">Head of Growth, Aura Spaces</div></div>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section style="background:#111827;border-radius:32px;padding:clamp(2.5rem,5vw,4rem);text-align:center;display:flex;flex-direction:column;align-items:center;gap:1.5rem">
        <h2 style="font-family:'Playfair Display',serif;font-size:clamp(1.75rem,3vw,2.5rem);font-weight:400;color:#fff">Ready to add your name here?</h2>
        <p style="font-size:.9375rem;color:rgba(255,255,255,.55);font-weight:300;max-width:400px;line-height:1.65">Let&rsquo;s start with a conversation about what you&rsquo;re building.</p>
        <a href="/qg/contact/" style="display:inline-flex;align-items:center;gap:.6rem;padding:.9rem 2.5rem;background:#fff;color:#111827;border-radius:24px;font-weight:500;font-size:.875rem;transition:all .2s ease">Start a Conversation</a>
      </section>

    </div>
  </main>

  <footer style="border-top:1px solid #E5E7EB;background:#F9FAFB;padding:2rem 0">
    <div style="max-width:1440px;margin-inline:auto;padding-inline:1.5rem"><p style="font-size:.75rem;color:#6B7280">&copy; 2025 Alex Law. All rights reserved.</p></div>
  </footer>
</BaseLayout>
