---
import BaseLayout from '../../layouts/Base.astro';
---
<BaseLayout title="Alex Law — Quiet Genius" theme="qg">
  <Fragment slot="head">
    <link rel="stylesheet" href="/styles/rv.css" />
    <style>
      /* QG-specific overrides */
      .nav-bg { background: rgba(249,250,251,.85); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border-bottom: 1px solid rgba(229,231,235,.5); }
      .hero-img { border-radius: 40px; }
      .stat-num { font-family: 'Playfair Display', serif; font-size: 2.5rem; font-weight: 500; color: var(--t1); line-height: 1; }
      .stat-lbl { font-size: .65rem; text-transform: uppercase; letter-spacing: .12em; color: var(--t2); margin-top: .35rem; }
      .work-card { cursor: pointer; }
      .work-card .thumb { border-radius: 32px; overflow: hidden; background: var(--ca); box-shadow: var(--sh); position: relative; height: 400px; }
      .work-card .thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform .7s ease; }
      .work-card:hover .thumb img { transform: scale(1.05); }
      .work-card .reveal-icon {
        position: absolute; top: 1.5rem; right: 1.5rem;
        width: 2.5rem; height: 2.5rem; border-radius: 50%;
        background: rgba(255,255,255,.92); backdrop-filter: blur(4px);
        display: flex; align-items: center; justify-content: center;
        opacity: 0; transform: translateY(6px);
        transition: all .3s ease;
      }
      .work-card:hover .reveal-icon { opacity: 1; transform: translateY(0); }
      .blog-row {
        display: flex; align-items: center; justify-content: space-between;
        padding: 1.1rem 1.25rem; border-radius: 20px;
        background: rgba(255,255,255,.75); backdrop-filter: blur(12px);
        border: 1px solid rgba(255,255,255,.3);
        transition: all .25s ease; gap: 1rem;
      }
      .blog-row:hover { background: #fff; box-shadow: 0 4px 16px -4px rgba(0,0,0,.07); }
      .blog-arrow {
        width: 2rem; height: 2rem; border-radius: 50%;
        background: var(--bg); display: flex; align-items: center; justify-content: center;
        color: var(--t2); flex-shrink: 0; transition: all .2s ease;
        font-size: .6rem;
      }
      .blog-row:hover .blog-arrow { background: var(--bg2); color: var(--t1); }
      .cta-banner {
        background: var(--t1); color: var(--bg);
        border-radius: 32px; padding: 5rem 2rem;
        text-align: center; position: relative; overflow: hidden;
      }
      .cta-glow {
        position: absolute; top: 0; left: 50%; transform: translateX(-50%);
        width: 60%; height: 6rem;
        background: rgba(255,255,255,.04); filter: blur(40px);
        border-radius: 50%; pointer-events: none;
      }
      .cta-btn {
        display: inline-flex; align-items: center; gap: .6rem;
        padding: 1rem 2.5rem; background: #fff; color: var(--t1);
        border-radius: 24px; font-weight: 500; font-size: .875rem;
        transition: all .2s ease; box-shadow: 0 4px 16px rgba(0,0,0,.15);
      }
      .cta-btn:hover { background: var(--bg2); }
      /* decorative blobs */
      .deco { position: fixed; border-radius: 50%; pointer-events: none; z-index: 0; }
      .deco1 { width: 40%; height: 40%; top: -10%; left: -10%; background: radial-gradient(circle, rgba(238,242,255,.5) 0%, transparent 70%); filter: blur(60px); }
      .deco2 { width: 50%; height: 50%; bottom: -10%; right: -5%; background: radial-gradient(circle, rgba(245,243,255,.4) 0%, transparent 70%); filter: blur(60px); }
      /* nav active */
      .nav-active { border-bottom: 2px solid var(--t1); padding-bottom: 2px; color: var(--t1) !important; }
      /* section spacing */
      .section { padding-block: 6rem; }
      @media(max-width: 767px) {
        .hero-cols { flex-direction: column; }
        .hero-img-wrap { width: 100%; height: 320px; }
        .hero-img { height: 100%; }
        .work-grid { grid-template-columns: 1fr; }
        .work-card { margin-top: 0 !important; }
        .insights-grid { grid-template-columns: 1fr; }
      }
    </style>
  </Fragment>

  <!-- Decorative background -->
  <div class="deco deco1"></div>
  <div class="deco deco2"></div>

  <!-- ── NAV ── -->
  <header class="nav-bg u3 u7" style="top:0;width:100%">
    <div class="b1" style="height:5rem;display:flex;align-items:center;justify-content:space-between">
      <a href="/qg/" style="font-family:var(--fs);font-size:1.25rem;font-weight:600;letter-spacing:-.02em;color:var(--t1)">A. Law</a>

      <nav style="display:flex;align-items:center;gap:2.5rem" class="f3">
        <a href="/qg/" class="f4 nav-active" style="font-size:.875rem;font-weight:500">Home</a>
        <a href="/qg/portfolio/" class="f4" style="font-size:.875rem;font-weight:500">Work</a>
        <a href="/qg/about/" class="f4" style="font-size:.875rem;font-weight:500">About</a>
        <a href="/qg/blog/" class="f4" style="font-size:.875rem;font-weight:500">Insights</a>
      </nav>

      <div style="display:flex;align-items:center;gap:1.5rem">
        <a href="/qg/contact/" style="width:2.5rem;height:2.5rem;border-radius:50%;background:var(--ca);box-shadow:var(--sh);display:flex;align-items:center;justify-content:center;color:var(--t1);transition:box-shadow .2s ease" class="md-only">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        </a>
        <button aria-label="Menu" style="display:none;padding:.5rem;background:none;border:none;color:var(--t1)" data-nav-toggle id="mob-toggle">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
      </div>
    </div>
    <!-- mobile menu -->
    <div id="mob-menu" data-nav-menu style="display:none;flex-direction:column;gap:1rem;padding:1rem 1.5rem 1.5rem;border-top:1px solid var(--br)">
      <a href="/qg/" style="font-size:.9375rem;color:var(--t1);font-weight:500">Home</a>
      <a href="/qg/portfolio/" style="font-size:.9375rem;color:var(--t2)">Work</a>
      <a href="/qg/about/" style="font-size:.9375rem;color:var(--t2)">About</a>
      <a href="/qg/blog/" style="font-size:.9375rem;color:var(--t2)">Insights</a>
      <a href="/qg/contact/" style="font-size:.9375rem;color:var(--t2)">Contact</a>
    </div>
  </header>

  <main style="padding-top:5rem">

    <!-- ── HERO ── -->
    <section style="max-width:1440px;margin-inline:auto;padding:5rem 1.5rem 4rem;position:relative;z-index:1">
      <div class="hero-cols" style="display:flex;align-items:center;justify-content:space-between;gap:4rem;min-height:70vh">

        <!-- copy -->
        <div style="flex:1;display:flex;flex-direction:column;gap:2rem;max-width:560px">
          <div style="display:flex;flex-direction:column;gap:1rem">
            <h1 style="font-family:var(--fs);font-size:clamp(3.5rem,7vw,6rem);font-weight:500;line-height:1.05;letter-spacing:-.03em;color:var(--t1)">Alex Law</h1>
            <p style="font-size:clamp(1.25rem,2.5vw,1.6rem);font-weight:300;color:var(--t2);line-height:1.5;max-width:480px">
              Architecting digital spaces where clarity meets profound intention.
            </p>
          </div>
          <p style="font-size:.9375rem;color:var(--t2);line-height:1.75;max-width:440px">
            I specialize in stripping away the unnecessary to reveal the essential. Every product, every interface, and every interaction is designed with ruthless taste to serve communication and elevate user experience.
          </p>
          <div style="display:flex;flex-wrap:wrap;gap:.75rem;padding-top:.5rem">
            <a href="/qg/portfolio/" style="padding:.9rem 2rem;background:var(--t1);color:#fff;border-radius:20px;font-weight:500;font-size:.875rem;display:inline-flex;align-items:center;gap:.5rem;transition:all .2s ease;box-shadow:0 8px 24px -4px rgba(17,24,39,.25)">
              View Portfolio
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
            <a href="/qg/contact/" style="padding:.9rem 2rem;background:var(--ca);color:var(--t1);border-radius:20px;font-weight:500;font-size:.875rem;display:inline-flex;align-items:center;gap:.5rem;box-shadow:var(--sh);transition:all .2s ease">
              Get in Touch
            </a>
          </div>
        </div>

        <!-- image -->
        <div style="flex:0 0 auto;position:relative;display:flex;justify-content:flex-end">
          <div class="hero-img-wrap" style="width:min(480px,42vw);height:min(600px,55vw);border-radius:40px;overflow:hidden;box-shadow:0 32px 80px -16px rgba(0,0,0,.18);position:relative">
            <img
              src="https://images.pexels.com/photos/3184405/pexels-photo-3184405.jpeg?auto=compress&cs=tinysrgb&w=800"
              alt="Professional designer portrait"
              style="width:100%;height:100%;object-fit:cover"
              loading="eager"
            />
            <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(249,250,251,.35) 0%,transparent 60%)"></div>
          </div>
          <div style="position:absolute;bottom:-2rem;left:-2rem;width:12rem;height:12rem;background:rgba(255,255,255,.4);backdrop-filter:blur(32px);border-radius:50%;filter:blur(32px);z-index:-1"></div>
        </div>
      </div>
    </section>

    <!-- ── EXPERTISE & IMPACT ── -->
    <section class="section" style="max-width:1440px;margin-inline:auto;padding-inline:1.5rem;position:relative;z-index:1">
      <!-- header row -->
      <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;border-bottom:1px solid var(--br);padding-bottom:2rem;gap:1.5rem;margin-bottom:3rem">
        <div>
          <h2 style="font-family:var(--fs);font-size:2rem;font-weight:400;color:var(--t1);margin-bottom:.35rem">Expertise &amp; Impact</h2>
          <p style="font-size:.8125rem;color:var(--t2)">The foundation of my practice.</p>
        </div>
        <div style="display:flex;gap:3rem">
          <div><div class="stat-num">12+</div><div class="stat-lbl">Years Experience</div></div>
          <div><div class="stat-num">45</div><div class="stat-lbl">Global Clients</div></div>
          <div><div class="stat-num">$1B+</div><div class="stat-lbl">Value Created</div></div>
        </div>
      </div>

      <!-- cards -->
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1.5rem">
        <div class="d4 e1" style="padding:2rem;border-radius:24px;display:flex;flex-direction:column;gap:1rem">
          <div style="width:3rem;height:3rem;border-radius:50%;background:rgba(99,102,241,.08);display:flex;align-items:center;justify-content:center;color:#6366f1">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
          </div>
          <h3 style="font-size:1.1rem;font-weight:500;color:var(--t1)">Product Strategy</h3>
          <p style="font-size:.875rem;color:var(--t2);line-height:1.7">Aligning business objectives with user needs to define clear, actionable roadmaps that drive long-term value and market differentiation.</p>
        </div>
        <div class="d4 e1" style="padding:2rem;border-radius:24px;display:flex;flex-direction:column;gap:1rem">
          <div style="width:3rem;height:3rem;border-radius:50%;background:rgba(168,85,247,.08);display:flex;align-items:center;justify-content:center;color:#a855f7">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/><circle cx="11" cy="11" r="2"/></svg>
          </div>
          <h3 style="font-size:1.1rem;font-weight:500;color:var(--t1)">Interface Design</h3>
          <p style="font-size:.875rem;color:var(--t2);line-height:1.7">Crafting pixel-perfect, accessible, and intuitive digital interfaces that feel invisible, allowing the content and purpose to shine.</p>
        </div>
        <div class="d4 e1" style="padding:2rem;border-radius:24px;display:flex;flex-direction:column;gap:1rem">
          <div style="width:3rem;height:3rem;border-radius:50%;background:rgba(16,185,129,.08);display:flex;align-items:center;justify-content:center;color:#10b981">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="6" y1="3" x2="6" y2="15"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M18 9a9 9 0 0 1-9 9"/></svg>
          </div>
          <h3 style="font-size:1.1rem;font-weight:500;color:var(--t1)">Design Systems</h3>
          <p style="font-size:.875rem;color:var(--t2);line-height:1.7">Building scalable, systemic design languages that empower teams to ship faster while maintaining absolute visual consistency.</p>
        </div>
      </div>
    </section>

    <!-- ── SELECTED WORKS ── -->
    <section class="section" style="max-width:1440px;margin-inline:auto;padding-inline:1.5rem;position:relative;z-index:1">
      <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:3rem">
        <div>
          <h2 style="font-family:var(--fs);font-size:2rem;font-weight:400;color:var(--t1);margin-bottom:.35rem">Selected Works</h2>
          <p style="font-size:.8125rem;color:var(--t2)">A curated glimpse into recent collaborations.</p>
        </div>
        <a href="/qg/portfolio/" style="font-size:.875rem;font-weight:500;color:var(--t1);display:inline-flex;align-items:center;gap:.4rem;transition:color .2s ease">
          View All
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>

      <div class="work-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:2rem">
        <!-- Card 1 -->
        <div class="work-card">
          <div class="thumb">
            <img
              src="https://images.pexels.com/photos/265087/pexels-photo-265087.jpeg?auto=compress&cs=tinysrgb&w=800"
              alt="Lumina Wealth fintech dashboard"
              loading="lazy"
            />
            <div style="position:absolute;inset:0;background:rgba(0,0,0,.04);opacity:0;transition:opacity .3s ease" class="card-hover-overlay"></div>
            <div class="reveal-icon">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
            </div>
          </div>
          <div style="padding:.5rem .25rem 0">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:.4rem">
              <h3 style="font-size:1.1rem;font-weight:500;color:var(--t1)">Lumina Wealth</h3>
              <span style="font-size:.65rem;color:var(--t2);text-transform:uppercase;letter-spacing:.1em">Fintech</span>
            </div>
            <p style="font-size:.875rem;color:var(--t2)">Redefining private banking for the digital age through quiet, confident interfaces.</p>
          </div>
        </div>

        <!-- Card 2 -->
        <div class="work-card" style="margin-top:4rem">
          <div class="thumb">
            <img
              src="https://images.pexels.com/photos/1536619/pexels-photo-1536619.jpeg?auto=compress&cs=tinysrgb&w=800"
              alt="Maison Archive luxury e-commerce"
              loading="lazy"
            />
            <div style="position:absolute;inset:0;background:rgba(0,0,0,.04);opacity:0;transition:opacity .3s ease" class="card-hover-overlay"></div>
            <div class="reveal-icon">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
            </div>
          </div>
          <div style="padding:.5rem .25rem 0">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:.4rem">
              <h3 style="font-size:1.1rem;font-weight:500;color:var(--t1)">Maison Archive</h3>
              <span style="font-size:.65rem;color:var(--t2);text-transform:uppercase;letter-spacing:.1em">E-Commerce</span>
            </div>
            <p style="font-size:.875rem;color:var(--t2)">A digital gallery experience for a heritage luxury brand, focusing on narrative commerce.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── TESTIMONIAL + BLOG ── -->
    <section class="section" style="max-width:1440px;margin-inline:auto;padding-inline:1.5rem;position:relative;z-index:1">
      <div class="insights-grid" style="display:grid;grid-template-columns:7fr 5fr;gap:2rem;align-items:start">

        <!-- Testimonial -->
        <div style="background:var(--ca);border-radius:32px;padding:clamp(2rem,5vw,4rem);box-shadow:var(--sh);position:relative;overflow:hidden">
          <div style="position:absolute;top:2rem;left:2rem;opacity:.04;font-size:6rem;line-height:1;font-family:var(--fs);color:var(--t1);pointer-events:none">&ldquo;</div>
          <div style="position:relative;z-index:1;display:flex;flex-direction:column;gap:2rem">
            <p style="font-family:var(--fs);font-size:clamp(1.2rem,2.5vw,1.5rem);color:var(--t1);line-height:1.65">
              &ldquo;Working with Alex felt less like hiring a designer and more like partnering with an architect. They didn&rsquo;t just make our product look better; they fundamentally clarified our thinking and elevated our entire brand presence.&rdquo;
            </p>
            <div style="display:flex;align-items:center;gap:1rem;padding-top:1rem;border-top:1px solid rgba(229,231,235,.6)">
              <img
                src="https://images.pexels.com/photos/1181686/pexels-photo-1181686.jpeg?auto=compress&cs=tinysrgb&w=100"
                alt="Sarah Jenkins"
                style="width:3rem;height:3rem;border-radius:50%;object-fit:cover;box-shadow:0 2px 8px rgba(0,0,0,.1)"
                loading="lazy"
              />
              <div>
                <div style="font-size:.9375rem;font-weight:500;color:var(--t1)">Sarah Jenkins</div>
                <div style="font-size:.75rem;color:var(--t2)">VP of Product, Lumina Wealth</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Blog posts -->
        <div style="display:flex;flex-direction:column;gap:1.25rem">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:.5rem">
            <h2 style="font-family:var(--fs);font-size:1.5rem;font-weight:400;color:var(--t1)">Recent Thoughts</h2>
            <a href="/qg/blog/" style="font-size:.75rem;color:var(--t2);transition:color .2s ease">All Posts</a>
          </div>
          <a href="/qg/blog/" class="blog-row">
            <div style="display:flex;flex-direction:column;gap:.3rem;padding-right:.75rem">
              <span style="font-size:.65rem;color:var(--t2);text-transform:uppercase;letter-spacing:.1em">Oct 12, 2023</span>
              <h4 style="font-size:.875rem;font-weight:500;color:var(--t1)">The Architecture of Silence in UI</h4>
              <p style="font-size:.75rem;color:var(--t2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">Why removing elements is harder than adding them.</p>
            </div>
            <div class="blog-arrow">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </div>
          </a>
          <a href="/qg/blog/" class="blog-row">
            <div style="display:flex;flex-direction:column;gap:.3rem;padding-right:.75rem">
              <span style="font-size:.65rem;color:var(--t2);text-transform:uppercase;letter-spacing:.1em">Sep 28, 2023</span>
              <h4 style="font-size:.875rem;font-weight:500;color:var(--t1)">Designing for Trust</h4>
              <p style="font-size:.75rem;color:var(--t2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">Visual cues that communicate institutional stability.</p>
            </div>
            <div class="blog-arrow">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </div>
          </a>
          <a href="/qg/blog/" class="blog-row">
            <div style="display:flex;flex-direction:column;gap:.3rem;padding-right:.75rem">
              <span style="font-size:.65rem;color:var(--t2);text-transform:uppercase;letter-spacing:.1em">Sep 05, 2023</span>
              <h4 style="font-size:.875rem;font-weight:500;color:var(--t1)">Typography as Hierarchy</h4>
              <p style="font-size:.75rem;color:var(--t2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">Structuring information without relying on borders.</p>
            </div>
            <div class="blog-arrow">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </div>
          </a>
        </div>

      </div>
    </section>

    <!-- ── CTA BANNER ── -->
    <section style="max-width:1440px;margin-inline:auto;padding:0 1.5rem 6rem;position:relative;z-index:1">
      <div class="cta-banner">
        <div class="cta-glow"></div>
        <div style="position:relative;z-index:1;display:flex;flex-direction:column;align-items:center;gap:2rem">
          <div style="display:flex;flex-direction:column;gap:1rem;max-width:560px">
            <h2 style="font-family:var(--fs);font-size:clamp(2rem,4vw,3rem);font-weight:500;line-height:1.15;color:#fff">Ready to elevate your digital presence?</h2>
            <p style="font-size:1rem;color:rgba(255,255,255,.55);line-height:1.65;font-weight:300">
              Currently accepting select projects for Q4 2025. Let&rsquo;s discuss how we can build something quietly unforgettable together.
            </p>
          </div>
          <a href="/qg/contact/" class="cta-btn">
            Start a Conversation
