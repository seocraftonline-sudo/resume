  <Fragment slot="scripts">
    <script>
      // mobile nav responsive show/hide
      const toggle = document.getElementById('mob-toggle');
      const menu = document.getElementById('mob-menu');
      const navLinks = document.querySelectorAll('.f3 .f4');
      if (toggle && menu) {
        toggle.addEventListener('click', () => {
          const open = menu.style.display === 'flex';
          menu.style.display = open ? 'none' : 'flex';
        });
      }
      // show mobile toggle on small screens
      function checkMobile() {
        const isMobile = window.innerWidth < 768;
        if (toggle) toggle.style.display = isMobile ? 'flex' : 'none';
        const desktopNav = document.querySelector('.f3');
        if (desktopNav) desktopNav.style.display = isMobile ? 'none' : 'flex';
        const mailBtn = document.querySelector('.md-only');
        if (mailBtn) mailBtn.style.display = isMobile ? 'none' : 'flex';
      }
      checkMobile();
      window.addEventListener('resize', checkMobile);

      // work card hover overlay
      document.querySelectorAll('.work-card').forEach(card => {
        const overlay = card.querySelector('.card-hover-overlay');
        card.addEventListener('mouseenter', () => { if (overlay) overlay.style.opacity = '1'; });
        card.addEventListener('mouseleave', () => { if (overlay) overlay.style.opacity = '0'; });
      });

      // stagger offset on work grid for mobile
      if (window.innerWidth < 768) {
        document.querySelectorAll('.work-card').forEach(c => c.style.marginTop = '0');
      }
    </script>
  </Fragment>
</BaseLayout>
