---
import BaseLayout from '../../layouts/Base.astro';
import CDNav from '../../components/CDNav.astro';
---

<BaseLayout title="About Wil B — Creative Director, Founder, Technologist" theme="cd">
  <link rel="stylesheet" href="/styles/rv.css" slot="head" />
  <CDNav active="about" />

  <main style="padding-top:5rem;background:#fff;color:#1a1a1a;font-family:'Inter',sans-serif">

    <!-- Page Header -->
    <section style="border-bottom:1px solid #e7e7e7;padding:4rem 1.5rem 3rem">
      <div style="max-width:1440px;margin-inline:auto">
        <p style="font-size:.75rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#b0b0b0;margin-bottom:.75rem">About</p>
        <h1 style="font-size:clamp(2.5rem,6vw,5rem);font-weight:900;letter-spacing:-.04em;line-height:1.0;margin:0;color:#1a1a1a">Wil B.</h1>
      </div>
    </section>

    <!-- Bio + Portrait -->
    <section style="max-width:1440px;margin-inline:auto;padding:5rem 1.5rem;display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:start">
      <div>
        <img src="https://images.pexels.com/photos/2379004/pexels-photo-2379004.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Wil B portrait" style="width:100%;aspect-ratio:3/4;object-fit:cover;filter:grayscale(20%)" />
      </div>
      <div>
        <p style="font-size:.75rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#b0b0b0;margin-bottom:1.5rem">01 — Who I Am</p>
        <p style="font-size:1.375rem;font-weight:300;color:#1a1a1a;line-height:1.65;margin:0 0 1.5rem">
          I don't just design interfaces. I orchestrate experiences that make people stop, lean in, and feel something they didn't expect to feel.
        </p>
        <p style="font-size:1rem;color:#6d6d6d;line-height:1.7;font-weight:300;margin:0 0 1.25rem">
          My journey started at the intersection of technology and creative culture — working with startups to Fortune 500 brands across London, New York, and San Francisco. What separates me from other designers? I build everything I design. Code is not a constraint; it's my medium.
        </p>
        <p style="font-size:1rem;color:#6d6d6d;line-height:1.7;font-weight:300;margin:0 0 1.25rem">
          Over eight years I've shipped products used by millions, led brand transformations that repositioned entire companies, and spoken at design conferences across three continents. Each project starts with one question: what would make this impossible to ignore?
        </p>
        <p style="font-size:1rem;color:#6d6d6d;line-height:1.7;font-weight:300;margin:0 0 2rem">
          Today I run a boutique studio while also advising early-stage startups on product design and creative strategy. I believe the best work comes from deep curiosity, relentless craft, and the courage to reject the safe option.
        </p>
        <a href="/cd/contact/" style="display:inline-flex;align-items:center;gap:.625rem;padding:.875rem 2rem;background:#1a1a1a;color:#fff;font-size:.9375rem;font-weight:700;border-radius:999px;text-decoration:none;transition:transform .2s ease,box-shadow .2s ease" onmouseenter="this.style.transform='translateY(-4px)';this.style.boxShadow='0 10px 25px -5px rgba(0,0,0,.25)'" onmouseleave="this.style.transform='';this.style.boxShadow=''">Work Together →</a>
      </div>
    </section>

    <!-- Timeline -->
    <section style="background:#f6f6f6;border-top:1px solid #e7e7e7;border-bottom:1px solid #e7e7e7;padding:5rem 1.5rem">
      <div style="max-width:1440px;margin-inline:auto">
        <p style="font-size:.75rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#b0b0b0;margin-bottom:.5rem">02 — Career</p>
        <h2 style="font-size:clamp(1.75rem,3.5vw,2.5rem);font-weight:900;letter-spacing:-.03em;color:#1a1a1a;margin:0 0 3.5rem">The journey.</h2>

        <div style="display:flex;flex-direction:column;gap:0">
          <div style="display:grid;grid-template-columns:100px 1fr;gap:2rem;padding:2rem 0;border-bottom:1px solid #e7e7e7;align-items:start">
            <div style="font-size:1.25rem;font-weight:900;color:#e7e7e7;letter-spacing:-.03em;line-height:1">2017</div>
            <div>
              <h3 style="font-size:1.0625rem;font-weight:800;color:#1a1a1a;letter-spacing:-.02em;margin:0 0 .375rem">Junior Designer → Lead Designer, Studio One</h3>
              <p style="font-size:.9375rem;color:#6d6d6d;line-height:1.6;font-weight:300;margin:0">Joined as a junior, was promoted twice in 18 months. Led the visual identity for over a dozen B2B software brands.</p>
            </div>
          </div>
          <div style="display:grid;grid-template-columns:100px 1fr;gap:2rem;padding:2rem 0;border-bottom:1px solid #e7e7e7;align-items:start">
            <div style="font-size:1.25rem;font-weight:900;color:#e7e7e7;letter-spacing:-.03em;line-height:1">2019</div>
            <div>
              <h3 style="font-size:1.0625rem;font-weight:800;color:#1a1a1a;letter-spacing:-.02em;margin:0 0 .375rem">Creative Director, Vertex Agency</h3>
              <p style="font-size:.9375rem;color:#6d6d6d;line-height:1.6;font-weight:300;margin:0">Oversaw all creative output for a 20-person agency. Won first Awwwards Site of the Day. Built and mentored a team of six designers.</p>
            </div>
          </div>
          <div style="display:grid;grid-template-columns:100px 1fr;gap:2rem;padding:2rem 0;border-bottom:1px solid #e7e7e7;align-items:start">
            <div style="font-size:1.25rem;font-weight:900;color:#e7e7e7;letter-spacing:-.03em;line-height:1">2021</div>
            <div>
              <h3 style="font-size:1.0625rem;font-weight:800;color:#1a1a1a;letter-spacing:-.02em;margin:0 0 .375rem">Founder, Disrupt Studio</h3>
              <p style="font-size:.9375rem;color:#6d6d6d;line-height:1.6;font-weight:300;margin:0">Founded an independent creative studio focused on brand identity and immersive web experiences. Serving VC-backed startups and established enterprises.</p>
            </div>
          </div>
          <div style="display:grid;grid-template-columns:100px 1fr;gap:2rem;padding:2rem 0;border-bottom:1px solid #e7e7e7;align-items:start">
            <div style="font-size:1.25rem;font-weight:900;color:#e7e7e7;letter-spacing:-.03em;line-height:1">2023</div>
            <div>
              <h3 style="font-size:1.0625rem;font-weight:800;color:#1a1a1a;letter-spacing:-.02em;margin:0 0 .375rem">VP Creative, Nexus Technologies</h3>
              <p style="font-size:.9375rem;color:#6d6d6d;line-height:1.6;font-weight:300;margin:0">Led global rebrand and design system overhaul. Managed cross-functional team of 14 across design, content, and engineering.</p>
            </div>
          </div>
          <div style="display:grid;grid-template-columns:100px 1fr;gap:2rem;padding:2rem 0;align-items:start">
            <div style="font-size:1.25rem;font-weight:900;color:#1a1a1a;letter-spacing:-.03em;line-height:1">Now</div>
            <div>
              <h3 style="font-size:1.0625rem;font-weight:800;color:#1a1a1a;letter-spacing:-.02em;margin:0 0 .375rem">Independent Creative Director + Studio Founder</h3>
              <p style="font-size:.9375rem;color:#6d6d6d;line-height:1.6;font-weight:300;margin:0">Running Disrupt Studio, advising three startups on creative strategy, and selectively taking on brand transformation projects for ambitious founders.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Values -->
    <section style="max-width:1440px;margin-inline:auto;padding:5rem 1.5rem">
      <p style="font-size:.75rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#b0b0b0;margin-bottom:.5rem">03 — Philosophy</p>
      <h2 style="font-size:clamp(1.75rem,3.5vw,2.5rem);font-weight:900;letter-spacing:-.03em;color:#1a1a1a;margin:0 0 3rem">What I stand for.</h2>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1.5rem">
        <div style="background:#1a1a1a;padding:2.5rem;transition:transform .3s ease" onmouseenter="this.style.transform='translateY(-4px)'" onmouseleave="this.style.transform=''">
          <h3 style="font-size:1.375rem;font-weight:900;color:#fff;letter-spacing:-.03em;margin:0 0 1rem;line-height:1.2">Safe is the riskiest choice you can make.</h3>
          <p style="color:rgba(255,255,255,.6);font-size:.9375rem;line-height:1.6;font-weight:300;margin:0">Conventional work disappears in the noise. The brands that break through are the ones with the courage to be different.</p>
        </div>
        <div style="background:#f6f6f6;border:1px solid #e7e7e7;padding:2.5rem;transition:transform .3s ease" onmouseenter="this.style.transform='translateY(-4px)'" onmouseleave="this.style.transform=''">
          <h3 style="font-size:1.375rem;font-weight:900;color:#1a1a1a;letter-spacing:-.03em;margin:0 0 1rem;line-height:1.2">Understand before you disrupt.</h3>
          <p style="color:#6d6d6d;font-size:.9375rem;line-height:1.6;font-weight:300;margin:0">Breaking rules only works when you understand why they existed. Strategy comes before aesthetics, always.</p>
        </div>
        <div style="background:#f6f6f6;border:1px solid #e7e7e7;padding:2.5rem;transition:transform .3s ease" onmouseenter="this.style.transform='translateY(-4px)'" onmouseleave="this.style.transform=''">
          <h3 style="font-size:1.375rem;font-weight:900;color:#1a1a1a;letter-spacing:-.03em;margin:0 0 1rem;line-height:1.2">Build it yourself first.</h3>
          <p style="color:#6d6d6d;font-size:.9375rem;line-height:1.6;font-weight:300;margin:0">The best designers understand their medium at the code level. Technical fluency is not optional — it's the difference between good and great.</p>
        </div>
      </div>
    </section>

    <!-- Skills Highlights -->
    <section style="background:#f6f6f6;border-top:1px solid #e7e7e7;border-bottom:1px solid #e7e7e7;padding:5rem 1.5rem">
      <div style="max-width:1440px;margin-inline:auto">
        <p style="font-size:.75rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#b0b0b0;margin-bottom:.5rem">04 — Capabilities</p>
        <h2 style="font-size:clamp(1.75rem,3.5vw,2.5rem);font-weight:900;letter-spacing:-.03em;color:#1a1a1a;margin:0 0 3rem">Skills at a glance.</h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:2rem">
          <div>
            <h4 style="font-size:.75rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#b0b0b0;margin:0 0 1rem;border-bottom:1px solid #e7e7e7;padding-bottom:.5rem">Design</h4>
            <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:.5rem">
              <li style="font-size:.9375rem;color:#1a1a1a;font-weight:500">Brand Identity</li>
              <li style="font-size:.9375rem;color:#1a1a1a;font-weight:500">UI/UX Design</li>
              <li style="font-size:.9375rem;color:#1a1a1a;font-weight:500">Motion Design</li>
              <li style="font-size:.9375rem;color:#1a1a1a;font-weight:500">Typography</li>
            </ul>
          </div>
          <div>
            <h4 style="font-size:.75rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#b0b0b0;margin:0 0 1rem;border-bottom:1px solid #e7e7e7;padding-bottom:.5rem">Technology</h4>
            <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:.5rem">
              <li style="font-size:.9375rem;color:#1a1a1a;font-weight:500">React / Next.js</li>
              <li style="font-size:.9375rem;color:#1a1a1a;font-weight:500">TypeScript</li>
              <li style="font-size:.9375rem;color:#1a1a1a;font-weight:500">Three.js / WebGL</li>
              <li style="font-size:.9375rem;color:#1a1a1a;font-weight:500">Framer Motion</li>
            </ul>
          </div>
          <div>
            <h4 style="font-size:.75rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#b0b0b0;margin:0 0 1rem;border-bottom:1px solid #e7e7e7;padding-bottom:.5rem">Strategy</h4>
            <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:.5rem">
              <li style="font-size:.9375rem;color:#1a1a1a;font-weight:500">Brand Strategy</li>
              <li style="font-size:.9375rem;color:#1a1a1a;font-weight:500">Product Roadmapping</li>
              <li style="font-size:.9375rem;color:#1a1a1a;font-weight:500">Go-to-Market</li>
              <li style="font-size:.9375rem;color:#1a1a1a;font-weight:500">Creative Leadership</li>
            </ul>
          </div>
          <div>
            <h4 style="font-size:.75rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#b0b0b0;margin:0 0 1rem;border-bottom:1px solid #e7e7e7;padding-bottom:.5rem">Tools</h4>
            <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:.5rem">
              <li style="font-size:.9375rem;color:#1a1a1a;font-weight:500">Figma</li>
              <li style="font-size:.9375rem;color:#1a1a1a;font-weight:500">After Effects</li>
              <li style="font-size:.9375rem;color:#1a1a1a;font-weight:500">Spline 3D</li>
              <li style="font-size:.9375rem;color:#1a1a1a;font-weight:500">VS Code</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section style="max-width:1440px;margin-inline:auto;padding:5rem 1.5rem;text-align:center">
      <h2 style="font-size:clamp(1.75rem,3.5vw,2.5rem);font-weight:900;letter-spacing:-.03em;color:#1a1a1a;margin:0 0 1rem">Ready to work together?</h2>
      <p style="font-size:1.125rem;color:#6d6d6d;max-width:500px;margin-inline:auto;line-height:1.6;font-weight:300;margin-bottom:2.5rem">I take on a limited number of projects each quarter. Let's see if we're a fit.</p>
      <div style="display:flex;justify-content:center;gap:1rem;flex-wrap:wrap">
        <a href="/cd/contact/" style="display:inline-flex;align-items:center;gap:.625rem;padding:.875rem 2rem;background:#1a1a1a;color:#fff;font-size:.9375rem;font-weight:700;border-radius:999px;text-decoration:none;transition:transform .2s ease,box-shadow .2s ease" onmouseenter="this.style.transform='translateY(-4px)';this.style.boxShadow='0 10px 25px -5px rgba(0,0,0,.25)'" onmouseleave="this.style.transform='';this.style.boxShadow=''">Get in Touch →</a>
        <a href="/cd/resume/" style="display:inline-flex;align-items:center;gap:.625rem;padding:.875rem 2rem;background:#fff;color:#1a1a1a;font-size:.9375rem;font-weight:700;border-radius:999px;text-decoration:none;border:1.5px solid #1a1a1a;transition:transform .2s ease" onmouseenter="this.style.transform='translateY(-4px)'" onmouseleave="this.style.transform=''">View Resume</a>
      </div>
    </section>

  </main>

  <!-- Footer -->
  <footer style="background:#1a1a1a;padding:3rem 1.5rem">
    <div style="max-width:1440px;margin-inline:auto;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:1.5rem">
      <div style="color:rgba(255,255,255,.5);font-size:.875rem">© 2025 Wil B. All rights reserved.</div>
      <div style="display:flex;align-items:center;gap:1.5rem">
        <a href="#" style="color:rgba(255,255,255,.6);font-size:.875rem;font-weight:500;text-decoration:none" onmouseenter="this.style.color='#fff'" onmouseleave="this.style.color='rgba(255,255,255,.6)'">GitHub</a>
        <a href="#" style="color:rgba(255,255,255,.6);font-size:.875rem;font-weight:500;text-decoration:none" onmouseenter="this.style.color='#fff'" onmouseleave="this.style.color='rgba(255,255,255,.6)'">LinkedIn</a>
        <a href="#" style="color:rgba(255,255,255,.6);font-size:.875rem;font-weight:500;text-decoration:none" onmouseenter="this.style.color='#fff'" onmouseleave="this.style.color='rgba(255,255,255,.6)'">Instagram</a>
        <a href="#" style="color:rgba(255,255,255,.6);font-size:.875rem;font-weight:500;text-decoration:none" onmouseenter="this.style.color='#fff'" onmouseleave="this.style.color='rgba(255,255,255,.6)'">Twitter</a>
      </div>
    </div>
  </footer>

  <style>
    @media (max-width:767px) {
      main section[style*="grid-template-columns:1fr 1fr"] { grid-template-columns:1fr !important; }
    }
  </style>
</BaseLayout>
