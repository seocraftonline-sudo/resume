---
import BaseLayout from '../../layouts/Base.astro';
import CDNav from '../../components/CDNav.astro';
---

<BaseLayout title="Contact — Wil B" theme="cd">
  <link rel="stylesheet" href="/styles/rv.css" slot="head" />
  <CDNav active="contact" />

  <main style="padding-top:5rem;background:#fff;color:#1a1a1a;font-family:'Inter',sans-serif">

    <!-- Page Header -->
    <section style="border-bottom:1px solid #e7e7e7;padding:4rem 1.5rem 3rem">
      <div style="max-width:1440px;margin-inline:auto">
        <p style="font-size:.75rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#b0b0b0;margin-bottom:.75rem">Contact</p>
        <h1 style="font-size:clamp(2.5rem,6vw,5rem);font-weight:900;letter-spacing:-.04em;line-height:1.0;margin:0;color:#1a1a1a">Let's Talk.</h1>
      </div>
    </section>

    <!-- Split Layout -->
    <section style="max-width:1440px;margin-inline:auto;padding:5rem 1.5rem;display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:start">

      <!-- Left: Info -->
      <div>
        <p style="font-size:1.25rem;font-weight:300;color:#1a1a1a;line-height:1.65;margin:0 0 3rem;max-width:480px">I'm always open to discussing new projects, creative challenges, or opportunities to be part of your vision. Let's build something unexpected.</p>

        <!-- Availability -->
        <div style="display:flex;align-items:start;gap:1rem;margin-bottom:2rem">
          <div style="width:2.75rem;height:2.75rem;background:#f6f6f6;border:1px solid #e7e7e7;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:.125rem">
            <div style="width:.625rem;height:.625rem;background:#22c55e;border-radius:50%"></div>
          </div>
          <div>
            <h3 style="font-size:.9375rem;font-weight:800;color:#1a1a1a;margin:0 0 .25rem">Currently Available</h3>
            <p style="font-size:.875rem;color:#6d6d6d;line-height:1.55;font-weight:300;margin:0">Accepting new projects for Q3 2026. Open to strategic advisory roles and creative leadership engagements.</p>
          </div>
        </div>

        <!-- Response Time -->
        <div style="display:flex;align-items:start;gap:1rem;margin-bottom:2rem">
          <div style="width:2.75rem;height:2.75rem;background:#f6f6f6;border:1px solid #e7e7e7;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:.125rem">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#b0b0b0" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <div>
            <h3 style="font-size:.9375rem;font-weight:800;color:#1a1a1a;margin:0 0 .25rem">Fast Response</h3>
            <p style="font-size:.875rem;color:#6d6d6d;line-height:1.55;font-weight:300;margin:0">I aim to reply to all inquiries within 24–48 hours. No ghosting — just honest conversations.</p>
          </div>
        </div>

        <!-- Direct Email + Location Cards -->
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:3rem">
          <div style="background:#fff;border:1px solid #e7e7e7;padding:1.5rem">
            <h4 style="font-size:.6875rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#b0b0b0;margin:0 0 .625rem">Direct Email</h4>
            <a href="mailto:hello@wilb.com" style="font-size:.875rem;font-weight:700;color:#1a1a1a;text-decoration:none;display:flex;align-items:center;gap:.5rem;transition:color .2s ease" onmouseenter="this.style.color='#b0b0b0'" onmouseleave="this.style.color='#1a1a1a'">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              hello@wilb.com
            </a>
          </div>
          <div style="background:#fff;border:1px solid #e7e7e7;padding:1.5rem">
            <h4 style="font-size:.6875rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#b0b0b0;margin:0 0 .625rem">Location</h4>
            <div style="font-size:.875rem;font-weight:700;color:#1a1a1a;display:flex;align-items:center;gap:.5rem">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#b0b0b0" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              London, UK
            </div>
          </div>
        </div>

        <!-- Social Links -->
        <div>
          <p style="font-size:.6875rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#b0b0b0;margin-bottom:1.25rem">Also find me at</p>
          <div style="display:flex;flex-wrap:wrap;gap:.75rem">
            {[
              {label:'LinkedIn', href:'#', icon:'<rect x="2" y="2" width="20" height="20" rx="2"/><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>'},
              {label:'GitHub', href:'#', icon:'<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>'},
              {label:'Instagram', href:'#', icon:'<rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>'},
              {label:'Twitter', href:'#', icon:'<path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/>'},
              {label:'Behance', href:'#', icon:'<path d="M1 10h6.5a3 3 0 0 0 0-6H1v12h7.5a3.5 3.5 0 0 0 0-7H1"/><line x1="14" y1="7" x2="22" y2="7"/><path d="M22 14c0 2.2-1.8 4-4 4s-4-1.8-4-4 1.8-4 4-4 4 1.8 4 4z"/>'}
            ].map(({label, href, icon}) => (
              <a href={href} style="display:inline-flex;align-items:center;gap:.5rem;padding:.625rem 1.125rem;border:1.5px solid #e7e7e7;color:#1a1a1a;text-decoration:none;font-size:.8125rem;font-weight:600;transition:border-color .2s ease,background .2s ease" onmouseenter="this.style.borderColor='#1a1a1a';this.style.background='#f6f6f6'" onmouseleave="this.style.borderColor='#e7e7e7';this.style.background=''">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" set:html={icon}></svg>
                {label}
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Right: Form -->
      <div style="background:#fff;border:1px solid #e7e7e7;padding:2.5rem">
        <h2 style="font-size:1.125rem;font-weight:900;color:#1a1a1a;letter-spacing:-.03em;margin:0 0 2rem">Send a message</h2>
        <form onsubmit="event.preventDefault()" style="display:flex;flex-direction:column;gap:1.5rem">

          <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
            <div style="position:relative">
              <label style="position:absolute;top:-.5rem;left:.875rem;background:#fff;padding:0 .375rem;font-size:.6875rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#b0b0b0;z-index:1">First name</label>
              <input type="text" placeholder="Johaness" style="width:100%;padding:.875rem 1rem;border:1px solid #e7e7e7;background:#fff;font-size:.9375rem;color:#1a1a1a;font-family:'Inter',sans-serif;outline:none;transition:border-color .2s ease;box-sizing:border-box" onfocus="this.style.borderColor='#1a1a1a';this.style.boxShadow='0 0 0 1px #1a1a1a'" onblur="this.style.borderColor='#e7e7e7';this.style.boxShadow='none'" />
            </div>
            <div style="position:relative">
              <label style="position:absolute;top:-.5rem;left:.875rem;background:#fff;padding:0 .375rem;font-size:.6875rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#b0b0b0;z-index:1">Last name</label>
              <input type="text" placeholder="Mark" style="width:100%;padding:.875rem 1rem;border:1px solid #e7e7e7;background:#fff;font-size:.9375rem;color:#1a1a1a;font-family:'Inter',sans-serif;outline:none;transition:border-color .2s ease;box-sizing:border-box" onfocus="this.style.borderColor='#1a1a1a';this.style.boxShadow='0 0 0 1px #1a1a1a'" onblur="this.style.borderColor='#e7e7e7';this.style.boxShadow='none'" />
            </div>
          </div>

          <div style="position:relative">
            <label style="position:absolute;top:-.5rem;left:.875rem;background:#fff;padding:0 .375rem;font-size:.6875rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#b0b0b0;z-index:1">Email address</label>
            <input type="email" placeholder="hello@company.com" style="width:100%;padding:.875rem 1rem;border:1px solid #e7e7e7;background:#fff;font-size:.9375rem;color:#1a1a1a;font-family:'Inter',sans-serif;outline:none;transition:border-color .2s ease;box-sizing:border-box" onfocus="this.style.borderColor='#1a1a1a';this.style.boxShadow='0 0 0 1px #1a1a1a'" onblur="this.style.borderColor='#e7e7e7';this.style.boxShadow='none'" />
          </div>

          <div style="position:relative">
            <label style="position:absolute;top:-.5rem;left:.875rem;background:#fff;padding:0 .375rem;font-size:.6875rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#b0b0b0;z-index:1">Budget range</label>
            <select style="width:100%;padding:.875rem 1rem;border:1px solid #e7e7e7;background:#fff;font-size:.9375rem;color:#1a1a1a;font-family:'Inter',sans-serif;outline:none;transition:border-color .2s ease;box-sizing:border-box;-webkit-appearance:none;cursor:pointer" onfocus="this.style.borderColor='#1a1a1a';this.style.boxShadow='0 0 0 1px #1a1a1a'" onblur="this.style.borderColor='#e7e7e7';this.style.boxShadow='none'">
              <option value="" disabled selected>Select a range…</option>
              <option>$5,000 – $15,000</option>
              <option>$15,000 – $35,000</option>
              <option>$35,000 – $75,000</option>
              <option>$75,000+</option>
              <option>Let's discuss</option>
            </select>
          </div>

          <div style="position:relative">
            <label style="position:absolute;top:-.5rem;left:.875rem;background:#fff;padding:0 .375rem;font-size:.6875rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#b0b0b0;z-index:1">Your message</label>
            <textarea placeholder="Tell me about your project, challenge, or idea…" rows="5" style="width:100%;padding:.875rem 1rem;border:1px solid #e7e7e7;background:#fff;font-size:.9375rem;color:#1a1a1a;font-family:'Inter',sans-serif;outline:none;transition:border-color .2s ease;box-sizing:border-box;resize:vertical;min-height:130px" onfocus="this.style.borderColor='#1a1a1a';this.style.boxShadow='0 0 0 1px #1a1a1a'" onblur="this.style.borderColor='#e7e7e7';this.style.boxShadow='none'"></textarea>
          </div>

          <button type="submit" style="width:100%;padding:1rem;background:#1a1a1a;color:#fff;font-size:.9375rem;font-weight:700;border:none;cursor:pointer;transition:background .2s ease;font-family:'Inter',sans-serif;letter-spacing:.02em" onmouseenter="this.style.background='#3d3d3d'" onmouseleave="this.style.background='#1a1a1a'">Send Message →</button>
        </form>
      </div>
    </section>

    <!-- Book a Call -->
    <section style="background:#f6f6f6;border-top:1px solid #e7e7e7;padding:5rem 1.5rem">
      <div style="max-width:1440px;margin-inline:auto;display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:center">
        <div>
          <p style="font-size:.75rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#b0b0b0;margin-bottom:.5rem">Skip the Inbox</p>
          <h2 style="font-size:clamp(1.5rem,3vw,2.25rem);font-weight:900;letter-spacing:-.03em;color:#1a1a1a;margin:0 0 1.25rem">Book a consultation.</h2>
          <p style="font-size:1rem;color:#6d6d6d;line-height:1.6;font-weight:300;margin:0 0 2rem;max-width:440px">Ready to go straight into details? Schedule a 30-minute discovery call directly on my calendar. We'll discuss your goals and see if we're a good fit.</p>
          <a href="#" style="display:inline-flex;align-items:center;gap:.625rem;padding:.875rem 2rem;background:#1a1a1a;color:#fff;font-size:.9375rem;font-weight:700;border-radius:999px;text-decoration:none;transition:transform .2s ease,box-shadow .2s ease" onmouseenter="this.style.transform='translateY(-4px)';this.style.boxShadow='0 8px 20px -4px rgba(0,0,0,.25)'" onmouseleave="this.style.transform='';this.style.boxShadow=''">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            Open Calendar
          </a>
        </div>
        <div style="background:#1a1a1a;padding:2.5rem;position:relative;overflow:hidden">
          <div style="position:absolute;top:0;right:0;width:200px;height:200px;background:rgba(255,255,255,.03);border-radius:50%;transform:translate(50%,-50%)"></div>
          <div style="position:relative;z-index:1">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.25rem">
              <span style="font-size:.75rem;font-weight:600;color:rgba(255,255,255,.5)">Next available slot:</span>
              <span style="font-size:.75rem;font-family:monospace;color:rgba(255,255,255,.7)">Tomorrow, 2:00 PM GMT</span>
            </div>
            <div style="border-top:1px solid rgba(255,255,255,.1);padding-top:1.25rem;margin-bottom:1.25rem">
              <div style="font-size:.875rem;color:rgba(255,255,255,.7);display:flex;align-items:center;gap:.75rem;margin-bottom:.75rem">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.5)" stroke-width="2"><path d="M23 7l-7 5 7 5V7z"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg>
                Video Call — Google Meet
              </div>
              <div style="font-size:.875rem;color:rgba(255,255,255,.7);display:flex;align-items:center;gap:.75rem">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.5)" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                30 minutes
              </div>
            </div>
            <p style="font-size:.875rem;color:rgba(255,255,255,.5);line-height:1.55;font-weight:300;margin:0">Free discovery call. No commitment. Just an honest conversation about whether we're a good fit for each other.</p>
          </div>
        </div>
      </div>
    </section>

  </main>

  <!-- Footer -->
  <footer style="background:#1a1a1a;padding:3rem 1.5rem">
    <div style="max-width:1440px;margin-inline:auto;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:1.5rem">
      <div style="color:rgba(255,255,255,.5);font-size:.875rem">© 2025 Wil B. All rights reserved.</div>
      <div style="display:flex;align-items:center;gap:1.5rem">
        <a href="#" style="color:rgba(255,255,255,.6);font-size:.875rem;font-weight:500;text-decoration:none" onmouseenter="this.style.color='#fff'" onmouseleave="this.style.color='rgba(255,255,255,.6)'">GitHub</a>
        <a href="#" style="color:rgba(255,255,255,.6);font-size:.875rem;font-weight:500;text-decoration:none" onmouseenter="this.style.color='#fff'" onmouseleave="this.style.color='rgba(255,255,255,.6)'">LinkedIn</a>
        <a href="#" style="color:rgba(255,255,255,.6);font-size:.875rem;font-weight:500;text-decoration:none" onmouseenter="this.style.color='#fff'" onmouseleave="this.style.color='rgba(255,255,255,.6)'">Instagram</a>
        <a href="#" style="color:rgba(255,255,255,.6);font-size:.875rem;font-weight:500;text-decoration:none" onmouseenter="this.style.color='#fff'" onmouseleave="this.style.color='rgba(255,255,255,.6)'">Twitter</a>
      </div>
    </div>
  </footer>

  <style>
    @media (max-width:767px) {
      main section[style*="grid-template-columns:1fr 1fr"] { grid-template-columns:1fr !important; }
    }
  </style>
</BaseLayout>
