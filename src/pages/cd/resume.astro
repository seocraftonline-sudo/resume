---
import BaseLayout from '../../layouts/Base.astro';
import CDNav from '../../components/CDNav.astro';
---

<BaseLayout title="Resume — Wil B" theme="cd">
  <link rel="stylesheet" href="/styles/rv.css" slot="head" />
  <CDNav active="resume" />

  <main style="padding-top:5rem;background:#fff;color:#1a1a1a;font-family:'Inter',sans-serif">

    <!-- Page Header -->
    <section style="border-bottom:1px solid #e7e7e7;padding:4rem 1.5rem 3rem">
      <div style="max-width:1440px;margin-inline:auto;display:flex;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;gap:1.5rem">
        <div>
          <p style="font-size:.75rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#b0b0b0;margin-bottom:.75rem">About / Resume</p>
          <h1 style="font-size:clamp(2.5rem,6vw,5rem);font-weight:900;letter-spacing:-.04em;line-height:1.0;margin:0;color:#1a1a1a">Curriculum Vitae.</h1>
        </div>
        <a href="#" style="display:inline-flex;align-items:center;gap:.625rem;padding:.875rem 2rem;background:#1a1a1a;color:#fff;font-size:.875rem;font-weight:700;border-radius:999px;text-decoration:none;transition:transform .2s ease,box-shadow .2s ease" onmouseenter="this.style.transform='translateY(-4px)';this.style.boxShadow='0 8px 20px -4px rgba(0,0,0,.25)'" onmouseleave="this.style.transform='';this.style.boxShadow=''">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Download PDF
        </a>
      </div>
    </section>

    <!-- Two Column Layout -->
    <section style="max-width:1440px;margin-inline:auto;padding:4rem 1.5rem 5rem;display:grid;grid-template-columns:280px 1fr;gap:4rem;align-items:start">

      <!-- Sidebar -->
      <aside>
        <!-- Contact -->
        <div style="margin-bottom:2.5rem">
          <h3 style="font-size:.6875rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#b0b0b0;margin:0 0 1rem;border-bottom:1px solid #e7e7e7;padding-bottom:.5rem">Contact</h3>
          <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:.625rem">
            <li style="display:flex;align-items:start;gap:.625rem">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#b0b0b0" stroke-width="2" style="flex-shrink:0;margin-top:2px"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              <span style="font-size:.875rem;color:#1a1a1a">hello@wilb.com</span>
            </li>
            <li style="display:flex;align-items:start;gap:.625rem">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#b0b0b0" stroke-width="2" style="flex-shrink:0;margin-top:2px"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <span style="font-size:.875rem;color:#1a1a1a">London, UK</span>
            </li>
            <li style="display:flex;align-items:start;gap:.625rem">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#b0b0b0" stroke-width="2" style="flex-shrink:0;margin-top:2px"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
              <span style="font-size:.875rem;color:#1a1a1a">wilb.com</span>
            </li>
          </ul>
        </div>

        <!-- Education -->
        <div style="margin-bottom:2.5rem">
          <h3 style="font-size:.6875rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#b0b0b0;margin:0 0 1rem;border-bottom:1px solid #e7e7e7;padding-bottom:.5rem">Education</h3>
          <div style="margin-bottom:1.25rem">
            <div style="font-size:.875rem;font-weight:800;color:#1a1a1a;letter-spacing:-.01em">BA Design, Royal College of Art</div>
            <div style="font-size:.8125rem;color:#b0b0b0;margin-top:.25rem">2013–2017 · London, UK</div>
          </div>
          <div>
            <div style="font-size:.875rem;font-weight:800;color:#1a1a1a;letter-spacing:-.01em">Foundation Art & Design, UAL</div>
            <div style="font-size:.8125rem;color:#b0b0b0;margin-top:.25rem">2012–2013 · London, UK</div>
          </div>
        </div>

        <!-- Skills -->
        <div style="margin-bottom:2.5rem">
          <h3 style="font-size:.6875rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#b0b0b0;margin:0 0 1rem;border-bottom:1px solid #e7e7e7;padding-bottom:.5rem">Core Skills</h3>
          <div style="display:flex;flex-wrap:wrap;gap:.5rem">
            {['Brand Identity','UX/UI Design','Motion Design','React / Next.js','TypeScript','Figma','Three.js','Art Direction','Creative Strategy'].map(skill => (
              <span style="font-size:.75rem;font-weight:600;color:#1a1a1a;background:#f6f6f6;border:1px solid #e7e7e7;padding:.3rem .75rem">{skill}</span>
            ))}
          </div>
        </div>

        <!-- Languages -->
        <div>
          <h3 style="font-size:.6875rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#b0b0b0;margin:0 0 1rem;border-bottom:1px solid #e7e7e7;padding-bottom:.5rem">Languages</h3>
          <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:.5rem">
            <li style="font-size:.875rem;color:#1a1a1a">English <span style="color:#b0b0b0">(Native)</span></li>
            <li style="font-size:.875rem;color:#1a1a1a">French <span style="color:#b0b0b0">(Conversational)</span></li>
            <li style="font-size:.875rem;color:#1a1a1a">Spanish <span style="color:#b0b0b0">(Basic)</span></li>
          </ul>
        </div>
      </aside>

      <!-- Main Content -->
      <div>
        <!-- Experience -->
        <div style="margin-bottom:3rem">
          <h2 style="font-size:1.125rem;font-weight:900;letter-spacing:-.02em;color:#1a1a1a;margin:0 0 2rem;border-bottom:2px solid #1a1a1a;padding-bottom:.75rem">Experience</h2>

          <div style="display:flex;flex-direction:column;gap:2.5rem">

            <div>
              <div style="display:flex;align-items:start;justify-content:space-between;margin-bottom:.5rem;flex-wrap:wrap;gap:.5rem">
                <div>
                  <h3 style="font-size:1rem;font-weight:800;color:#1a1a1a;letter-spacing:-.02em;margin:0">Independent Creative Director</h3>
                  <p style="font-size:.875rem;color:#b0b0b0;margin:.25rem 0 0">Disrupt Studio · London, UK</p>
                </div>
                <span style="font-size:.75rem;font-family:monospace;color:#b0b0b0;white-space:nowrap">2021 — Present</span>
              </div>
              <ul style="margin:.875rem 0 0;padding-left:1.25rem;display:flex;flex-direction:column;gap:.5rem">
                <li style="font-size:.9375rem;color:#6d6d6d;line-height:1.6;font-weight:300">Founded boutique creative studio; grew to 6-person team within 24 months</li>
                <li style="font-size:.9375rem;color:#6d6d6d;line-height:1.6;font-weight:300">Delivered brand transformation projects for 30+ clients across fintech, SaaS, and consumer tech</li>
                <li style="font-size:.9375rem;color:#6d6d6d;line-height:1.6;font-weight:300">Won 3 Awwwards Site of the Day awards for immersive web projects</li>
              </ul>
            </div>

            <div>
              <div style="display:flex;align-items:start;justify-content:space-between;margin-bottom:.5rem;flex-wrap:wrap;gap:.5rem">
                <div>
                  <h3 style="font-size:1rem;font-weight:800;color:#1a1a1a;letter-spacing:-.02em;margin:0">VP Creative</h3>
                  <p style="font-size:.875rem;color:#b0b0b0;margin:.25rem 0 0">Nexus Technologies · London, UK</p>
                </div>
                <span style="font-size:.75rem;font-family:monospace;color:#b0b0b0;white-space:nowrap">2023 — 2024</span>
              </div>
              <ul style="margin:.875rem 0 0;padding-left:1.25rem;display:flex;flex-direction:column;gap:.5rem">
                <li style="font-size:.9375rem;color:#6d6d6d;line-height:1.6;font-weight:300">Led global rebrand and design system overhaul for a $200M ARR platform</li>
                <li style="font-size:.9375rem;color:#6d6d6d;line-height:1.6;font-weight:300">Managed cross-functional team of 14 across design, content, and engineering</li>
                <li style="font-size:.9375rem;color:#6d6d6d;line-height:1.6;font-weight:300">Increased brand awareness NPS score by 40% within 6 months of rebrand launch</li>
              </ul>
            </div>

            <div>
              <div style="display:flex;align-items:start;justify-content:space-between;margin-bottom:.5rem;flex-wrap:wrap;gap:.5rem">
                <div>
                  <h3 style="font-size:1rem;font-weight:800;color:#1a1a1a;letter-spacing:-.02em;margin:0">Creative Director</h3>
                  <p style="font-size:.875rem;color:#b0b0b0;margin:.25rem 0 0">Vertex Agency · London, UK</p>
                </div>
                <span style="font-size:.75rem;font-family:monospace;color:#b0b0b0;white-space:nowrap">2019 — 2021</span>
              </div>
              <ul style="margin:.875rem 0 0;padding-left:1.25rem;display:flex;flex-direction:column;gap:.5rem">
                <li style="font-size:.9375rem;color:#6d6d6d;line-height:1.6;font-weight:300">Oversaw all creative output for a 20-person digital agency</li>
                <li style="font-size:.9375rem;color:#6d6d6d;line-height:1.6;font-weight:300">Led design and strategy for brands including a FTSE 250 company and three Series B startups</li>
                <li style="font-size:.9375rem;color:#6d6d6d;line-height:1.6;font-weight:300">Built and mentored a team of six junior and mid-level designers</li>
              </ul>
            </div>

            <div>
              <div style="display:flex;align-items:start;justify-content:space-between;margin-bottom:.5rem;flex-wrap:wrap;gap:.5rem">
                <div>
                  <h3 style="font-size:1rem;font-weight:800;color:#1a1a1a;letter-spacing:-.02em;margin:0">Lead Designer</h3>
                  <p style="font-size:.875rem;color:#b0b0b0;margin:.25rem 0 0">Studio One · London, UK</p>
                </div>
                <span style="font-size:.75rem;font-family:monospace;color:#b0b0b0;white-space:nowrap">2017 — 2019</span>
              </div>
              <ul style="margin:.875rem 0 0;padding-left:1.25rem;display:flex;flex-direction:column;gap:.5rem">
                <li style="font-size:.9375rem;color:#6d6d6d;line-height:1.6;font-weight:300">Joined as junior designer, promoted twice within 18 months</li>
                <li style="font-size:.9375rem;color:#6d6d6d;line-height:1.6;font-weight:300">Led visual identity projects for 12+ B2B software clients</li>
              </ul>
            </div>

          </div>
        </div>

        <!-- Recognition -->
        <div>
          <h2 style="font-size:1.125rem;font-weight:900;letter-spacing:-.02em;color:#1a1a1a;margin:0 0 2rem;border-bottom:2px solid #1a1a1a;padding-bottom:.75rem">Recognition & Awards</h2>
          <div style="display:flex;flex-direction:column;gap:1rem">
            <div style="display:flex;align-items:center;justify-content:space-between;padding:.875rem 0;border-bottom:1px solid #f6f6f6;flex-wrap:wrap;gap:.5rem">
              <div>
                <div style="font-size:.9375rem;font-weight:700;color:#1a1a1a">Awwwards Site of the Day (×3)</div>
                <div style="font-size:.8125rem;color:#b0b0b0">Immersive web experience design</div>
              </div>
              <span style="font-size:.75rem;font-family:monospace;color:#b0b0b0">2022–2024</span>
            </div>
            <div style="display:flex;align-items:center;justify-content:space-between;padding:.875rem 0;border-bottom:1px solid #f6f6f6;flex-wrap:wrap;gap:.5rem">
              <div>
                <div style="font-size:.9375rem;font-weight:700;color:#1a1a1a">FWA Site of the Month</div>
                <div style="font-size:.8125rem;color:#b0b0b0">Meridian Fintech brand platform</div>
              </div>
              <span style="font-size:.75rem;font-family:monospace;color:#b0b0b0">2024</span>
            </div>
            <div style="display:flex;align-items:center;justify-content:space-between;padding:.875rem 0;border-bottom:1px solid #f6f6f6;flex-wrap:wrap;gap:.5rem">
              <div>
                <div style="font-size:.9375rem;font-weight:700;color:#1a1a1a">D&AD Pencil — Branding</div>
                <div style="font-size:.8125rem;color:#b0b0b0">Rogo brand identity system</div>
              </div>
              <span style="font-size:.75rem;font-family:monospace;color:#b0b0b0">2024</span>
            </div>
            <div style="display:flex;align-items:center;justify-content:space-between;padding:.875rem 0;flex-wrap:wrap;gap:.5rem">
              <div>
                <div style="font-size:.9375rem;font-weight:700;color:#1a1a1a">Featured in Design Milk &amp; It's Nice That</div>
                <div style="font-size:.8125rem;color:#b0b0b0">Work profiled for innovation and impact</div>
              </div>
              <span style="font-size:.75rem;font-family:monospace;color:#b0b0b0">2023</span>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>

  <!-- Footer -->
  <footer style="background:#1a1a1a;padding:3rem 1.5rem">
    <div style="max-width:1440px;margin-inline:auto;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:1.5rem">
      <div style="color:rgba(255,255,255,.5);font-size:.875rem">© 2025 Wil B. All rights reserved.</div>
      <div style="display:flex;align-items:center;gap:1.5rem">
        <a href="#" style="color:rgba(255,255,255,.6);font-size:.875rem;font-weight:500;text-decoration:none" onmouseenter="this.style.color='#fff'" onmouseleave="this.style.color='rgba(255,255,255,.6)'">GitHub</a>
        <a href="#" style="color:rgba(255,255,255,.6);font-size:.875rem;font-weight:500;text-decoration:none" onmouseenter="this.style.color='#fff'" onmouseleave="this.style.color='rgba(255,255,255,.6)'">LinkedIn</a>
        <a href="#" style="color:rgba(255,255,255,.6);font-size:.875rem;font-weight:500;text-decoration:none" onmouseenter="this.style.color='#fff'" onmouseleave="this.style.color='rgba(255,255,255,.6)'">Instagram</a>
        <a href="#" style="color:rgba(255,255,255,.6);font-size:.875rem;font-weight:500;text-decoration:none" onmouseenter="this.style.color='#fff'" onmouseleave="this.style.color='rgba(255,255,255,.6)'">Twitter</a>
      </div>
    </div>
  </footer>

  <style>
    @media (max-width:767px) {
      main section[style*="grid-template-columns:280px 1fr"] { grid-template-columns:1fr !important; }
    }
  </style>
</BaseLayout>
