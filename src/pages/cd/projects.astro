---
import BaseLayout from '../../layouts/Base.astro';
import CDNav from '../../components/CDNav.astro';
---

<BaseLayout title="Projects — Wil B" theme="cd">
  <link rel="stylesheet" href="/styles/rv.css" slot="head" />
  <CDNav active="projects" />

  <main style="padding-top:5rem;background:#fff;color:#1a1a1a;font-family:'Inter',sans-serif">

    <!-- Page Header -->
    <section style="border-bottom:1px solid #e7e7e7;padding:4rem 1.5rem 3rem">
      <div style="max-width:1440px;margin-inline:auto">
        <p style="font-size:.75rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#b0b0b0;margin-bottom:.75rem">Work / Projects</p>
        <h1 style="font-size:clamp(2.5rem,6vw,5rem);font-weight:900;letter-spacing:-.04em;line-height:1.0;margin:0;color:#1a1a1a">Case Studies.</h1>
      </div>
    </section>

    <!-- Featured Case Study -->
    <section style="max-width:1440px;margin-inline:auto;padding:4rem 1.5rem">
      <div style="position:relative;overflow:hidden;background:#1a1a1a;margin-bottom:1rem">
        <div style="aspect-ratio:16/7;overflow:hidden">
          <img src="https://images.pexels.com/photos/1779487/pexels-photo-1779487.jpeg?auto=compress&cs=tinysrgb&w=1200" alt="Coder Platform Redesign" style="width:100%;height:100%;object-fit:cover;opacity:.5;transition:opacity .3s ease" />
        </div>
        <div style="position:absolute;inset:0;display:flex;flex-direction:column;justify-content:flex-end;padding:3rem">
          <div style="display:flex;gap:.75rem;margin-bottom:1.25rem">
            <span style="font-size:.6875rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.6);border:1px solid rgba(255,255,255,.25);padding:.3rem .75rem">Featured</span>
            <span style="font-size:.6875rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.6);border:1px solid rgba(255,255,255,.25);padding:.3rem .75rem">Digital Product</span>
          </div>
          <h2 style="font-size:clamp(1.75rem,4vw,3rem);font-weight:900;color:#fff;letter-spacing:-.04em;line-height:1.1;margin:0 0 .875rem">Coder — Developer Platform Repositioning</h2>
          <div style="display:flex;gap:2rem;flex-wrap:wrap">
            <div><span style="font-size:.6875rem;color:rgba(255,255,255,.5);text-transform:uppercase;letter-spacing:.08em;font-weight:600;display:block;margin-bottom:.25rem">Role</span><span style="color:#fff;font-size:.875rem">Creative Director</span></div>
            <div><span style="font-size:.6875rem;color:rgba(255,255,255,.5);text-transform:uppercase;letter-spacing:.08em;font-weight:600;display:block;margin-bottom:.25rem">Year</span><span style="color:#fff;font-size:.875rem">2025</span></div>
            <div><span style="font-size:.6875rem;color:rgba(255,255,255,.5);text-transform:uppercase;letter-spacing:.08em;font-weight:600;display:block;margin-bottom:.25rem">Duration</span><span style="color:#fff;font-size:.875rem">12 weeks</span></div>
          </div>
        </div>
      </div>
      <p style="font-size:1.0625rem;color:#6d6d6d;line-height:1.7;font-weight:300;max-width:700px;margin:0">Brand and site repositioning for Coder — elevating a developer-first product to enterprise credibility while preserving its technical soul.</p>
    </section>

    <!-- Project List -->
    <section style="border-top:1px solid #e7e7e7;max-width:1440px;margin-inline:auto;padding:0 1.5rem 5rem">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;margin-top:3rem">

        <div style="display:grid;grid-template-columns:auto 1fr;gap:1.5rem;background:#fff;border:1px solid #e7e7e7;padding:1.5rem;cursor:pointer;transition:transform .3s ease,box-shadow .3s ease;align-items:start" onmouseenter="this.style.transform='translateY(-4px)';this.style.boxShadow='0 10px 25px -5px rgba(0,0,0,.1)'" onmouseleave="this.style.transform='';this.style.boxShadow=''">
          <div style="width:80px;height:80px;overflow:hidden;flex-shrink:0">
            <img src="https://images.pexels.com/photos/196644/pexels-photo-196644.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Meridian" style="width:100%;height:100%;object-fit:cover" />
          </div>
          <div>
            <span style="font-size:.6875rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#b0b0b0">Branding · 2025</span>
            <h3 style="font-size:1.0625rem;font-weight:800;color:#1a1a1a;letter-spacing:-.02em;margin:.375rem 0 .625rem">Meridian Fintech</h3>
            <p style="font-size:.875rem;color:#6d6d6d;line-height:1.55;font-weight:300;margin:0">Full brand identity system — from strategy to logo, typography, and launch campaign assets.</p>
          </div>
        </div>

        <div style="display:grid;grid-template-columns:auto 1fr;gap:1.5rem;background:#fff;border:1px solid #e7e7e7;padding:1.5rem;cursor:pointer;transition:transform .3s ease,box-shadow .3s ease;align-items:start" onmouseenter="this.style.transform='translateY(-4px)';this.style.boxShadow='0 10px 25px -5px rgba(0,0,0,.1)'" onmouseleave="this.style.transform='';this.style.boxShadow=''">
          <div style="width:80px;height:80px;overflow:hidden;flex-shrink:0">
            <img src="https://images.pexels.com/photos/3184416/pexels-photo-3184416.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Rogo" style="width:100%;height:100%;object-fit:cover" />
          </div>
          <div>
            <span style="font-size:.6875rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#b0b0b0">Branding · 2024</span>
            <h3 style="font-size:1.0625rem;font-weight:800;color:#1a1a1a;letter-spacing:-.02em;margin:.375rem 0 .625rem">Rogo — AI for Wall Street</h3>
            <p style="font-size:.875rem;color:#6d6d6d;line-height:1.55;font-weight:300;margin:0">Instant enterprise credibility — visual identity for an AI-powered financial research platform.</p>
          </div>
        </div>

        <div style="display:grid;grid-template-columns:auto 1fr;gap:1.5rem;background:#fff;border:1px solid #e7e7e7;padding:1.5rem;cursor:pointer;transition:transform .3s ease,box-shadow .3s ease;align-items:start" onmouseenter="this.style.transform='translateY(-4px)';this.style.boxShadow='0 10px 25px -5px rgba(0,0,0,.1)'" onmouseleave="this.style.transform='';this.style.boxShadow=''">
          <div style="width:80px;height:80px;overflow:hidden;flex-shrink:0">
            <img src="https://images.pexels.com/photos/265087/pexels-photo-265087.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Tabs Finance" style="width:100%;height:100%;object-fit:cover" />
          </div>
          <div>
            <span style="font-size:.6875rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#b0b0b0">Digital · 2023</span>
            <h3 style="font-size:1.0625rem;font-weight:800;color:#1a1a1a;letter-spacing:-.02em;margin:.375rem 0 .625rem">Tabs Finance App</h3>
            <p style="font-size:.875rem;color:#6d6d6d;line-height:1.55;font-weight:300;margin:0">Product design and front-end development for a personal finance management mobile app.</p>
          </div>
        </div>

        <div style="display:grid;grid-template-columns:auto 1fr;gap:1.5rem;background:#fff;border:1px solid #e7e7e7;padding:1.5rem;cursor:pointer;transition:transform .3s ease,box-shadow .3s ease;align-items:start" onmouseenter="this.style.transform='translateY(-4px)';this.style.boxShadow='0 10px 25px -5px rgba(0,0,0,.1)'" onmouseleave="this.style.transform='';this.style.boxShadow=''">
          <div style="width:80px;height:80px;overflow:hidden;flex-shrink:0">
            <img src="https://images.pexels.com/photos/3153198/pexels-photo-3153198.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Apex" style="width:100%;height:100%;object-fit:cover" />
          </div>
          <div>
            <span style="font-size:.6875rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#b0b0b0">Motion · 2024</span>
            <h3 style="font-size:1.0625rem;font-weight:800;color:#1a1a1a;letter-spacing:-.02em;margin:.375rem 0 .625rem">Apex Motion Reel</h3>
            <p style="font-size:.875rem;color:#6d6d6d;line-height:1.55;font-weight:300;margin:0">Product trailer concept and motion design direction for a SaaS platform launch.</p>
          </div>
        </div>

        <div style="display:grid;grid-template-columns:auto 1fr;gap:1.5rem;background:#fff;border:1px solid #e7e7e7;padding:1.5rem;cursor:pointer;transition:transform .3s ease,box-shadow .3s ease;align-items:start" onmouseenter="this.style.transform='translateY(-4px)';this.style.boxShadow='0 10px 25px -5px rgba(0,0,0,.1)'" onmouseleave="this.style.transform='';this.style.boxShadow=''">
          <div style="width:80px;height:80px;overflow:hidden;flex-shrink:0">
            <img src="https://images.pexels.com/photos/1194420/pexels-photo-1194420.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Vanta" style="width:100%;height:100%;object-fit:cover" />
          </div>
          <div>
            <span style="font-size:.6875rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#b0b0b0">Print · 2024</span>
            <h3 style="font-size:1.0625rem;font-weight:800;color:#1a1a1a;letter-spacing:-.02em;margin:.375rem 0 .625rem">Vanta Annual Report</h3>
            <p style="font-size:.875rem;color:#6d6d6d;line-height:1.55;font-weight:300;margin:0">48-page editorial design and data visualization for a security compliance platform.</p>
          </div>
        </div>

        <div style="display:grid;grid-template-columns:auto 1fr;gap:1.5rem;background:#fff;border:1px solid #e7e7e7;padding:1.5rem;cursor:pointer;transition:transform .3s ease,box-shadow .3s ease;align-items:start" onmouseenter="this.style.transform='translateY(-4px)';this.style.boxShadow='0 10px 25px -5px rgba(0,0,0,.1)'" onmouseleave="this.style.transform='';this.style.boxShadow=''">
          <div style="width:80px;height:80px;overflow:hidden;flex-shrink:0">
            <img src="https://images.pexels.com/photos/7376/startup-photos.jpg?auto=compress&cs=tinysrgb&w=800" alt="Nexus" style="width:100%;height:100%;object-fit:cover" />
          </div>
          <div>
            <span style="font-size:.6875rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#b0b0b0">Digital · 2023</span>
            <h3 style="font-size:1.0625rem;font-weight:800;color:#1a1a1a;letter-spacing:-.02em;margin:.375rem 0 .625rem">Nexus Technologies Rebrand</h3>
            <p style="font-size:.875rem;color:#6d6d6d;line-height:1.55;font-weight:300;margin:0">Full rebrand and design system for a $200M ARR B2B software platform serving enterprise clients.</p>
          </div>
        </div>

      </div>
    </section>

  </main>

  <!-- Footer -->
  <footer style="background:#1a1a1a;padding:3rem 1.5rem">
    <div style="max-width:1440px;margin-inline:auto;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:1.5rem">
      <div style="color:rgba(255,255,255,.5);font-size:.875rem">© 2025 Wil B. All rights reserved.</div>
      <div style="display:flex;align-items:center;gap:1.5rem">
        <a href="#" style="color:rgba(255,255,255,.6);font-size:.875rem;font-weight:500;text-decoration:none" onmouseenter="this.style.color='#fff'" onmouseleave="this.style.color='rgba(255,255,255,.6)'">GitHub</a>
        <a href="#" style="color:rgba(255,255,255,.6);font-size:.875rem;font-weight:500;text-decoration:none" onmouseenter="this.style.color='#fff'" onmouseleave="this.style.color='rgba(255,255,255,.6)'">LinkedIn</a>
        <a href="#" style="color:rgba(255,255,255,.6);font-size:.875rem;font-weight:500;text-decoration:none" onmouseenter="this.style.color='#fff'" onmouseleave="this.style.color='rgba(255,255,255,.6)'">Instagram</a>
        <a href="#" style="color:rgba(255,255,255,.6);font-size:.875rem;font-weight:500;text-decoration:none" onmouseenter="this.style.color='#fff'" onmouseleave="this.style.color='rgba(255,255,255,.6)'">Twitter</a>
      </div>
    </div>
  </footer>

  <style>
    @media (max-width:767px) {
      main section[style*="grid-template-columns:1fr 1fr"] { grid-template-columns: 1fr !important; }
    }
  </style>
</BaseLayout>
