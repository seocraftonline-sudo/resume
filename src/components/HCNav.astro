---
export interface Props {
  active?: string;
}
const { active = '' } = Astro.props;

const isActive = (page: string) => active === page;
const isActiveGroup = (...pages: string[]) => pages.includes(active);
---

<header id="hc-header" style="position:fixed;top:0;width:100%;z-index:50;background:rgba(15,23,42,.9);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-bottom:1px solid rgba(255,255,255,.05);transition:box-shadow .3s ease">
  <div style="max-width:1440px;margin-inline:auto;padding-inline:1.5rem;height:5rem;display:flex;align-items:center;justify-content:space-between">

    <!-- Logo -->
    <a href="/hc/" style="font-family:'Playfair Display',serif;font-size:1.35rem;font-weight:700;letter-spacing:-.01em;color:#F8FAFC;flex-shrink:0;text-decoration:none;display:flex;align-items:center;gap:.35rem">
      Michael <span style="color:#4ADE80;font-size:.85rem;line-height:1">✦</span>
    </a>

    <!-- Desktop Nav -->
    <nav id="hc-desk-nav" style="display:flex;align-items:center;gap:2rem">
      <a href="/hc/" style={`font-size:.875rem;font-weight:500;color:${isActive('home') ? '#F8FAFC' : 'rgba(248,250,252,.6)'};text-decoration:none;padding-bottom:2px;${isActive('home') ? 'border-bottom:2px solid #4ADE80;' : ''}transition:color .2s ease`}>Home</a>

      <!-- Work dropdown -->
      <div class="hc-dd" style="position:relative">
        <button class="hc-dd-btn" style={`display:flex;align-items:center;gap:.3rem;font-size:.875rem;font-weight:500;color:${isActiveGroup('portfolio','projects') ? '#F8FAFC' : 'rgba(248,250,252,.6)'};${isActiveGroup('portfolio','projects') ? 'border-bottom:2px solid #4ADE80;padding-bottom:2px;' : ''}background:none;border:none;cursor:pointer;transition:color .2s ease;font-family:'Inter',sans-serif`}>
          Work
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="hc-dd-arrow" style="transition:transform .2s ease;margin-top:1px"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="hc-dd-menu" style="position:absolute;top:100%;left:50%;transform:translateX(-50%);min-width:180px;padding-top:.75rem;opacity:0;pointer-events:none;transition:opacity .2s cubic-bezier(.4,0,.2,1),transform .2s cubic-bezier(.4,0,.2,1);transform-origin:top center">
          <div style="background:rgba(15,23,42,.95);border:1px solid rgba(255,255,255,.08);border-radius:16px;box-shadow:0 8px 32px -8px rgba(0,0,0,.4);padding:.5rem">
            <a href="/hc/portfolio/" style="display:block;padding:.625rem 1rem;border-radius:10px;font-size:.8125rem;color:rgba(248,250,252,.6);transition:all .15s ease;text-decoration:none" class="hc-dd-item">Portfolio</a>
            <a href="/hc/projects/" style="display:block;padding:.625rem 1rem;border-radius:10px;font-size:.8125rem;color:rgba(248,250,252,.6);transition:all .15s ease;text-decoration:none" class="hc-dd-item">Projects</a>
          </div>
        </div>
      </div>

      <!-- About dropdown -->
      <div class="hc-dd" style="position:relative">
        <button class="hc-dd-btn" style={`display:flex;align-items:center;gap:.3rem;font-size:.875rem;font-weight:500;color:${isActiveGroup('about','resume','skills') ? '#F8FAFC' : 'rgba(248,250,252,.6)'};${isActiveGroup('about','resume','skills') ? 'border-bottom:2px solid #4ADE80;padding-bottom:2px;' : ''}background:none;border:none;cursor:pointer;transition:color .2s ease;font-family:'Inter',sans-serif`}>
          About
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="hc-dd-arrow" style="transition:transform .2s ease;margin-top:1px"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="hc-dd-menu" style="position:absolute;top:100%;left:50%;transform:translateX(-50%);min-width:180px;padding-top:.75rem;opacity:0;pointer-events:none;transition:opacity .2s cubic-bezier(.4,0,.2,1),transform .2s cubic-bezier(.4,0,.2,1);transform-origin:top center">
          <div style="background:rgba(15,23,42,.95);border:1px solid rgba(255,255,255,.08);border-radius:16px;box-shadow:0 8px 32px -8px rgba(0,0,0,.4);padding:.5rem">
            <a href="/hc/about/" style="display:block;padding:.625rem 1rem;border-radius:10px;font-size:.8125rem;color:rgba(248,250,252,.6);transition:all .15s ease;text-decoration:none" class="hc-dd-item">About Me</a>
            <a href="/hc/resume/" style="display:block;padding:.625rem 1rem;border-radius:10px;font-size:.8125rem;color:rgba(248,250,252,.6);transition:all .15s ease;text-decoration:none" class="hc-dd-item">Resume</a>
            <a href="/hc/skills/" style="display:block;padding:.625rem 1rem;border-radius:10px;font-size:.8125rem;color:rgba(248,250,252,.6);transition:all .15s ease;text-decoration:none" class="hc-dd-item">Skills</a>
          </div>
        </div>
      </div>

      <a href="/hc/services/" style={`font-size:.875rem;font-weight:500;color:${isActive('services') ? '#F8FAFC' : 'rgba(248,250,252,.6)'};text-decoration:none;padding-bottom:2px;${isActive('services') ? 'border-bottom:2px solid #4ADE80;' : ''}transition:color .2s ease`}>Services</a>

      <!-- Insights dropdown -->
      <div class="hc-dd" style="position:relative">
        <button class="hc-dd-btn" style={`display:flex;align-items:center;gap:.3rem;font-size:.875rem;font-weight:500;color:${isActiveGroup('blog','publications','testimonials') ? '#F8FAFC' : 'rgba(248,250,252,.6)'};${isActiveGroup('blog','publications','testimonials') ? 'border-bottom:2px solid #4ADE80;padding-bottom:2px;' : ''}background:none;border:none;cursor:pointer;transition:color .2s ease;font-family:'Inter',sans-serif`}>
          Insights
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="hc-dd-arrow" style="transition:transform .2s ease;margin-top:1px"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="hc-dd-menu" style="position:absolute;top:100%;left:50%;transform:translateX(-50%);min-width:180px;padding-top:.75rem;opacity:0;pointer-events:none;transition:opacity .2s cubic-bezier(.4,0,.2,1),transform .2s cubic-bezier(.4,0,.2,1);transform-origin:top center">
          <div style="background:rgba(15,23,42,.95);border:1px solid rgba(255,255,255,.08);border-radius:16px;box-shadow:0 8px 32px -8px rgba(0,0,0,.4);padding:.5rem">
            <a href="/hc/blog/" style="display:block;padding:.625rem 1rem;border-radius:10px;font-size:.8125rem;color:rgba(248,250,252,.6);transition:all .15s ease;text-decoration:none" class="hc-dd-item">Blog</a>
            <a href="/hc/publications/" style="display:block;padding:.625rem 1rem;border-radius:10px;font-size:.8125rem;color:rgba(248,250,252,.6);transition:all .15s ease;text-decoration:none" class="hc-dd-item">Publications</a>
            <a href="/hc/testimonials/" style="display:block;padding:.625rem 1rem;border-radius:10px;font-size:.8125rem;color:rgba(248,250,252,.6);transition:all .15s ease;text-decoration:none" class="hc-dd-item">Testimonials</a>
          </div>
        </div>
      </div>

      <a href="/hc/contact/" style={`font-size:.875rem;font-weight:500;color:${isActive('contact') ? '#F8FAFC' : 'rgba(248,250,252,.6)'};text-decoration:none;padding-bottom:2px;${isActive('contact') ? 'border-bottom:2px solid #4ADE80;' : ''}transition:color .2s ease`}>Contact</a>
    </nav>

    <!-- Right actions -->
    <div style="display:flex;align-items:center;gap:1rem">
      <a href="/hc/contact/" id="hc-connect-btn" style="background:#4ADE80;color:#0F172A;font-size:.8125rem;font-weight:600;padding:.5rem 1.25rem;border-radius:9999px;text-decoration:none;transition:opacity .2s ease;white-space:nowrap">Connect</a>
      <!-- Mobile hamburger -->
      <button id="hc-mob-toggle" aria-label="Menu" style="display:none;padding:.5rem;background:none;border:none;color:#F8FAFC;cursor:pointer">
        <svg id="hc-menu-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        <svg id="hc-close-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="hc-mob-menu" style="display:none;flex-direction:column;padding:1rem 1.5rem 1.5rem;border-top:1px solid rgba(255,255,255,.05);background:rgba(15,23,42,.97);backdrop-filter:blur(16px)">
    <a href="/hc/" style="padding:.75rem 0;font-size:.9375rem;color:#F8FAFC;border-bottom:1px solid rgba(255,255,255,.05);text-decoration:none;display:block">Home</a>
    <div style="padding:.75rem 0;border-bottom:1px solid rgba(255,255,255,.05)">
      <span style="font-size:.75rem;text-transform:uppercase;letter-spacing:.1em;color:#94A3B8;display:block;margin-bottom:.5rem">Work</span>
      <div style="display:flex;gap:1.5rem;padding-left:.5rem">
        <a href="/hc/portfolio/" style="font-size:.875rem;color:rgba(248,250,252,.7);text-decoration:none">Portfolio</a>
        <a href="/hc/projects/" style="font-size:.875rem;color:rgba(248,250,252,.7);text-decoration:none">Projects</a>
      </div>
    </div>
    <div style="padding:.75rem 0;border-bottom:1px solid rgba(255,255,255,.05)">
      <span style="font-size:.75rem;text-transform:uppercase;letter-spacing:.1em;color:#94A3B8;display:block;margin-bottom:.5rem">About</span>
      <div style="display:flex;gap:1.5rem;padding-left:.5rem">
        <a href="/hc/about/" style="font-size:.875rem;color:rgba(248,250,252,.7);text-decoration:none">About Me</a>
        <a href="/hc/resume/" style="font-size:.875rem;color:rgba(248,250,252,.7);text-decoration:none">Resume</a>
        <a href="/hc/skills/" style="font-size:.875rem;color:rgba(248,250,252,.7);text-decoration:none">Skills</a>
      </div>
    </div>
    <a href="/hc/services/" style="padding:.75rem 0;font-size:.9375rem;color:#F8FAFC;border-bottom:1px solid rgba(255,255,255,.05);text-decoration:none;display:block">Services</a>
    <div style="padding:.75rem 0;border-bottom:1px solid rgba(255,255,255,.05)">
      <span style="font-size:.75rem;text-transform:uppercase;letter-spacing:.1em;color:#94A3B8;display:block;margin-bottom:.5rem">Insights</span>
      <div style="display:flex;gap:1.5rem;padding-left:.5rem">
        <a href="/hc/blog/" style="font-size:.875rem;color:rgba(248,250,252,.7);text-decoration:none">Blog</a>
        <a href="/hc/publications/" style="font-size:.875rem;color:rgba(248,250,252,.7);text-decoration:none">Publications</a>
        <a href="/hc/testimonials/" style="font-size:.875rem;color:rgba(248,250,252,.7);text-decoration:none">Testimonials</a>
      </div>
    </div>
    <a href="/hc/contact/" style="padding:.75rem 0;font-size:.9375rem;color:#F8FAFC;text-decoration:none;display:block">Contact</a>
    <a href="/hc/contact/" style="margin-top:1rem;display:block;text-align:center;background:#4ADE80;color:#0F172A;font-weight:600;padding:.75rem 1.5rem;border-radius:9999px;text-decoration:none;font-size:.875rem">Connect</a>
  </div>
</header>

<script>
  // Dropdown logic
  document.querySelectorAll('.hc-dd').forEach(dd => {
    const btn = dd.querySelector('.hc-dd-btn') as HTMLElement;
    const menu = dd.querySelector('.hc-dd-menu') as HTMLElement;
    const arrow = dd.querySelector('.hc-dd-arrow') as HTMLElement;
    let open = false;
    const show = () => {
      menu.style.opacity = '1';
      menu.style.pointerEvents = 'auto';
      menu.style.transform = 'translateX(-50%) translateY(0)';
      if (arrow) arrow.style.transform = 'rotate(180deg)';
      open = true;
    };
    const hide = () => {
      menu.style.opacity = '0';
      menu.style.pointerEvents = 'none';
      menu.style.transform = 'translateX(-50%) translateY(-4px)';
      if (arrow) arrow.style.transform = 'rotate(0)';
      open = false;
    };
    dd.addEventListener('mouseenter', show);
    dd.addEventListener('mouseleave', hide);
    if (btn) btn.addEventListener('click', () => open ? hide() : show());
  });

  // Hover on dropdown items
  document.querySelectorAll('.hc-dd-item').forEach(item => {
    const el = item as HTMLElement;
    el.addEventListener('mouseenter', () => { el.style.background = 'rgba(74,222,128,.08)'; el.style.color = '#F8FAFC'; });
    el.addEventListener('mouseleave', () => { el.style.background = ''; el.style.color = 'rgba(248,250,252,.6)'; });
  });

  // Mobile toggle
  const toggle = document.getElementById('hc-mob-toggle') as HTMLElement;
  const mobMenu = document.getElementById('hc-mob-menu') as HTMLElement;
  const menuIcon = document.getElementById('hc-menu-icon') as HTMLElement;
  const closeIcon = document.getElementById('hc-close-icon') as HTMLElement;
  let mobOpen = false;
  if (toggle && mobMenu) {
    toggle.addEventListener('click', () => {
      mobOpen = !mobOpen;
      mobMenu.style.display = mobOpen ? 'flex' : 'none';
      if (menuIcon) menuIcon.style.display = mobOpen ? 'none' : 'block';
      if (closeIcon) closeIcon.style.display = mobOpen ? 'block' : 'none';
    });
  }

  // Responsive
  const checkResize = () => {
    const isMob = window.innerWidth < 768;
    const desk = document.getElementById('hc-desk-nav') as HTMLElement;
    const connectBtn = document.getElementById('hc-connect-btn') as HTMLElement;
    if (desk) desk.style.display = isMob ? 'none' : 'flex';
    if (toggle) toggle.style.display = isMob ? 'flex' : 'none';
    if (connectBtn) connectBtn.style.display = isMob ? 'none' : 'inline-flex';
    if (!isMob && mobMenu) {
      mobMenu.style.display = 'none';
      mobOpen = false;
      if (menuIcon) menuIcon.style.display = 'block';
      if (closeIcon) closeIcon.style.display = 'none';
    }
  };
  checkResize();
  window.addEventListener('resize', checkResize);
</script>
