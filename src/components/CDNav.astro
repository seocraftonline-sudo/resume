---
export interface Props {
  active?: string;
}
const { active = '' } = Astro.props;

const isActive = (page: string) => active === page;
const isActiveGroup = (...pages: string[]) => pages.includes(active);
---

<header id="cd-header" style="position:fixed;top:0;width:100%;z-index:50;background:rgba(255,255,255,.9);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-bottom:1px solid #1a1a1a;transition:box-shadow .3s ease">
  <div style="max-width:1440px;margin-inline:auto;padding-inline:1.5rem;height:5rem;display:flex;align-items:center;justify-content:space-between">

    <!-- Logo -->
    <a href="/cd/" style="display:flex;align-items:center;gap:.5rem;text-decoration:none;flex-shrink:0">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M12 2L2 22H22L12 2Z" fill="#1a1a1a"/>
        <path d="M12 8L6 20H18L12 8Z" fill="white"/>
      </svg>
      <span style="font-family:'Inter',sans-serif;font-weight:700;font-size:1.125rem;letter-spacing:-.03em;color:#1a1a1a">WB.</span>
    </a>

    <!-- Desktop Nav -->
    <nav id="cd-desk-nav" style="display:flex;align-items:center;gap:2rem">

      <!-- Work dropdown -->
      <div class="cd-dd" style="position:relative">
        <button class="cd-dd-btn" style={`display:flex;align-items:center;gap:.3rem;font-size:.875rem;font-weight:500;color:${isActiveGroup('portfolio','projects') ? '#1a1a1a' : '#b0b0b0'};${isActiveGroup('portfolio','projects') ? 'border-bottom:2px solid #1a1a1a;padding-bottom:2px;' : ''}background:none;border:none;cursor:pointer;transition:color .2s ease;font-family:'Inter',sans-serif`}>
          Work
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="cd-dd-arrow" style="transition:transform .2s ease;margin-top:1px"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="cd-dd-menu" style="position:absolute;top:100%;left:50%;transform:translateX(-50%);min-width:180px;padding-top:.75rem;opacity:0;pointer-events:none;transition:opacity .2s cubic-bezier(.4,0,.2,1),transform .2s cubic-bezier(.4,0,.2,1);transform-origin:top center">
          <div style="background:#fff;border:1px solid #1a1a1a;border-radius:4px;box-shadow:4px 4px 0 #1a1a1a;padding:.375rem">
            <a href="/cd/portfolio/" style="display:block;padding:.5rem 1rem;font-size:.8125rem;color:#b0b0b0;transition:all .15s ease" class="cd-dd-item">Portfolio</a>
            <a href="/cd/projects/" style="display:block;padding:.5rem 1rem;font-size:.8125rem;color:#b0b0b0;transition:all .15s ease" class="cd-dd-item">Projects</a>
          </div>
        </div>
      </div>

      <a href="/cd/services/" style={`font-size:.875rem;font-weight:500;color:${isActive('services') ? '#1a1a1a' : '#b0b0b0'};${isActive('services') ? 'border-bottom:2px solid #1a1a1a;padding-bottom:2px;' : ''}transition:color .2s ease;text-decoration:none`}>Services</a>

      <!-- About dropdown -->
      <div class="cd-dd" style="position:relative">
        <button class="cd-dd-btn" style={`display:flex;align-items:center;gap:.3rem;font-size:.875rem;font-weight:500;color:${isActiveGroup('about','resume','skills') ? '#1a1a1a' : '#b0b0b0'};${isActiveGroup('about','resume','skills') ? 'border-bottom:2px solid #1a1a1a;padding-bottom:2px;' : ''}background:none;border:none;cursor:pointer;transition:color .2s ease;font-family:'Inter',sans-serif`}>
          About
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="cd-dd-arrow" style="transition:transform .2s ease;margin-top:1px"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="cd-dd-menu" style="position:absolute;top:100%;left:50%;transform:translateX(-50%);min-width:180px;padding-top:.75rem;opacity:0;pointer-events:none;transition:opacity .2s cubic-bezier(.4,0,.2,1),transform .2s cubic-bezier(.4,0,.2,1);transform-origin:top center">
          <div style="background:#fff;border:1px solid #1a1a1a;border-radius:4px;box-shadow:4px 4px 0 #1a1a1a;padding:.375rem">
            <a href="/cd/about/" style="display:block;padding:.5rem 1rem;font-size:.8125rem;color:#b0b0b0;transition:all .15s ease" class="cd-dd-item">About</a>
            <a href="/cd/resume/" style="display:block;padding:.5rem 1rem;font-size:.8125rem;color:#b0b0b0;transition:all .15s ease" class="cd-dd-item">Resume</a>
            <a href="/cd/skills/" style="display:block;padding:.5rem 1rem;font-size:.8125rem;color:#b0b0b0;transition:all .15s ease" class="cd-dd-item">Skills</a>
          </div>
        </div>
      </div>

      <!-- Insights dropdown -->
      <div class="cd-dd" style="position:relative">
        <button class="cd-dd-btn" style={`display:flex;align-items:center;gap:.3rem;font-size:.875rem;font-weight:500;color:${isActiveGroup('blog','publications','testimonials') ? '#1a1a1a' : '#b0b0b0'};${isActiveGroup('blog','publications','testimonials') ? 'border-bottom:2px solid #1a1a1a;padding-bottom:2px;' : ''}background:none;border:none;cursor:pointer;transition:color .2s ease;font-family:'Inter',sans-serif`}>
          Insights
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="cd-dd-arrow" style="transition:transform .2s ease;margin-top:1px"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="cd-dd-menu" style="position:absolute;top:100%;left:50%;transform:translateX(-50%);min-width:180px;padding-top:.75rem;opacity:0;pointer-events:none;transition:opacity .2s cubic-bezier(.4,0,.2,1),transform .2s cubic-bezier(.4,0,.2,1);transform-origin:top center">
          <div style="background:#fff;border:1px solid #1a1a1a;border-radius:4px;box-shadow:4px 4px 0 #1a1a1a;padding:.375rem">
            <a href="/cd/blog/" style="display:block;padding:.5rem 1rem;font-size:.8125rem;color:#b0b0b0;transition:all .15s ease" class="cd-dd-item">Blog</a>
            <a href="/cd/publications/" style="display:block;padding:.5rem 1rem;font-size:.8125rem;color:#b0b0b0;transition:all .15s ease" class="cd-dd-item">Publications</a>
            <a href="/cd/testimonials/" style="display:block;padding:.5rem 1rem;font-size:.8125rem;color:#b0b0b0;transition:all .15s ease" class="cd-dd-item">Testimonials</a>
          </div>
        </div>
      </div>

      <a href="/cd/contact/" style={`font-size:.875rem;font-weight:500;color:${isActive('contact') ? '#1a1a1a' : '#b0b0b0'};${isActive('contact') ? 'border-bottom:2px solid #1a1a1a;padding-bottom:2px;' : ''}transition:color .2s ease;text-decoration:none`}>Contact</a>
    </nav>

    <!-- Right: CTA + Hamburger -->
    <div style="display:flex;align-items:center;gap:1rem">
      <a href="/cd/contact/" id="cd-cta-btn" style="padding:.5rem 1.25rem;background:#1a1a1a;color:#fff;font-size:.8125rem;font-weight:600;border-radius:999px;text-decoration:none;transition:background .2s ease;white-space:nowrap;letter-spacing:.01em">Let's Talk</a>
      <!-- Mobile hamburger -->
      <button id="cd-mob-toggle" aria-label="Menu" style="display:none;padding:.5rem;background:none;border:none;color:#1a1a1a;cursor:pointer">
        <svg id="cd-menu-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        <svg id="cd-close-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="cd-mob-menu" style="display:none;flex-direction:column;padding:1rem 1.5rem 1.5rem;border-top:1px solid #1a1a1a;background:rgba(255,255,255,.97);backdrop-filter:blur(16px)">
    <a href="/cd/" style="padding:.75rem 0;font-size:.9375rem;font-weight:500;color:#1a1a1a;border-bottom:1px solid #e7e7e7;text-decoration:none">Home</a>
    <div style="padding:.75rem 0;border-bottom:1px solid #e7e7e7">
      <span style="font-size:.6875rem;text-transform:uppercase;letter-spacing:.1em;color:#b0b0b0;display:block;margin-bottom:.5rem;font-weight:600">Work</span>
      <div style="display:flex;gap:1.5rem;padding-left:.5rem">
        <a href="/cd/portfolio/" style="font-size:.875rem;color:#1a1a1a;text-decoration:none">Portfolio</a>
        <a href="/cd/projects/" style="font-size:.875rem;color:#1a1a1a;text-decoration:none">Projects</a>
      </div>
    </div>
    <a href="/cd/services/" style="padding:.75rem 0;font-size:.9375rem;font-weight:500;color:#1a1a1a;border-bottom:1px solid #e7e7e7;text-decoration:none">Services</a>
    <div style="padding:.75rem 0;border-bottom:1px solid #e7e7e7">
      <span style="font-size:.6875rem;text-transform:uppercase;letter-spacing:.1em;color:#b0b0b0;display:block;margin-bottom:.5rem;font-weight:600">About</span>
      <div style="display:flex;gap:1.5rem;padding-left:.5rem">
        <a href="/cd/about/" style="font-size:.875rem;color:#1a1a1a;text-decoration:none">About</a>
        <a href="/cd/resume/" style="font-size:.875rem;color:#1a1a1a;text-decoration:none">Resume</a>
        <a href="/cd/skills/" style="font-size:.875rem;color:#1a1a1a;text-decoration:none">Skills</a>
      </div>
    </div>
    <div style="padding:.75rem 0;border-bottom:1px solid #e7e7e7">
      <span style="font-size:.6875rem;text-transform:uppercase;letter-spacing:.1em;color:#b0b0b0;display:block;margin-bottom:.5rem;font-weight:600">Insights</span>
      <div style="display:flex;gap:1.5rem;padding-left:.5rem">
        <a href="/cd/blog/" style="font-size:.875rem;color:#1a1a1a;text-decoration:none">Blog</a>
        <a href="/cd/publications/" style="font-size:.875rem;color:#1a1a1a;text-decoration:none">Publications</a>
        <a href="/cd/testimonials/" style="font-size:.875rem;color:#1a1a1a;text-decoration:none">Testimonials</a>
      </div>
    </div>
    <a href="/cd/contact/" style="padding:.75rem 0;font-size:.9375rem;font-weight:500;color:#1a1a1a;text-decoration:none">Contact</a>
  </div>
</header>

<script>
  // Dropdown logic
  document.querySelectorAll('.cd-dd').forEach(dd => {
    const btn = dd.querySelector('.cd-dd-btn') as HTMLElement;
    const menu = dd.querySelector('.cd-dd-menu') as HTMLElement;
    const arrow = dd.querySelector('.cd-dd-arrow') as HTMLElement;
    let open = false;
    const show = () => {
      menu.style.opacity = '1';
      menu.style.pointerEvents = 'auto';
      menu.style.transform = 'translateX(-50%) translateY(0)';
      arrow.style.transform = 'rotate(180deg)';
      open = true;
    };
    const hide = () => {
      menu.style.opacity = '0';
      menu.style.pointerEvents = 'none';
      menu.style.transform = 'translateX(-50%) translateY(-4px)';
      arrow.style.transform = 'rotate(0)';
      open = false;
    };
    dd.addEventListener('mouseenter', show);
    dd.addEventListener('mouseleave', hide);
    btn.addEventListener('click', () => open ? hide() : show());
  });

  // Hover on dropdown items
  document.querySelectorAll('.cd-dd-item').forEach(item => {
    const el = item as HTMLElement;
    el.addEventListener('mouseenter', () => { el.style.background = '#f6f6f6'; el.style.color = '#1a1a1a'; });
    el.addEventListener('mouseleave', () => { el.style.background = ''; el.style.color = '#b0b0b0'; });
  });

  // Mobile toggle
  const toggle = document.getElementById('cd-mob-toggle') as HTMLElement;
  const menu = document.getElementById('cd-mob-menu') as HTMLElement;
  const menuIcon = document.getElementById('cd-menu-icon') as HTMLElement;
  const closeIcon = document.getElementById('cd-close-icon') as HTMLElement;
  let mobOpen = false;
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      mobOpen = !mobOpen;
      menu.style.display = mobOpen ? 'flex' : 'none';
      menuIcon.style.display = mobOpen ? 'none' : 'block';
      closeIcon.style.display = mobOpen ? 'block' : 'none';
    });
  }

  // Responsive
  const check = () => {
    const mob = window.innerWidth <= 767;
    const desk = document.getElementById('cd-desk-nav') as HTMLElement;
    const ctaBtn = document.getElementById('cd-cta-btn') as HTMLElement;
    if (desk) desk.style.display = mob ? 'none' : 'flex';
    if (toggle) toggle.style.display = mob ? 'flex' : 'none';
    if (ctaBtn) ctaBtn.style.display = mob ? 'none' : 'inline-flex';
    if (!mob && menu) { menu.style.display = 'none'; mobOpen = false; menuIcon.style.display = 'block'; closeIcon.style.display = 'none'; }
  };
  check();
  window.addEventListener('resize', check);
</script>
